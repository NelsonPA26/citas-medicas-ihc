<%
  const antecedentesClinicos = [
    { etiqueta: 'Alergias', valor: paciente.alergias },
    { etiqueta: 'Enfermedades previas', valor: paciente.enfermedades_previas },
    { etiqueta: 'Medicación actual', valor: paciente.medicacion_actual },
    { etiqueta: 'Cirugías', valor: paciente.cirugias },
    { etiqueta: 'Antecedentes familiares', valor: paciente.antecedentes_familiares },
    { etiqueta: 'Observaciones', valor: paciente.antecedentes_observaciones }
  ].filter(item => item.valor && String(item.valor).trim() !== '');
%>

<div class="module-card detalle-historial-card">
  <div class="module-header">
    <p>Revisa antecedentes y consultas médicas previas del paciente.</p>
  </div>

  <div class="clinical-overview patient-history-overview">
    <section class="patient-summary clinical-panel">
      <h3>Resumen del paciente</h3>
      <div class="clinical-note-list clinical-note-grid patient-summary-compact-grid">
        <div class="clinical-note-item">
          <span>Paciente</span>
          <strong><%= paciente.nombres %> <%= paciente.apellido_paterno %> <%= paciente.apellido_materno || '' %></strong>
        </div>
        <div class="clinical-note-item"><span>DNI</span><strong><%= paciente.dni || 'No registrado' %></strong></div>
        <div class="clinical-note-item"><span>Edad</span><strong><%= paciente.edad !== null ? paciente.edad + ' años' : 'No registrada' %></strong></div>
        <div class="clinical-note-item"><span>Sexo</span><strong><%= paciente.sexo || 'No registrado' %></strong></div>
        <div class="clinical-note-item"><span>Correo</span><strong><%= paciente.correo || 'No registrado' %></strong></div>
        <div class="clinical-note-item"><span>Teléfono</span><strong><%= paciente.telefono || 'No registrado' %></strong></div>
      </div>
    </section>

    <section class="triaje-summary clinical-panel clinical-antecedentes-panel">
      <h3>Antecedentes del paciente</h3>
      <% if (antecedentesClinicos.length > 0) { %>
        <div class="clinical-note-list clinical-note-grid">
          <% antecedentesClinicos.forEach(item => { %>
            <div class="clinical-note-item">
              <span><%= item.etiqueta %></span>
              <strong><%= item.valor %></strong>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="clinical-empty-text">No hay antecedentes médicos registrados.</p>
      <% } %>
    </section>
  </div>

  <section class="consulta-detail-section">
    <h3>Consultas completadas</h3>

    <% if (consultas.length === 0) { %>
      <div class="empty-state empty-state-compact">
        <h3>Sin consultas completadas</h3>
        <p>Este paciente aún no tiene consultas completadas contigo.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Hora</th>
              <th>Motivo</th>
              <th>Diagnóstico</th>
              <th>Tratamiento</th>
              <th>Acción</th>
            </tr>
          </thead>
          <tbody>
            <% consultas.forEach(consulta => { %>
              <tr>
                <td>
                  <%= new Date(consulta.fecha).toLocaleDateString('es-PE') %>
                </td>
                <td><%= consulta.hora %></td>
                <td><strong><%= consulta.motivo %></strong></td>
                <td><%= consulta.diagnostico %></td>
                <td><%= consulta.tratamiento %></td>
                <td>
                  <a href="/medico/pacientes/<%= paciente.id_paciente %>/historial/<%= consulta.id_consulta %>" class="btn-table-primary icon-action" title="Ver detalle" aria-label="Ver detalle">
                    <img class="action-metaphor" src="/img/action-metaphors/medico/historial/buscar.png" alt="" aria-hidden="true">
                    <span class="visually-hidden">Ver detalle</span>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <div class="form-actions">
    <a href="/medico/pacientes" class="btn-light">Volver</a>
  </div>
</div>
