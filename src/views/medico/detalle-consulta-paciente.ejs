<div class="module-card detalle-historial-card">
  <div class="module-header">
    <p>Revisa la informacion completa registrada durante esta consulta.</p>
  </div>

  <div class="clinical-overview patient-history-overview">
    <section class="triaje-summary clinical-panel">
      <h3>Consulta medica</h3>
      <div class="triaje-summary-grid compact-clinical-grid">
        <div><span>Fecha</span><strong><%= new Date(consulta.fecha).toLocaleDateString('es-PE') %></strong></div>
        <div><span>Hora</span><strong><%= consulta.hora %></strong></div>
        <div class="full-row"><span>Motivo</span><strong><%= consulta.motivo %></strong></div>
      </div>
    </section>

    <section class="triaje-summary clinical-panel">
      <h3>Triaje registrado</h3>
      <div class="triaje-summary-grid compact-clinical-grid">
        <div><span>Temperatura</span><strong><%= consulta.temperatura || 'N/R' %> C</strong></div>
        <div><span>Presion arterial</span><strong><%= consulta.presion_arterial || 'N/R' %></strong></div>
        <div><span>Frecuencia cardiaca</span><strong><%= consulta.frecuencia_cardiaca || 'N/R' %> lpm</strong></div>
        <div><span>Saturacion O2</span><strong><%= consulta.saturacion || 'N/R' %>%</strong></div>
        <div class="full-row"><span>Sintomas verificados</span><strong><%= consulta.sintomas || 'No registrados' %></strong></div>
        <% if (consulta.triaje_observaciones) { %>
          <div class="full-row"><span>Observaciones de enfermeria</span><strong><%= consulta.triaje_observaciones %></strong></div>
        <% } %>
      </div>
    </section>
  </div>

  <section class="triaje-summary">
    <h3>Atencion medica</h3>
    <div class="consulta-detail-grid consulta-detail-grid-two">
      <div>
        <span>Diagnostico</span>
        <strong><%= consulta.diagnostico %></strong>
      </div>
      <div>
        <span>Tratamiento</span>
        <strong><%= consulta.tratamiento %></strong>
      </div>
      <div>
        <span>Recomendaciones</span>
        <strong><%= consulta.recomendaciones || 'Sin recomendaciones' %></strong>
      </div>
      <% if (consulta.observaciones) { %>
        <div>
          <span>Observaciones medicas</span>
          <strong><%= consulta.observaciones %></strong>
        </div>
      <% } %>
    </div>
  </section>

  <div class="form-actions">
    <a href="<%= backUrl %>" class="btn-light">Volver</a>
  </div>
</div>
