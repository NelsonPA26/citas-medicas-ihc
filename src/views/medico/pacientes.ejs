<div class="module-card pacientes-card">
  <div class="module-header">
    <p>Consulta pacientes atendidos o relacionados con tus citas médicas.</p>
  </div>

  <form action="/medico/pacientes" method="GET" class="filter-card js-role-validated-form" novalidate>
  <div class="filter-grid two-columns">
    <div class="form-group">
      <label for="q" class="field-label-with-icon">
        <svg class="field-icon" aria-hidden="true"><use href="#field-icon-search"></use></svg>
        <span>Buscar</span>
      </label>
      <input
        type="text"
        id="q"
        name="q"
        value="<%= filters.q || '' %>"
        placeholder="Buscar por nombre, apellido o DNI"
        maxlength="120"
        data-validate="search"
      >
      <span class="field-message" data-for="q"></span>
    </div>
  </div>

  <div class="filter-actions">
    <a href="/medico/pacientes" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
      <img class="action-metaphor" src="/img/action-metaphors/paciente/filtros/limpiar.png" alt="" aria-hidden="true">
      <span>Limpiar</span>
    </a>
    <button type="submit" class="btn-dark icon-action" title="Filtrar" aria-label="Filtrar">
      <img class="action-metaphor" src="/img/action-metaphors/paciente/filtros/filtrar.png" alt="" aria-hidden="true">
      <span>Filtrar</span>
    </button>
  </div>
</form>

  <% if (pacientes.length === 0) { %>
    <div class="empty-state">
      <h3>No se encontraron pacientes</h3>
      <p>No hay resultados con los filtros seleccionados.</p>
      <div class="empty-actions">
        <a href="/medico/pacientes" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
          <img class="action-metaphor" src="/img/action-metaphors/paciente/filtros/limpiar.png" alt="" aria-hidden="true">
          <span>Limpiar</span>
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Paciente</th>
            <th>DNI</th>
            <th>Edad</th>
            <th>Sexo</th>
            <th>Consultas completadas</th>
            <th>Última atención</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          <% pacientes.forEach(paciente => { %>
            <tr>
              <td><strong><%= paciente.nombres %> <%= paciente.apellido_paterno %> <%= paciente.apellido_materno || '' %></strong></td>
              <td><%= paciente.dni || 'No registrado' %></td>
              <td><%= paciente.edad !== null ? paciente.edad + ' años' : 'No registrada' %></td>
              <td><%= paciente.sexo || 'No registrado' %></td>
              <td><span class="status-badge status-completada"><%= paciente.consultas_completadas || 0 %></span></td>
              <td><%= paciente.ultima_atencion ? new Date(paciente.ultima_atencion).toLocaleDateString('es-PE') : 'Sin atención completada' %></td>
              <td>
                <a href="/medico/pacientes/<%= paciente.id_paciente %>/historial" class="btn-table-primary icon-action" title="Ver historial" aria-label="Ver historial">
                  <img class="action-metaphor" src="/img/action-metaphors/medico/historial/buscar.png" alt="" aria-hidden="true">
                  <span class="visually-hidden">Ver historial</span>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script src="/js/role-validations.js"></script>
