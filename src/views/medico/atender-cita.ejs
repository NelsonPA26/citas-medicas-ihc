<div class="module-card consulta-card">
  <div class="module-header">
    <p>Revisa el triaje y registra la consulta del paciente.</p>
  </div>

  <div class="notice-box">
    Los selectores de diagnóstico y tratamiento/receta son plantillas frecuentes editables. No reemplazan la evaluación médica ni generan una decisión automática.
  </div>

  <div class="clinical-workspace clinical-workspace-consulta">
    <aside class="clinical-workspace-side" aria-label="Contexto cl&iacute;nico del paciente">
      <div class="clinical-overview">
    <section class="patient-summary clinical-panel">
      <h3><i class="bi bi-person-vcard" aria-hidden="true"></i>Resumen del paciente</h3>
      <div><span>Paciente</span><strong><%= cita.paciente_nombres %> <%= cita.paciente_apellido_paterno %> <%= cita.paciente_apellido_materno || '' %></strong></div>
      <div><span>DNI</span><strong><%= cita.paciente_dni || 'No registrado' %></strong></div>
      <div><span>Edad</span><strong><%= cita.paciente_edad !== null ? cita.paciente_edad + ' años' : 'No registrada' %></strong></div>
      <div><span>Sexo</span><strong><%= cita.paciente_sexo || 'No registrado' %></strong></div>
      <div><span>Fecha y hora</span><strong><%= new Date(cita.fecha).toLocaleDateString('es-PE') %> - <%= cita.hora %></strong></div>
      <div class="full-row"><span>Motivo de consulta</span><strong><%= cita.motivo %></strong></div>
    </section>

    <section class="triaje-summary clinical-panel clinical-antecedentes-panel">
      <h3><i class="bi bi-journal-medical" aria-hidden="true"></i>Antecedentes médicos referidos por el paciente</h3>
      <div class="triaje-summary-grid compact-clinical-grid">
        <div><span>Alergias</span><strong><%= cita.alergias || 'No registradas' %></strong></div>
        <div><span>Enfermedades previas</span><strong><%= cita.enfermedades_previas || 'No registradas' %></strong></div>
        <div><span>Medicación actual</span><strong><%= cita.medicacion_actual || 'No registrada' %></strong></div>
        <div><span>Cirugías</span><strong><%= cita.cirugias || 'No registradas' %></strong></div>
        <div class="full-row"><span>Antecedentes familiares</span><strong><%= cita.antecedentes_familiares || 'No registrados' %></strong></div>
        <div class="full-row"><span>Observaciones</span><strong><%= cita.antecedentes_observaciones || 'Sin observaciones' %></strong></div>
      </div>
    </section>
      </div>

  <section class="triaje-summary">
    <h3><i class="bi bi-activity" aria-hidden="true"></i>Triaje registrado</h3>
    <div class="triaje-summary-grid">
      <div><span>Temperatura</span><strong><%= cita.temperatura %> °C</strong></div>
      <div><span>Presión arterial</span><strong><%= cita.presion_arterial %></strong></div>
      <div><span>Frecuencia cardiaca</span><strong><%= cita.frecuencia_cardiaca %> lpm</strong></div>
      <div><span>Saturación O₂</span><strong><%= cita.saturacion %>%</strong></div>
      <div class="full-row"><span>Síntomas verificados por enfermería (principal para atención)</span><strong><%= cita.sintomas %></strong></div>
      <div class="full-row"><span>Observaciones de enfermería</span><strong><%= cita.triaje_observaciones || 'Sin observaciones' %></strong></div>
    </div>
  </section>
    </aside>

    <div class="clinical-workspace-main">

  <form action="/medico/citas/<%= cita.id_cita %>/atender" method="POST" class="consulta-form js-role-validated-form" id="consultaForm" novalidate>
    <input type="hidden" name="accion" id="accionInput" value="">
    <div id="consultaMessage" class="step-message hidden"></div>

    <div class="consulta-form-grid">
      <section class="clinical-form-section">
        <div class="clinical-form-section-heading">
          <i class="bi bi-stethoscope" aria-hidden="true"></i>
          <div>
            <h3>Diagn&oacute;stico m&eacute;dico</h3>
            <p>Registra la impresi&oacute;n diagn&oacute;stica seg&uacute;n la evaluaci&oacute;n cl&iacute;nica.</p>
          </div>
        </div>

      <div class="form-group">
        <label for="diagnostico_frecuente" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-stethoscope"></use></svg>
          <span>Diagnóstico frecuente</span>
        </label>
        <select id="diagnostico_frecuente" class="clinical-helper-select" data-target="diagnostico">
          <option value="">Seleccionar diagnóstico frecuente</option>
          <option value="Cefalea tensional">Cefalea tensional</option>
          <option value="Ansiedad en evaluación">Ansiedad en evaluación</option>
          <option value="Estrés académico">Estrés académico</option>
          <option value="Infección respiratoria alta">Infección respiratoria alta</option>
          <option value="Faringitis aguda">Faringitis aguda</option>
          <option value="Rinitis alérgica">Rinitis alérgica</option>
          <option value="Gastritis / dispepsia">Gastritis / dispepsia</option>
          <option value="Dolor abdominal en evaluación">Dolor abdominal en evaluación</option>
          <option value="Gastroenteritis aguda">Gastroenteritis aguda</option>
          <option value="Lumbalgia mecánica">Lumbalgia mecánica</option>
          <option value="Malestar general en evaluación">Malestar general en evaluación</option>
          <option value="Fiebre en evaluación">Fiebre en evaluación</option>
          <option value="Hipertensión arterial en evaluación">Hipertensión arterial en evaluación</option>
          <option value="Dermatitis en evaluación">Dermatitis en evaluación</option>
          <option value="Infección urinaria probable">Infección urinaria probable</option>
          <option value="__otro__">Otro / Especificar manualmente</option>
        </select>

        <label for="diagnostico" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-note"></use></svg>
          <span class="required-indicator">Diagnóstico / impresión diagnóstica registrada por el médico</span>
        </label>
        <textarea id="diagnostico" name="diagnostico" placeholder="Registra el diagnóstico o impresión diagnóstica según la evaluación médica." minlength="5" maxlength="255" data-validate="clinical-text" data-min="5"><%= cita.diagnostico || '' %></textarea>
        <span class="field-message" data-for="diagnostico"></span>
      </div>
      </section>

      <section class="clinical-form-section">
        <div class="clinical-form-section-heading">
          <i class="bi bi-capsule" aria-hidden="true"></i>
          <div>
            <h3>Tratamiento y receta</h3>
            <p>Indica medicaci&oacute;n, dosis, frecuencia o manejo cl&iacute;nico cuando corresponda.</p>
          </div>
        </div>

      <div class="form-group">
        <label for="tratamiento_frecuente" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-pill"></use></svg>
          <span>Tratamiento / receta frecuente</span>
        </label>
        <select id="tratamiento_frecuente" class="clinical-helper-select" data-target="tratamiento">
          <option value="">Seleccionar tratamiento o receta frecuente</option>
          <option value="Tratamiento sintomático según evaluación médica.">Tratamiento sintomático</option>
          <option value="Reposo relativo, hidratación oral y control de evolución.">Reposo e hidratación</option>
          <option value="Control de signos de alarma y reevaluación si presenta empeoramiento.">Control de signos de alarma</option>
          <option value="Medicación según evaluación médica, antecedentes y alergias referidas.">Medicación según evaluación médica</option>
          <option value="Lavado nasal, hidratación y seguimiento si empeoran los síntomas respiratorios.">Manejo respiratorio inicial</option>
          <option value="Dieta blanda, hidratación y reevaluación si persiste dolor abdominal.">Manejo digestivo inicial</option>
          <option value="Control de presión arterial y seguimiento médico.">Control de presión arterial</option>
          <option value="Solicitud de exámenes auxiliares según criterio médico.">Solicitud de exámenes auxiliares</option>
          <option value="Derivación a especialidad correspondiente según evaluación.">Derivación a especialista</option>
          <option value="__otro__">Otro / Especificar manualmente</option>
        </select>

        <label for="tratamiento" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-pill"></use></svg>
          <span class="required-indicator">Tratamiento, receta e indicaciones del médico</span>
        </label>
        <textarea id="tratamiento" name="tratamiento" placeholder="Registra medicación, dosis, frecuencia, duración e indicaciones clínicas cuando corresponda." minlength="5" maxlength="800" data-validate="clinical-text" data-min="5"><%= cita.tratamiento || '' %></textarea>
        <span class="field-message" data-for="tratamiento"></span>
      </div>
      </section>

      <section class="clinical-form-section">
        <div class="clinical-form-section-heading">
          <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
          <div>
            <h3>Indicaciones al paciente</h3>
            <p>Resume cuidados, signos de alarma, controles o recomendaciones preventivas.</p>
          </div>
        </div>

      <div class="form-group">
        <label for="recomendaciones" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-note"></use></svg>
          <span>Indicaciones y recomendaciones para el paciente</span>
        </label>
        <textarea id="recomendaciones" name="recomendaciones" placeholder="Opcional: cuidados en casa, signos de alarma, controles o recomendaciones preventivas." maxlength="800" data-validate="clinical-text" data-min="5"><%= cita.recomendaciones || '' %></textarea>
        <span class="field-message" data-for="recomendaciones"></span>
      </div>
      </section>

      <section class="clinical-form-section">
        <div class="clinical-form-section-heading">
          <i class="bi bi-shield-lock" aria-hidden="true"></i>
          <div>
            <h3>Notas internas</h3>
            <p>Agrega observaciones de uso cl&iacute;nico interno si son necesarias.</p>
          </div>
        </div>

      <div class="form-group">
        <label for="observaciones" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-lock"></use></svg>
          <span>Observaciones internas</span>
        </label>
        <textarea id="observaciones" name="observaciones" placeholder="Opcional: observaciones adicionales para uso interno." maxlength="800" data-validate="clinical-text" data-min="5"><%= cita.consulta_observaciones || '' %></textarea>
        <span class="field-message" data-for="observaciones"></span>

        <label class="checkbox-line">
          <input type="checkbox" name="privada" value="1" <%= cita.privada === 1 ? 'checked' : '' %>>
          <span>Ocultar estas observaciones al paciente</span>
        </label>
      </div>
      </section>
    </div>

    <div class="notice-box">
      Puedes guardar la consulta en progreso sin completar todos los campos. Para confirmar, el diagnóstico y el tratamiento/receta son obligatorios.
    </div>

    <div class="form-actions">
      <a href="/medico/citas" class="btn-light" title="Cancelar" aria-label="Cancelar">
        <img class="action-metaphor" src="/img/action-metaphors/medico/consultas/cancelar.png" alt="" aria-hidden="true">
        <span>Cancelar</span>
      </a>
      <button type="button" class="btn-secondary-action icon-action" id="saveDraftButton" title="Guardar borrador clínico" aria-label="Guardar borrador clínico">
        <img class="action-metaphor" src="/img/action-metaphors/medico/consultas/guardar.png" alt="" aria-hidden="true">
        <span>Guardar borrador</span>
      </button>
      <button type="button" class="btn-dark icon-action" id="openConfirmModal" title="Confirmar consulta" aria-label="Confirmar consulta">
        <img class="action-metaphor" src="/img/action-metaphors/medico/consultas/confirmar.png" alt="" aria-hidden="true">
        <span>Confirmar consulta</span>
      </button>
    </div>
  </form>
    </div>
  </div>

  <div class="modal-overlay hidden" id="confirmConsultaModal">
    <div class="confirm-modal confirm-modal-polished" data-confirm-action="confirmar">
      <button type="button" class="modal-close confirm-modal-close" id="closeConfirmModalTop" aria-label="Cerrar confirmación">&times;</button>
      <div class="confirm-modal-icon" aria-hidden="true">
        <i class="bi bi-clipboard2-check"></i>
      </div>
      <h3>Confirmar consulta</h3>
      <p>Antes de completar la atención, verifica que el diagnóstico y el tratamiento/receta correspondan a la evaluación médica realizada.</p>

      <small class="confirm-modal-note">La consulta quedará finalizada y visible en el historial clínico.</small>

      <label class="checkbox-line">
        <input type="checkbox" id="medicalResponsibilityCheck">
        <span>Confirmo que revisé antecedentes, triaje y que el registro final corresponde a mi criterio médico.</span>
      </label>
      <small class="field-message" data-for="medicalResponsibilityCheck"></small>

      <div class="modal-actions">
        <button type="button" class="btn-light" id="closeConfirmModal" title="Cancelar" aria-label="Cancelar">
          <i class="bi bi-arrow-left" aria-hidden="true"></i>
          <span>Cancelar</span>
        </button>
        <button type="button" class="btn-dark icon-action" id="confirmConsultaButton" disabled title="Sí, confirmar" aria-label="Sí, confirmar">
          <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
          <span>Sí, confirmar</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="/js/role-validations.js"></script>

<script>
  const consultaForm = document.getElementById('consultaForm');
  const consultaMessage = document.getElementById('consultaMessage');

  const diagnosticoInput = document.getElementById('diagnostico');
  const tratamientoInput = document.getElementById('tratamiento');
  const recomendacionesInput = document.getElementById('recomendaciones');
  const observacionesInput = document.getElementById('observaciones');

  const helperSelects = document.querySelectorAll('.clinical-helper-select');

  const accionInput = document.getElementById('accionInput');
  const saveDraftButton = document.getElementById('saveDraftButton');
  const openConfirmModal = document.getElementById('openConfirmModal');

  const confirmConsultaModal = document.getElementById('confirmConsultaModal');
  const closeConfirmModal = document.getElementById('closeConfirmModal');
  const closeConfirmModalTop = document.getElementById('closeConfirmModalTop');
  const confirmConsultaButton = document.getElementById('confirmConsultaButton');
  const medicalResponsibilityCheck = document.getElementById('medicalResponsibilityCheck');

  function showConsultaMessage(message, field = null) {
    consultaMessage.textContent = '';
    consultaMessage.classList.add('hidden');

    document.querySelectorAll('.field-error').forEach(input => {
      input.classList.remove('field-error');
    });

    if (field) {
      field.classList.add('field-error');
      field.setAttribute('aria-invalid', 'true');
      const target = consultaForm.querySelector(`.field-message[data-for="${field.id}"]`)
        || confirmConsultaModal.querySelector(`.field-message[data-for="${field.id}"]`);
      if (target) {
        target.textContent = message;
        target.classList.add('is-visible');
      }
      field.focus();
    } else {
      consultaMessage.textContent = message;
      consultaMessage.classList.remove('hidden');
    }
  }

  function clearConsultaMessage() {
    consultaMessage.textContent = '';
    consultaMessage.classList.add('hidden');
  }

  function validateFilledClinicalFields() {
    const fields = [
      diagnosticoInput,
      tratamientoInput,
      recomendacionesInput,
      observacionesInput
    ];

    for (const field of fields) {
      if (field.value.trim() && !window.RoleValidation.validateField(field)) {
        return false;
      }
    }

    return true;
  }

  function validateRequiredForConfirmation() {
    if (!diagnosticoInput.value.trim()) {
      showConsultaMessage('Para confirmar la consulta, registra el diagnóstico o impresión diagnóstica.', diagnosticoInput);
      return false;
    }

    if (!window.RoleValidation.validateField(diagnosticoInput)) {
      return false;
    }

    if (!tratamientoInput.value.trim()) {
      showConsultaMessage('Para confirmar la consulta, registra el tratamiento, receta o indicaciones médicas.', tratamientoInput);
      return false;
    }

    if (!window.RoleValidation.validateField(tratamientoInput)) {
      return false;
    }

    return validateFilledClinicalFields();
  }

  function fillClinicalTextFromSelect(select) {
    const target = document.getElementById(select.dataset.target);

    if (!target || !select.value) return;

    if (select.value === '__otro__') {
      select.value = '';
      showConsultaMessage('Escribe manualmente la información clínica en el campo correspondiente.', target);
      return;
    }

    const selectedText = select.value;
    const currentText = target.value.trim();

    if (currentText && currentText !== selectedText) {
      select.value = '';
      showConsultaMessage(
        'Este campo ya tiene información escrita. Borra o edita el contenido manualmente antes de usar otra plantilla.',
        target
      );
      return;
    }

    target.value = selectedText;
    target.dispatchEvent(new Event('input', { bubbles: true }));
    select.value = '';
    clearConsultaMessage();
  }

  helperSelects.forEach(select => {
    select.addEventListener('change', () => fillClinicalTextFromSelect(select));
  });

  [
    diagnosticoInput,
    tratamientoInput,
    recomendacionesInput,
    observacionesInput
  ].forEach(input => {
    input.addEventListener('input', clearConsultaMessage);
  });

  saveDraftButton.addEventListener('click', () => {
    if (!validateFilledClinicalFields()) return;

    accionInput.value = 'borrador';

    if (typeof window.openCriticalFormConfirmation === 'function') {
      window.openCriticalFormConfirmation(consultaForm, {
        title: 'Guardar borrador clínico',
        message: 'La consulta quedará en progreso y no aparecerá como atención completada. Podrás continuarla luego antes de confirmar diagnóstico y tratamiento/receta.',
        button: 'Guardar borrador'
      });
      return;
    }

    consultaForm.submit();
  });

  openConfirmModal.addEventListener('click', () => {
    if (!validateRequiredForConfirmation()) return;

    medicalResponsibilityCheck.checked = false;
    confirmConsultaButton.disabled = true;
    confirmConsultaModal.classList.remove('hidden');
  });

  medicalResponsibilityCheck.addEventListener('change', () => {
    confirmConsultaButton.disabled = !medicalResponsibilityCheck.checked;
  });

  closeConfirmModal.addEventListener('click', () => {
    confirmConsultaModal.classList.add('hidden');
  });

  closeConfirmModalTop.addEventListener('click', () => {
    confirmConsultaModal.classList.add('hidden');
  });

  confirmConsultaModal.addEventListener('click', event => {
    if (event.target === confirmConsultaModal) {
      confirmConsultaModal.classList.add('hidden');
    }
  });

  confirmConsultaButton.addEventListener('click', () => {
    if (!medicalResponsibilityCheck.checked) {
      showConsultaMessage('Confirma que revisaste la información clínica antes de completar la consulta.');
      return;
    }

    accionInput.value = 'confirmar';
    consultaForm.submit();
  });

  consultaForm.addEventListener('submit', event => {
    if (!accionInput.value) {
      event.preventDefault();
      showConsultaMessage('Selecciona si deseas guardar en progreso o confirmar la consulta.');
      return;
    }

    if (accionInput.value === 'borrador' && !validateFilledClinicalFields()) {
      event.preventDefault();
      return;
    }

    if (accionInput.value === 'confirmar' && !validateRequiredForConfirmation()) {
      event.preventDefault();
    }
  });
</script>
