<div class="module-card consulta-card">
  <div class="module-header">
    <p>Revisa el triaje y registra la consulta del paciente.</p>
  </div>

  <section class="patient-summary">
    <div>
      <span>Paciente</span>
      <strong>
        <%= cita.paciente_nombres %>
        <%= cita.paciente_apellido_paterno %>
        <%= cita.paciente_apellido_materno || '' %>
      </strong>
    </div>

    <div>
      <span>DNI</span>
      <strong><%= cita.paciente_dni || 'No registrado' %></strong>
    </div>

    <div>
      <span>Edad</span>
      <strong><%= cita.paciente_edad !== null ? cita.paciente_edad + ' años' : 'No registrada' %></strong>
    </div>

    <div>
      <span>Sexo</span>
      <strong><%= cita.paciente_sexo || 'No registrado' %></strong>
    </div>

    <div>
      <span>Fecha y hora</span>
      <strong><%= new Date(cita.fecha).toLocaleDateString('es-PE') %> - <%= cita.hora %></strong>
    </div>

    <div class="full-row">
      <span>Motivo de consulta</span>
      <strong><%= cita.motivo %></strong>
    </div>
  </section>

  <section class="triaje-summary">
    <h3>Triaje registrado</h3>

    <div class="triaje-summary-grid">
      <div>
        <span>Temperatura</span>
        <strong><%= cita.temperatura %> °C</strong>
      </div>

      <div>
        <span>Presión arterial</span>
        <strong><%= cita.presion_arterial %></strong>
      </div>

      <div>
        <span>Frecuencia cardiaca</span>
        <strong><%= cita.frecuencia_cardiaca %> lpm</strong>
      </div>

      <div>
        <span>Saturación O₂</span>
        <strong><%= cita.saturacion %>%</strong>
      </div>

      <div class="full-row">
        <span>Síntomas</span>
        <strong><%= cita.sintomas %></strong>
      </div>

      <div class="full-row">
        <span>Observaciones de enfermería</span>
        <strong><%= cita.triaje_observaciones || 'Sin observaciones' %></strong>
      </div>
    </div>
  </section>

  <form action="/medico/citas/<%= cita.id_cita %>/atender" method="POST" class="consulta-form" id="consultaForm">
    <input type="hidden" name="accion" id="accionInput" value="">
    <div id="consultaMessage" class="step-message hidden"></div>

    <div class="form-group">
      <label for="diagnostico">Diagnóstico</label>
      <textarea 
        id="diagnostico" 
        name="diagnostico" 
        placeholder="Registra el diagnóstico del paciente."
        required
      ><%= cita.diagnostico || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="tratamiento">Tratamiento</label>
      <textarea 
        id="tratamiento" 
        name="tratamiento" 
        placeholder="Indica el tratamiento o indicaciones médicas."
        required
      ><%= cita.tratamiento || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="recomendaciones">Recomendaciones</label>
      <textarea 
        id="recomendaciones" 
        name="recomendaciones" 
        placeholder="Opcional: recomendaciones para el paciente."
      ><%= cita.recomendaciones || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="observaciones">Observaciones internas</label>
      <textarea 
        id="observaciones" 
        name="observaciones" 
        placeholder="Opcional: observaciones adicionales."
      ><%= cita.consulta_observaciones || '' %></textarea>
    </div>

    <label class="checkbox-line">
      <input 
        type="checkbox" 
        name="privada" 
        value="1"
        <%= cita.privada === 1 ? 'checked' : '' %>
      >
      <span>Marcar observaciones como privadas para el paciente</span>
    </label>

    <div class="notice-box">
      Puedes guardar como borrador para continuar después. Si confirmas la consulta, la cita pasará a estado completada.
    </div>

    <div class="form-actions">
      <a href="/medico/citas" class="btn-light">Cancelar</a>

    <button type="button" class="btn-secondary-action" id="saveDraftButton">
        Guardar borrador
    </button>

    <button type="button" class="btn-dark" id="openConfirmModal">
        Confirmar consulta
    </button>
    </div>
  </form>
    <div class="modal-overlay hidden" id="confirmConsultaModal">
    <div class="confirm-modal">
        <h3>Confirmar consulta</h3>
        <p>
        ¿Estás seguro de confirmar esta consulta? Después de confirmar, la cita pasará a estado
        <strong>completada</strong>.
        </p>

        <div class="modal-actions">
        <button type="button" class="btn-light" id="closeConfirmModal">Volver</button>
        <button type="button" class="btn-dark" id="confirmConsultaButton">Sí, confirmar</button>
        </div>
    </div>
    </div>
</div>

<script>
  const consultaForm = document.getElementById('consultaForm');
  const consultaMessage = document.getElementById('consultaMessage');

  const diagnosticoInput = document.getElementById('diagnostico');
  const tratamientoInput = document.getElementById('tratamiento');

  const accionInput = document.getElementById('accionInput');
  const saveDraftButton = document.getElementById('saveDraftButton');
  const openConfirmModal = document.getElementById('openConfirmModal');

  const confirmConsultaModal = document.getElementById('confirmConsultaModal');
  const closeConfirmModal = document.getElementById('closeConfirmModal');
  const confirmConsultaButton = document.getElementById('confirmConsultaButton');

  function showConsultaMessage(message, field = null) {
    consultaMessage.textContent = message;
    consultaMessage.classList.remove('hidden');

    document.querySelectorAll('.field-error').forEach(input => {
      input.classList.remove('field-error');
    });

    if (field) {
      field.classList.add('field-error');
      field.focus();
    }
  }

  function clearConsultaMessage() {
    consultaMessage.textContent = '';
    consultaMessage.classList.add('hidden');

    document.querySelectorAll('.field-error').forEach(input => {
      input.classList.remove('field-error');
    });
  }

  function validateConsultaForm() {
    if (!diagnosticoInput.value.trim()) {
      showConsultaMessage('Ingresa el diagnóstico del paciente.', diagnosticoInput);
      return false;
    }

    if (!tratamientoInput.value.trim()) {
      showConsultaMessage('Ingresa el tratamiento o indicaciones médicas.', tratamientoInput);
      return false;
    }

    return true;
  }

  [diagnosticoInput, tratamientoInput].forEach(input => {
    input.addEventListener('input', clearConsultaMessage);
  });

  saveDraftButton.addEventListener('click', () => {
    if (!validateConsultaForm()) return;

    accionInput.value = 'borrador';
    consultaForm.submit();
  });

  openConfirmModal.addEventListener('click', () => {
    if (!validateConsultaForm()) return;

    confirmConsultaModal.classList.remove('hidden');
  });

  closeConfirmModal.addEventListener('click', () => {
    confirmConsultaModal.classList.add('hidden');
  });

  confirmConsultaModal.addEventListener('click', (event) => {
    if (event.target === confirmConsultaModal) {
      confirmConsultaModal.classList.add('hidden');
    }
  });

  confirmConsultaButton.addEventListener('click', () => {
    accionInput.value = 'confirmar';
    consultaForm.submit();
  });

  consultaForm.addEventListener('submit', (event) => {
    if (!accionInput.value) {
      event.preventDefault();
      showConsultaMessage('Selecciona si deseas guardar borrador o confirmar la consulta.');
      return;
    }

    if (!validateConsultaForm()) {
      event.preventDefault();
    }
  });
</script>