<div class="module-card consulta-card">
  <div class="module-header">
    <p>Revisa el triaje y registra la consulta del paciente.</p>
  </div>

  <div class="notice-box">
    Los selectores de diagnóstico y receta son plantillas frecuentes editables. No reemplazan la evaluación médica ni generan una decisión automática.
  </div>

  <div class="clinical-workspace clinical-workspace-consulta">
    <aside class="clinical-workspace-side" aria-label="Contexto cl&iacute;nico del paciente">
      <div class="clinical-overview">
    <section class="patient-summary clinical-panel detail-info-panel detail-info-panel-two consistent-info-panel consistent-info-direct-panel">
      <h3><i class="bi bi-person-vcard" aria-hidden="true"></i>Resumen del paciente</h3>
      <div class="consistent-info-grid">
      <div><span>Paciente</span><strong><%= cita.paciente_nombres %> <%= cita.paciente_apellido_paterno %> <%= cita.paciente_apellido_materno || '' %></strong></div>
      <div><span>DNI</span><strong><%= cita.paciente_dni || 'No registrado' %></strong></div>
      <div><span>Edad</span><strong><%= cita.paciente_edad !== null ? cita.paciente_edad + ' años' : 'No registrada' %></strong></div>
      <div><span>Sexo</span><strong><%= cita.paciente_sexo || 'No registrado' %></strong></div>
      <div><span>Fecha y hora</span><strong><%= new Date(cita.fecha).toLocaleDateString('es-PE') %> - <%= cita.hora %></strong></div>
      <div><span>Motivo de consulta</span><strong><%= cita.motivo %></strong></div>
      </div>
    </section>

    <section class="triaje-summary clinical-panel clinical-antecedentes-panel detail-info-panel detail-info-panel-two consistent-info-panel">
      <h3><i class="bi bi-journal-medical" aria-hidden="true"></i>Antecedentes médicos referidos por el paciente</h3>
      <div class="triaje-summary-grid compact-clinical-grid consistent-info-grid">
        <div><span>Alergias</span><strong><%= cita.alergias || 'No registradas' %></strong></div>
        <div><span>Enfermedades previas</span><strong><%= cita.enfermedades_previas || 'No registradas' %></strong></div>
        <div><span>Medicación actual</span><strong><%= cita.medicacion_actual || 'No registrada' %></strong></div>
        <div><span>Cirugías</span><strong><%= cita.cirugias || 'No registradas' %></strong></div>
        <div><span>Antecedentes familiares</span><strong><%= cita.antecedentes_familiares || 'No registrados' %></strong></div>
        <div><span>Observaciones</span><strong><%= cita.antecedentes_observaciones || 'Sin observaciones' %></strong></div>
      </div>
    </section>
      </div>

  <section class="triaje-summary clinical-panel detail-info-panel detail-info-panel-two consistent-info-panel">
    <h3><i class="bi bi-activity" aria-hidden="true"></i>Triaje registrado</h3>
    <div class="triaje-summary-grid compact-clinical-grid consistent-info-grid">
      <div><span>Temperatura</span><strong><%= cita.temperatura %> °C</strong></div>
      <div><span>Presión arterial</span><strong><%= cita.presion_arterial %></strong></div>
      <div><span>Frecuencia cardiaca</span><strong><%= cita.frecuencia_cardiaca %> lpm</strong></div>
      <div><span>Saturación O₂</span><strong><%= cita.saturacion %>%</strong></div>
      <div><span>Síntomas verificados por enfermería (principal para atención)</span><strong><%= cita.sintomas %></strong></div>
      <div><span>Observaciones de enfermería</span><strong><%= cita.triaje_observaciones || 'Sin observaciones' %></strong></div>
    </div>
  </section>
    </aside>

    <div class="clinical-workspace-main">

  <form action="/medico/citas/<%= cita.id_cita %>/atender" method="POST" class="consulta-form js-role-validated-form" id="consultaForm" novalidate>
    <input type="hidden" name="accion" id="accionInput" value="">
    <div id="consultaMessage" class="step-message hidden"></div>

    <div class="medical-attention-stepper" role="tablist" aria-label="Pasos de atenci&oacute;n m&eacute;dica">
      <button type="button" class="medical-step-button is-active" id="consultaStepDiagnostico" data-consulta-step-target="diagnostico" role="tab" aria-selected="true" aria-controls="consultaPanelDiagnostico">
        <span>1</span>
        <strong>Diagn&oacute;stico</strong>
      </button>
      <button type="button" class="medical-step-button" id="consultaStepReceta" data-consulta-step-target="receta" role="tab" aria-selected="false" aria-controls="consultaPanelReceta">
        <span>2</span>
        <strong>Receta</strong>
      </button>
      <button type="button" class="medical-step-button" id="consultaStepRecomendaciones" data-consulta-step-target="recomendaciones" role="tab" aria-selected="false" aria-controls="consultaPanelRecomendaciones">
        <span>3</span>
        <strong>Recomendaciones</strong>
      </button>
      <button type="button" class="medical-step-button" id="consultaStepObservaciones" data-consulta-step-target="observaciones" role="tab" aria-selected="false" aria-controls="consultaPanelObservaciones">
        <span>4</span>
        <strong>Observaciones</strong>
      </button>
      <button type="button" class="medical-step-button" id="consultaStepConfirmacion" data-consulta-step-target="confirmacion" role="tab" aria-selected="false" aria-controls="consultaPanelConfirmacion">
        <span>5</span>
        <strong>Confirmaci&oacute;n</strong>
      </button>
    </div>

    <div class="consulta-form-grid">
      <section class="clinical-form-section medical-step-panel is-active" id="consultaPanelDiagnostico" data-consulta-step-panel="diagnostico" role="tabpanel" aria-labelledby="consultaStepDiagnostico">
        <div class="clinical-form-section-heading">
          <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>
          <div>
            <h3>Diagn&oacute;stico m&eacute;dico</h3>
          </div>
        </div>
        <p class="medical-step-intro">Registra la impresi&oacute;n diagn&oacute;stica seg&uacute;n la evaluaci&oacute;n cl&iacute;nica.</p>

      <div class="form-group">
        <label for="diagnostico_frecuente">Diagnóstico frecuente</label>
        <select id="diagnostico_frecuente" class="clinical-helper-select" data-target="diagnostico">
          <option value="">Seleccionar diagnóstico frecuente</option>
          <option value="Cefalea tensional">Cefalea tensional</option>
          <option value="Ansiedad en evaluación">Ansiedad en evaluación</option>
          <option value="Estrés académico">Estrés académico</option>
          <option value="Infección respiratoria alta">Infección respiratoria alta</option>
          <option value="Faringitis aguda">Faringitis aguda</option>
          <option value="Rinitis alérgica">Rinitis alérgica</option>
          <option value="Gastritis / dispepsia">Gastritis / dispepsia</option>
          <option value="Dolor abdominal en evaluación">Dolor abdominal en evaluación</option>
          <option value="Gastroenteritis aguda">Gastroenteritis aguda</option>
          <option value="Lumbalgia mecánica">Lumbalgia mecánica</option>
          <option value="Malestar general en evaluación">Malestar general en evaluación</option>
          <option value="Fiebre en evaluación">Fiebre en evaluación</option>
          <option value="Hipertensión arterial en evaluación">Hipertensión arterial en evaluación</option>
          <option value="Dermatitis en evaluación">Dermatitis en evaluación</option>
          <option value="Infección urinaria probable">Infección urinaria probable</option>
          <option value="__otro__">Otro / Especificar manualmente</option>
        </select>
        <p id="diagnosticoTemplateHint" class="clinical-template-hint hidden" aria-live="polite"><i class="bi bi-info-circle" aria-hidden="true"></i><span id="diagnosticoTemplateHintText"></span></p>

        <label for="diagnostico"><span class="required-indicator">Diagnóstico / impresión diagnóstica registrada por el médico</span></label>
        <textarea id="diagnostico" name="diagnostico" placeholder="Registra el diagnóstico o impresión diagnóstica según la evaluación médica." minlength="5" maxlength="255" data-validate="clinical-text" data-min="5"><%= cita.diagnostico || '' %></textarea>
        <span class="field-message" data-for="diagnostico"></span>
      </div>
      </section>

      <section class="clinical-form-section medical-step-panel" id="consultaPanelReceta" data-consulta-step-panel="receta" role="tabpanel" aria-labelledby="consultaStepReceta">
        <div class="clinical-form-section-heading">
          <i class="bi bi-capsule" aria-hidden="true"></i>
          <div>
            <h3>Receta m&eacute;dica</h3>
          </div>
        </div>

      <div class="prescription-builder">
        <p class="prescription-helper-text">Agrega cada medicamento con sus indicaciones. La receta se forma con los medicamentos que registres.</p>

        <div class="prescription-fields">
          <div class="form-group prescription-medicine-search">
            <label for="recetaMedicamento"><span class="required-indicator">Medicamento</span></label>
            <div class="prescription-search-control">
              <input id="recetaMedicamento" type="search" autocomplete="off" required placeholder="Escribe el nombre del medicamento" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="prescriptionSuggestions">
              <input id="recetaMedicamentoId" type="hidden">
            </div>
            <div id="prescriptionSuggestions" class="prescription-suggestions hidden" role="listbox" aria-label="Sugerencias de medicamentos"></div>
            <div id="prescriptionMedicineMessage" class="field-message" aria-live="polite"></div>
          </div>

          <div class="form-group">
            <label for="recetaPresentacion"><span class="required-indicator">Presentaci&oacute;n</span></label>
            <select id="recetaPresentacion" required disabled>
              <option value="">Primero selecciona un medicamento</option>
            </select>
            <div id="prescriptionPresentationMessage" class="field-message" aria-live="polite"></div>
          </div>

          <div class="form-group">
            <label for="recetaDosis"><span class="required-indicator">Dosis recomendada</span></label>
            <div class="prescription-dose-control">
              <input id="recetaDosis" type="number" min="0.01" max="1000" step="0.01" inputmode="decimal" required disabled aria-describedby="recetaDosisHelp" placeholder="Se completa al elegir la presentaci&oacute;n">
              <span id="recetaUnidadText" aria-live="polite">Unidad</span>
            </div>
            <input id="recetaUnidad" type="hidden">
            <div id="prescriptionDoseMessage" class="field-message" aria-live="polite"></div>
            <small id="recetaDosisHelp" class="dose-help"><i class="bi bi-info-circle" aria-hidden="true"></i><span>M&aacute;ximo 1000 por dosis y hasta dos decimales.</span></small>
          </div>

          <div class="form-group">
            <label for="recetaFrecuencia"><span class="required-indicator">Frecuencia</span></label>
            <select id="recetaFrecuencia" required disabled>
              <option value="">Seleccionar</option>
              <option>Una vez al d&iacute;a</option>
              <option>Cada 12 horas</option>
              <option>Cada 8 horas</option>
              <option>Cada 6 horas</option>
              <option>Cada 4 horas</option>
              <option>Seg&uacute;n necesidad</option>
              <option>Antes de alimentos</option>
              <option>Despu&eacute;s de alimentos</option>
              <option>Por la noche</option>
            </select>
            <div id="prescriptionFrequencyMessage" class="field-message" aria-live="polite"></div>
          </div>

          <div class="form-group prescription-field-wide">
            <label for="recetaIndicaciones">Indicaciones de uso</label>
            <textarea id="recetaIndicaciones" maxlength="220" placeholder="Opcional: por ejemplo, tomar con alimentos o aplicar sobre la zona afectada."></textarea>
          </div>
        </div>
        <button type="button" class="btn-light icon-action add-prescription-button" id="addPrescriptionItemButton" title="Agregar otro medicamento" aria-label="Agregar otro medicamento" disabled>
          <i class="bi bi-plus-circle" aria-hidden="true"></i>
          <span>Agregar otro medicamento</span>
        </button>

        <section class="prescription-list-panel hidden" id="prescriptionListPanel" aria-labelledby="prescriptionListTitle">
          <div class="prescription-list-heading">
            <h4 id="prescriptionListTitle">Medicamentos de la receta</h4>
            <span id="prescriptionCount">0 agregados</span>
          </div>
          <div id="prescriptionList" role="list">
            <p class="prescription-empty-state" id="prescriptionEmptyState">A&uacute;n no agregaste medicamentos a la receta.</p>
          </div>
        </section>

        <textarea id="tratamiento" name="tratamiento" class="recipe-serialized-field" readonly tabindex="-1" aria-hidden="true" minlength="5" maxlength="800" data-validate="clinical-text" data-min="5"><%= cita.tratamiento || '' %></textarea>
        <span class="field-message" data-for="tratamiento"></span>
      </div>
      </section>

      <section class="clinical-form-section medical-step-panel" id="consultaPanelRecomendaciones" data-consulta-step-panel="recomendaciones" role="tabpanel" aria-labelledby="consultaStepRecomendaciones">
        <div class="clinical-form-section-heading">
          <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
          <div>
            <h3>Indicaciones al paciente</h3>
          </div>
        </div>
        <p class="medical-step-intro">Resume cuidados, signos de alarma, controles o recomendaciones preventivas.</p>

      <div class="form-group">
        <label for="recomendaciones">Indicaciones y recomendaciones para el paciente</label>
        <textarea id="recomendaciones" name="recomendaciones" placeholder="Opcional: cuidados en casa, signos de alarma, controles o recomendaciones preventivas." maxlength="800" data-validate="clinical-text" data-min="5"><%= cita.recomendaciones || '' %></textarea>
        <span class="field-message" data-for="recomendaciones"></span>
      </div>
      </section>

      <section class="clinical-form-section medical-step-panel" id="consultaPanelObservaciones" data-consulta-step-panel="observaciones" role="tabpanel" aria-labelledby="consultaStepObservaciones">
        <div class="clinical-form-section-heading">
          <i class="bi bi-shield-lock" aria-hidden="true"></i>
          <div>
            <h3>Notas internas</h3>
          </div>
        </div>
        <p class="medical-step-intro">Agrega observaciones de uso cl&iacute;nico interno si son necesarias.</p>

      <div class="form-group">
        <label for="observaciones">Observaciones internas</label>
        <textarea id="observaciones" name="observaciones" placeholder="Opcional: observaciones adicionales para uso interno." maxlength="800" data-validate="clinical-text" data-min="5"><%= cita.consulta_observaciones || '' %></textarea>
        <span class="field-message" data-for="observaciones"></span>

        <label class="checkbox-line checkbox-line-compact">
          <input type="checkbox" name="privada" value="1" <%= cita.privada === 1 ? 'checked' : '' %>>
          <span>Ocultar estas observaciones al paciente</span>
        </label>
      </div>
      </section>

      <section class="clinical-form-section medical-step-panel medical-confirmation-panel clinical-panel detail-info-panel consistent-info-panel" id="consultaPanelConfirmacion" data-consulta-step-panel="confirmacion" role="tabpanel" aria-labelledby="consultaStepConfirmacion">
        <div class="clinical-form-section-heading">
          <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
          <div>
            <h3>Revisión antes de confirmar</h3>
          </div>
        </div>
        <p class="medical-step-intro">Comprueba el registro antes de marcar la atención como completada.</p>

        <div class="medical-confirmation-grid consistent-info-grid" aria-live="polite">
          <div><span>Diagnóstico</span><strong id="consultaPreviewDiagnostico">Pendiente</strong></div>
          <div><span>Receta médica</span><strong id="consultaPreviewTratamiento">Pendiente</strong></div>
          <div><span>Recomendaciones</span><strong id="consultaPreviewRecomendaciones">Sin recomendaciones</strong></div>
          <div><span>Observaciones internas</span><strong id="consultaPreviewObservaciones">Sin observaciones internas</strong></div>
        </div>
        <p class="medical-confirmation-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Podrás volver a cualquier paso para corregir la información antes de confirmar.</span></p>
      </section>
    </div>

    <div class="notice-box">
      Puedes guardar la consulta en progreso sin completar todos los campos. Para confirmar, el diagnóstico y la receta médica son obligatorios.
    </div>

    <div class="form-actions">
      <button type="button" class="btn-light btn-cancel-attention" id="cancelConsultaButton" data-cancel-url="<%= typeof backUrl !== 'undefined' ? backUrl : '/medico/citas' %>" title="Cancelar atención" aria-label="Cancelar atención">
        <img class="action-metaphor" src="/img/action-metaphors/medico/consultas/cancelar.png" alt="" aria-hidden="true">
        <span>Cancelar atenci&oacute;n</span>
      </button>
      <button type="button" class="btn-secondary-action icon-action" id="saveDraftButton" title="Guardar consulta en progreso" aria-label="Guardar consulta en progreso">
        <img class="action-metaphor" src="/img/action-metaphors/medico/consultas/guardar.png" alt="" aria-hidden="true">
        <span>Guardar en progreso</span>
      </button>
      <button type="button" class="btn-light icon-action hidden" id="prevStepButton" title="Volver al paso anterior" aria-label="Volver al paso anterior">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>Volver</span>
      </button>
      <button type="button" class="btn-dark icon-action" id="nextStepButton" title="Continuar al siguiente paso" aria-label="Continuar al siguiente paso">
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
        <span>Continuar</span>
      </button>
      <button type="button" class="btn-dark icon-action hidden" id="openConfirmModal" title="Confirmar consulta" aria-label="Confirmar consulta">
        <img class="action-metaphor" src="/img/action-metaphors/medico/consultas/confirmar.png" alt="" aria-hidden="true">
        <span>Confirmar consulta</span>
      </button>
    </div>
  </form>
    </div>
  </div>

  <div class="modal-overlay hidden" id="confirmConsultaModal" role="dialog" aria-modal="true" aria-labelledby="confirmConsultaTitle" aria-describedby="confirmConsultaText">
    <div class="confirm-modal confirm-modal-polished" data-confirm-action="confirmar">
      <button type="button" class="modal-close confirm-modal-close" id="closeConfirmModalTop" aria-label="Cerrar confirmación">&times;</button>
      <div class="confirm-modal-icon" aria-hidden="true">
        <i class="bi bi-clipboard2-check"></i>
      </div>
      <h3 id="confirmConsultaTitle">Confirmar consulta</h3>
      <p id="confirmConsultaText">Antes de completar la atención, verifica que el diagnóstico y la receta médica correspondan a la evaluación realizada.</p>

      <small class="confirm-modal-note">La consulta quedará finalizada y visible en el historial clínico.</small>

      <label class="checkbox-line">
        <input type="checkbox" id="medicalResponsibilityCheck">
        <span>Confirmo que revisé antecedentes, triaje y que el registro final corresponde a mi criterio médico.</span>
      </label>
      <small class="field-message" data-for="medicalResponsibilityCheck"></small>

      <div class="modal-actions confirm-consulta-actions">
        <button type="button" class="btn-light" id="closeConfirmModal" title="Cancelar" aria-label="Cancelar">
          <i class="bi bi-arrow-left" aria-hidden="true"></i>
          <span>Cancelar</span>
        </button>
        <button type="button" class="btn-dark icon-action" id="confirmConsultaButton" disabled aria-disabled="true" title="Sí, confirmar" aria-label="Sí, confirmar">
          <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
          <span>Sí, confirmar</span>
        </button>
      </div>
    </div>
  </div>

  <div class="modal-overlay hidden" id="cancelConsultaModal" role="dialog" aria-modal="true" aria-labelledby="cancelConsultaTitle" aria-describedby="cancelConsultaText">
    <div class="confirm-modal confirm-modal-polished" data-confirm-action="cancelar">
      <button type="button" class="modal-close confirm-modal-close" id="closeCancelModalTop" aria-label="Cerrar cancelación">&times;</button>
      <div class="confirm-modal-icon confirm-modal-icon-warning" aria-hidden="true">
        <i class="bi bi-exclamation-circle"></i>
      </div>
      <h3 id="cancelConsultaTitle">Cancelar atenci&oacute;n</h3>
      <p id="cancelConsultaText">Se perder&aacute;n los cambios no guardados de esta atenci&oacute;n. Esta acci&oacute;n no puede deshacerse.</p>
      <div class="modal-actions">
        <button type="button" class="btn-light" id="closeCancelModal" title="Seguir registrando" aria-label="Seguir registrando">
          <span>Seguir registrando</span>
        </button>
        <button type="button" class="btn-cancel-attention" id="confirmCancelConsultaButton" title="Sí, cancelar atención" aria-label="Sí, cancelar atención">
          <span>S&iacute;, cancelar atenci&oacute;n</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="/js/role-validations.js"></script>

<script>
  const consultaForm = document.getElementById('consultaForm');
  const consultaMessage = document.getElementById('consultaMessage');

  const diagnosticoInput = document.getElementById('diagnostico');
  const diagnosticoFrecuente = document.getElementById('diagnostico_frecuente');
  const diagnosticoTemplateHint = document.getElementById('diagnosticoTemplateHint');
  const diagnosticoTemplateHintText = document.getElementById('diagnosticoTemplateHintText');
  const tratamientoInput = document.getElementById('tratamiento');
  const recomendacionesInput = document.getElementById('recomendaciones');
  const observacionesInput = document.getElementById('observaciones');
  const privadaInput = consultaForm.querySelector('input[name="privada"]');

  const recetaMedicamento = document.getElementById('recetaMedicamento');
  const recetaMedicamentoId = document.getElementById('recetaMedicamentoId');
  const prescriptionSuggestions = document.getElementById('prescriptionSuggestions');
  const recetaPresentacion = document.getElementById('recetaPresentacion');
  const recetaDosis = document.getElementById('recetaDosis');
  const recetaUnidad = document.getElementById('recetaUnidad');
  const recetaUnidadText = document.getElementById('recetaUnidadText');
  const recetaFrecuencia = document.getElementById('recetaFrecuencia');
  const recetaIndicaciones = document.getElementById('recetaIndicaciones');
  const addPrescriptionItemButton = document.getElementById('addPrescriptionItemButton');
  const prescriptionList = document.getElementById('prescriptionList');
  const prescriptionListPanel = document.getElementById('prescriptionListPanel');
  const prescriptionCount = document.getElementById('prescriptionCount');
  const prescriptionMedicineMessage = document.getElementById('prescriptionMedicineMessage');
  const prescriptionPresentationMessage = document.getElementById('prescriptionPresentationMessage');
  const prescriptionDoseMessage = document.getElementById('prescriptionDoseMessage');
  const prescriptionFrequencyMessage = document.getElementById('prescriptionFrequencyMessage');
  let prescriptionItems = [];
  let editingPrescriptionIndex = null;
  let selectedMedication = null;
  let medicationPresentations = [];
  let medicationSearchTimer = null;
  const legacyPrescriptionText = tratamientoInput.value.trim();
  let initialConsultaState = null;

  const helperSelects = document.querySelectorAll('.clinical-helper-select');

  const accionInput = document.getElementById('accionInput');
  const saveDraftButton = document.getElementById('saveDraftButton');
  const prevStepButton = document.getElementById('prevStepButton');
  const nextStepButton = document.getElementById('nextStepButton');
  const openConfirmModal = document.getElementById('openConfirmModal');
  const stepOrder = ['diagnostico', 'receta', 'recomendaciones', 'observaciones', 'confirmacion'];
  const stepPanels = Array.from(document.querySelectorAll('[data-consulta-step-panel]'));
  const stepButtons = Array.from(document.querySelectorAll('[data-consulta-step-target]'));
  const consultaPreviewDiagnostico = document.getElementById('consultaPreviewDiagnostico');
  const consultaPreviewTratamiento = document.getElementById('consultaPreviewTratamiento');
  const consultaPreviewRecomendaciones = document.getElementById('consultaPreviewRecomendaciones');
  const consultaPreviewObservaciones = document.getElementById('consultaPreviewObservaciones');
  let currentStepIndex = 0;

  const confirmConsultaModal = document.getElementById('confirmConsultaModal');
  const closeConfirmModal = document.getElementById('closeConfirmModal');
  const closeConfirmModalTop = document.getElementById('closeConfirmModalTop');
  const confirmConsultaButton = document.getElementById('confirmConsultaButton');
  const medicalResponsibilityCheck = document.getElementById('medicalResponsibilityCheck');
  const cancelConsultaButton = document.getElementById('cancelConsultaButton');
  const cancelConsultaModal = document.getElementById('cancelConsultaModal');
  const closeCancelModal = document.getElementById('closeCancelModal');
  const closeCancelModalTop = document.getElementById('closeCancelModalTop');
  const confirmCancelConsultaButton = document.getElementById('confirmCancelConsultaButton');

  function showConsultaMessage(message, field = null) {
    consultaMessage.textContent = '';
    consultaMessage.classList.add('hidden');

    document.querySelectorAll('.field-error').forEach(input => {
      input.classList.remove('field-error');
    });

    if (field) {
      field.classList.add('field-error');
      field.setAttribute('aria-invalid', 'true');
      const target = consultaForm.querySelector(`.field-message[data-for="${field.id}"]`)
        || confirmConsultaModal.querySelector(`.field-message[data-for="${field.id}"]`);
      if (target) {
        target.textContent = message;
        target.classList.add('is-visible');
      }
      field.focus();
    } else {
      consultaMessage.textContent = message;
      consultaMessage.classList.remove('hidden');
    }
  }

  function clearConsultaMessage() {
    consultaMessage.textContent = '';
    consultaMessage.classList.add('hidden');
  }

  function showPrescriptionMessage(message, field = null, type = 'error') {
    clearPrescriptionMessage();
    const fieldMessages = new Map([
      [recetaMedicamento, prescriptionMedicineMessage],
      [recetaPresentacion, prescriptionPresentationMessage],
      [recetaDosis, prescriptionDoseMessage],
      [recetaFrecuencia, prescriptionFrequencyMessage]
    ]);
    const target = fieldMessages.get(field) || prescriptionMedicineMessage;
    target.textContent = message;
    target.classList.add('is-visible');
    target.classList.toggle('is-success', type === 'success');
    if (field) field.focus();
  }

  function clearPrescriptionMessage() {
    [
      prescriptionMedicineMessage,
      prescriptionPresentationMessage,
      prescriptionDoseMessage,
      prescriptionFrequencyMessage
    ].forEach(message => {
      message.textContent = '';
      message.classList.remove('is-visible');
      message.classList.remove('is-success');
    });
  }

  function serializePrescriptionItemsState() {
    return JSON.stringify(prescriptionItems.map(item => ({
      idMedicamento: String(item.idMedicamento || ''),
      idPresentacion: String(item.idPresentacion || ''),
      medicamento: item.medicamento || '',
      presentacion: item.presentacion || '',
      dosis: item.dosis || '',
      unidad: item.unidad || '',
      frecuencia: item.frecuencia || '',
      indicaciones: item.indicaciones || ''
    })));
  }

  function getConsultaState() {
    return {
      diagnostico: diagnosticoInput.value,
      tratamiento: tratamientoInput.value,
      recomendaciones: recomendacionesInput.value,
      observaciones: observacionesInput.value,
      privada: privadaInput && privadaInput.checked ? '1' : '0',
      recetaMedicamento: recetaMedicamento.value,
      recetaMedicamentoId: recetaMedicamentoId.value,
      recetaPresentacion: recetaPresentacion.value,
      recetaDosis: recetaDosis.value,
      recetaUnidad: recetaUnidad.value,
      recetaFrecuencia: recetaFrecuencia.value,
      recetaIndicaciones: recetaIndicaciones.value,
      medicamentos: serializePrescriptionItemsState()
    };
  }

  function consultaHasChanges() {
    if (!initialConsultaState) return false;
    const currentConsultaState = getConsultaState();
    return Object.keys(initialConsultaState).some(key => currentConsultaState[key] !== initialConsultaState[key]);
  }

  function getPrescriptionMedicine() {
    return selectedMedication ? selectedMedication.nombre : '';
  }

  function clearPrescriptionFields() {
    recetaMedicamento.value = '';
    recetaMedicamentoId.value = '';
    selectedMedication = null;
    medicationPresentations = [];
    prescriptionSuggestions.replaceChildren();
    prescriptionSuggestions.classList.add('hidden');
    recetaMedicamento.setAttribute('aria-expanded', 'false');
    resetPresentationOptions();
    recetaIndicaciones.value = '';
    editingPrescriptionIndex = null;
    addPrescriptionItemButton.querySelector('span').textContent = 'Agregar otro medicamento';
  }

  function setPrescriptionFields(item) {
    selectedMedication = { id_medicamento: item.idMedicamento, nombre: item.medicamento };
    recetaMedicamento.value = item.medicamento;
    recetaMedicamentoId.value = item.idMedicamento;
    medicationPresentations = [{
      id_presentacion: item.idPresentacion,
      presentacion: item.presentacion,
      dosis_habitual: item.dosis,
      unidad_dosis: item.unidad
    }];
    recetaPresentacion.innerHTML = `<option value="${item.idPresentacion}">${item.presentacion}</option>`;
    recetaPresentacion.disabled = false;
    recetaPresentacion.value = String(item.idPresentacion);
    recetaDosis.value = item.dosis;
    recetaDosis.disabled = false;
    recetaUnidad.value = item.unidad;
    recetaUnidadText.textContent = item.unidad;
    recetaFrecuencia.value = item.frecuencia;
    recetaFrecuencia.disabled = false;
    recetaIndicaciones.value = item.indicaciones;
  }

  function readPrescriptionItem() {
    const selectedPresentation = medicationPresentations.find(
      presentation => String(presentation.id_presentacion) === recetaPresentacion.value
    );

    return {
      idMedicamento: selectedMedication ? selectedMedication.id_medicamento : '',
      idPresentacion: recetaPresentacion.value,
      medicamento: getPrescriptionMedicine(),
      presentacion: selectedPresentation ? selectedPresentation.presentacion : '',
      dosis: recetaDosis.value.trim(),
      unidad: recetaUnidad.value,
      frecuencia: recetaFrecuencia.value,
      indicaciones: recetaIndicaciones.value.trim()
    };
  }

  function validatePrescriptionItem(item) {
    const requiredFields = [
      [item.idMedicamento, 'Selecciona un medicamento de las sugerencias.', recetaMedicamento],
      [item.presentacion, 'Selecciona la presentación del medicamento.', recetaPresentacion],
      [item.dosis, 'No se encontró una dosis recomendada para esta presentación.', recetaPresentacion],
      [item.frecuencia, 'Selecciona la frecuencia de uso.', recetaFrecuencia]
    ];

    const missing = requiredFields.find(([value]) => !value);
    if (missing) {
      showPrescriptionMessage(missing[1], missing[2]);
      return false;
    }

    if (!isDoseWithinAllowedRange()) {
      showPrescriptionMessage('Ingresa una dosis entre 0.01 y 1000, con hasta dos decimales.', recetaDosis);
      return false;
    }

    return true;
  }

  function isPrescriptionFormComplete() {
    const item = readPrescriptionItem();
    return Boolean(item.idMedicamento && item.presentacion && item.dosis && item.frecuencia && isDoseWithinAllowedRange());
  }

  function isDoseWithinAllowedRange() {
    const rawValue = recetaDosis.value;
    const numericValue = Number(rawValue);
    const decimalPart = rawValue.includes('.') ? rawValue.split('.')[1] : '';
    return Boolean(
      rawValue
      && Number.isFinite(numericValue)
      && numericValue >= 0.01
      && numericValue <= 1000
      && decimalPart.length <= 2
    );
  }

  function hasPrescriptionFormContent() {
    return Boolean(
      recetaMedicamento.value.trim()
      || recetaPresentacion.value
      || recetaDosis.value.trim()
      || recetaFrecuencia.value
      || recetaIndicaciones.value.trim()
    );
  }

  function commitPrescriptionItem(showSuccess = false) {
    const item = readPrescriptionItem();
    if (!validatePrescriptionItem(item)) return false;

    if (editingPrescriptionIndex === null) {
      prescriptionItems.push(item);
    } else {
      prescriptionItems[editingPrescriptionIndex] = item;
    }

    clearPrescriptionFields();
    renderPrescriptionList();
    serializePrescription();
    if (showSuccess) {
      showPrescriptionMessage('Medicamento agregado. Puedes registrar otro con el botón +.', null, 'success');
    }
    return true;
  }

  function serializePrescription() {
    const medicationLines = prescriptionItems.map((item, index) => {
      const instructions = item.indicaciones ? `. Indicaciones: ${item.indicaciones}` : '';
      return `${index + 1}. ${item.medicamento} - ${item.presentacion}; ${item.dosis} ${item.unidad}; ${item.frecuencia}${instructions}`;
    });
    if (legacyPrescriptionText) medicationLines.unshift(legacyPrescriptionText);

    tratamientoInput.value = medicationLines.join('\n');
    tratamientoInput.dispatchEvent(new Event('input', { bubbles: true }));
  }

  function renderPrescriptionList() {
    prescriptionList.innerHTML = '';
    prescriptionCount.textContent = `${prescriptionItems.length} ${prescriptionItems.length === 1 ? 'agregado' : 'agregados'}`;
    prescriptionListPanel.classList.toggle('hidden', prescriptionItems.length === 0);

    if (prescriptionItems.length === 0) {
      const emptyState = document.createElement('p');
      emptyState.className = 'prescription-empty-state';
      emptyState.textContent = 'Aun no agregaste medicamentos a la receta.';
      prescriptionList.appendChild(emptyState);
      return;
    }

    prescriptionItems.forEach((item, index) => {
      const article = document.createElement('article');
      article.className = 'prescription-item';
      article.setAttribute('role', 'listitem');

      const info = document.createElement('div');
      const title = document.createElement('strong');
      title.textContent = `${index + 1}. ${item.medicamento}`;
      const detail = document.createElement('span');
      detail.textContent = `${item.presentacion} | ${item.dosis} ${item.unidad} | ${item.frecuencia}`;
      info.append(title, detail);
      if (item.indicaciones) {
        const instructions = document.createElement('small');
        instructions.textContent = `Indicaciones: ${item.indicaciones}`;
        info.appendChild(instructions);
      }

      const actions = document.createElement('div');
      actions.className = 'prescription-item-actions';
      const editButton = document.createElement('button');
      editButton.type = 'button';
      editButton.className = 'prescription-item-button icon-only';
      editButton.dataset.prescriptionAction = 'edit';
      editButton.dataset.prescriptionIndex = String(index);
      editButton.title = 'Editar medicamento';
      editButton.setAttribute('aria-label', 'Editar medicamento');
      editButton.innerHTML = '<i class="bi bi-pencil" aria-hidden="true"></i>';
      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className = 'prescription-item-button is-danger icon-only';
      removeButton.dataset.prescriptionAction = 'remove';
      removeButton.dataset.prescriptionIndex = String(index);
      removeButton.title = 'Quitar medicamento';
      removeButton.setAttribute('aria-label', 'Quitar medicamento');
      removeButton.innerHTML = '<i class="bi bi-trash" aria-hidden="true"></i>';
      actions.append(editButton, removeButton);
      article.append(info, actions);
      prescriptionList.appendChild(article);
    });
  }

  function hasPrescriptionContent() {
    return prescriptionItems.length > 0 || legacyPrescriptionText.length >= 5;
  }

  function previewText(value, fallback) {
    const text = value.trim();
    if (!text) return fallback;
    return text.length > 140 ? `${text.slice(0, 140)}...` : text;
  }

  function updateConsultaPreview() {
    consultaPreviewDiagnostico.textContent = previewText(diagnosticoInput.value, 'Pendiente');
    consultaPreviewTratamiento.textContent = previewText(tratamientoInput.value, 'Pendiente');
    consultaPreviewRecomendaciones.textContent = previewText(recomendacionesInput.value, 'Sin recomendaciones');
    consultaPreviewObservaciones.textContent = previewText(observacionesInput.value, 'Sin observaciones internas');
  }

  function showConsultaStep(index, moveFocus = false) {
    currentStepIndex = Math.max(0, Math.min(index, stepOrder.length - 1));
    const activeStep = stepOrder[currentStepIndex];

    stepPanels.forEach(panel => {
      const active = panel.dataset.consultaStepPanel === activeStep;
      panel.classList.toggle('is-active', active);
      panel.setAttribute('aria-hidden', String(!active));
    });

    stepButtons.forEach(button => {
      const active = button.dataset.consultaStepTarget === activeStep;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', String(active));
    });

    prevStepButton.classList.toggle('hidden', currentStepIndex === 0);
    nextStepButton.classList.toggle('hidden', currentStepIndex === stepOrder.length - 1);
    openConfirmModal.classList.toggle('hidden', currentStepIndex !== stepOrder.length - 1);
    updateStepActionState();
    updateConsultaPreview();
    clearConsultaMessage();

    if (moveFocus) {
      if (activeStep === 'receta') {
        recetaMedicamento.focus();
        return;
      }
      const heading = stepPanels.find(panel => panel.dataset.consultaStepPanel === activeStep)?.querySelector('h3');
      if (heading) {
        heading.setAttribute('tabindex', '-1');
        heading.focus();
      }
    }
  }

  function updateStepActionState() {
    const currentStep = stepOrder[currentStepIndex];
    let canContinue = true;

    if (currentStep === 'diagnostico') {
      canContinue = diagnosticoInput.value.trim().length >= 5;
    }

    if (currentStep === 'receta') {
      const formComplete = isPrescriptionFormComplete();
      const hasPartialForm = hasPrescriptionFormContent() && !formComplete;
      addPrescriptionItemButton.disabled = !formComplete;
      canContinue = formComplete || (hasPrescriptionContent() && !hasPartialForm);
    }

    nextStepButton.disabled = !canContinue;
  }

  function validateStepBeforeContinue(step) {
    if (step === 'diagnostico') {
      if (!diagnosticoInput.value.trim()) {
        showConsultaMessage('Registra el diagnóstico o impresión diagnóstica para continuar.', diagnosticoInput);
        return false;
      }
      return window.RoleValidation.validateField(diagnosticoInput);
    }

    if (step === 'receta') {
      if (isPrescriptionFormComplete() && !commitPrescriptionItem(false)) return false;
      if (hasPrescriptionFormContent() && !isPrescriptionFormComplete()) {
        showPrescriptionMessage('Completa los campos obligatorios del medicamento antes de continuar.', recetaMedicamento);
        return false;
      }
      serializePrescription();
      if (!hasPrescriptionContent()) {
        showPrescriptionMessage('Agrega al menos un medicamento a la receta.', recetaMedicamento);
        return false;
      }
      if (!window.RoleValidation.validateField(tratamientoInput)) {
        showPrescriptionMessage('Revisa los datos de la receta antes de continuar.', recetaMedicamento);
        return false;
      }
      if (!tratamientoInput.value.trim()) {
        showConsultaMessage('Registra la receta médica e indicaciones de uso para continuar.', tratamientoInput);
        return false;
      }
      return window.RoleValidation.validateField(tratamientoInput);
    }

    const fieldByStep = {
      recomendaciones: recomendacionesInput,
      observaciones: observacionesInput
    };
    const field = fieldByStep[step];
    return !field || !field.value.trim() || window.RoleValidation.validateField(field);
  }

  function validateFilledClinicalFields() {
    const fields = [
      diagnosticoInput,
      tratamientoInput,
      recomendacionesInput,
      observacionesInput
    ];

    for (const field of fields) {
      if (field.value.trim() && !window.RoleValidation.validateField(field)) {
        return false;
      }
    }

    return true;
  }

  function validateRequiredForConfirmation() {
    serializePrescription();
    if (!diagnosticoInput.value.trim()) {
      showConsultaMessage('Para confirmar la consulta, registra el diagnóstico o impresión diagnóstica.', diagnosticoInput);
      return false;
    }

    if (!window.RoleValidation.validateField(diagnosticoInput)) {
      return false;
    }

    if (!hasPrescriptionContent()) {
      showConsultaStep(stepOrder.indexOf('receta'));
      showPrescriptionMessage('Para confirmar la consulta, agrega al menos un medicamento.', recetaMedicamento);
      return false;
    }

    if (!window.RoleValidation.validateField(tratamientoInput)) {
      showConsultaStep(stepOrder.indexOf('receta'));
      showPrescriptionMessage('Revisa los datos de la receta antes de confirmar.', recetaMedicamento);
      return false;
    }

    return validateFilledClinicalFields();
  }

  function fillClinicalTextFromSelect(select) {
    const target = document.getElementById(select.dataset.target);

    if (!target || !select.value) return;

    if (select.value === '__otro__') {
      select.value = '';
      if (select === diagnosticoFrecuente) diagnosticoTemplateHint.classList.add('hidden');
      showConsultaMessage('Escribe manualmente la información clínica en el campo correspondiente.', target);
      return;
    }

    const selectedText = select.value;
    const currentText = target.value.trim();

    if (select.dataset.append === 'true') {
      target.value = currentText ? `${currentText}\n${selectedText}` : selectedText;
      target.dispatchEvent(new Event('input', { bubbles: true }));
      select.value = '';
      clearConsultaMessage();
      return;
    }

    if (currentText && currentText !== selectedText) {
      select.value = '';
      if (select === diagnosticoFrecuente) diagnosticoTemplateHint.classList.add('hidden');
      showConsultaMessage(
        'Este campo ya tiene información escrita. Borra o edita el contenido manualmente antes de usar otra plantilla.',
        target
      );
      return;
    }

    target.value = selectedText;
    target.dispatchEvent(new Event('input', { bubbles: true }));
    if (select === diagnosticoFrecuente) {
      diagnosticoTemplateHintText.textContent = 'Diagnóstico frecuente cargado. Puedes editarlo o agregar precisiones clínicas en la caja de texto.';
      diagnosticoTemplateHint.classList.remove('hidden');
    } else {
      select.value = '';
    }
    clearConsultaMessage();
  }

  helperSelects.forEach(select => {
    select.addEventListener('change', () => fillClinicalTextFromSelect(select));
  });

  function resetPresentationOptions() {
    medicationPresentations = [];
    recetaPresentacion.innerHTML = '<option value="">Primero selecciona un medicamento</option>';
    recetaPresentacion.disabled = true;
    recetaDosis.value = '';
    recetaDosis.disabled = true;
    recetaUnidad.value = '';
    recetaUnidadText.textContent = 'Unidad';
    recetaFrecuencia.value = '';
    recetaFrecuencia.disabled = true;
  }

  function hideMedicationSuggestions() {
    prescriptionSuggestions.replaceChildren();
    prescriptionSuggestions.classList.add('hidden');
    recetaMedicamento.setAttribute('aria-expanded', 'false');
  }

  function renderMedicationSuggestions(medicamentos) {
    prescriptionSuggestions.replaceChildren();

    if (!medicamentos.length) {
      const empty = document.createElement('p');
      empty.className = 'prescription-suggestions-empty';
      empty.textContent = 'No se encontraron medicamentos en el catálogo.';
      prescriptionSuggestions.appendChild(empty);
    } else {
      medicamentos.forEach(medicamento => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'prescription-suggestion';
        button.setAttribute('role', 'option');
        button.dataset.medicationId = medicamento.id_medicamento;
        button.dataset.medicationName = medicamento.nombre;
        button.textContent = medicamento.nombre;
        prescriptionSuggestions.appendChild(button);
      });
    }

    prescriptionSuggestions.classList.remove('hidden');
    recetaMedicamento.setAttribute('aria-expanded', 'true');
  }

  async function loadMedicationSuggestions(query) {
    try {
      const response = await fetch(`/medico/api/medicamentos?q=${encodeURIComponent(query)}`);
      if (!response.ok) throw new Error('No se pudo consultar el catálogo.');
      renderMedicationSuggestions(await response.json());
    } catch (error) {
      hideMedicationSuggestions();
      showPrescriptionMessage('No se pudo consultar el catálogo de medicamentos. Inténtalo nuevamente.');
    }
  }

  async function selectMedication(medicamento) {
    selectedMedication = medicamento;
    recetaMedicamento.value = medicamento.nombre;
    recetaMedicamentoId.value = medicamento.id_medicamento;
    hideMedicationSuggestions();
    resetPresentationOptions();
    recetaPresentacion.innerHTML = '<option value="">Cargando presentaciones...</option>';

    try {
      const response = await fetch(`/medico/api/medicamentos/${medicamento.id_medicamento}/presentaciones`);
      if (!response.ok) throw new Error('No se pudieron cargar las presentaciones.');
      medicationPresentations = await response.json();
      recetaPresentacion.innerHTML = '<option value="">Seleccionar presentación</option>';

      medicationPresentations.forEach(presentation => {
        const option = document.createElement('option');
        option.value = presentation.id_presentacion;
        option.textContent = presentation.presentacion;
        recetaPresentacion.appendChild(option);
      });
      recetaPresentacion.disabled = medicationPresentations.length === 0;

      if (!medicationPresentations.length) {
        showPrescriptionMessage('Este medicamento no tiene presentaciones disponibles en el catálogo.', recetaMedicamento);
      } else {
        recetaPresentacion.focus();
        clearPrescriptionMessage();
      }
      updateStepActionState();
    } catch (error) {
      resetPresentationOptions();
      showPrescriptionMessage('No se pudieron cargar las presentaciones. Inténtalo nuevamente.', recetaMedicamento);
    }
  }

  recetaMedicamento.addEventListener('input', () => {
    const query = recetaMedicamento.value.trim();
    selectedMedication = null;
    recetaMedicamentoId.value = '';
    resetPresentationOptions();
    clearPrescriptionMessage();
    updateStepActionState();
    clearTimeout(medicationSearchTimer);

    if (!query) {
      hideMedicationSuggestions();
      return;
    }

    medicationSearchTimer = setTimeout(() => loadMedicationSuggestions(query), 180);
  });

  recetaMedicamento.addEventListener('keydown', event => {
    if (event.key === 'Escape') hideMedicationSuggestions();
  });

  prescriptionSuggestions.addEventListener('click', event => {
    const button = event.target.closest('[data-medication-id]');
    if (!button) return;
    selectMedication({
      id_medicamento: Number(button.dataset.medicationId),
      nombre: button.dataset.medicationName
    });
  });

  recetaPresentacion.addEventListener('change', () => {
    const presentation = medicationPresentations.find(
      item => String(item.id_presentacion) === recetaPresentacion.value
    );
    recetaDosis.value = presentation ? presentation.dosis_habitual : '';
    recetaDosis.disabled = !presentation;
    recetaUnidad.value = presentation ? presentation.unidad_dosis : '';
    recetaUnidadText.textContent = presentation ? presentation.unidad_dosis : 'Unidad';
    recetaFrecuencia.value = '';
    recetaFrecuencia.disabled = !recetaDosis.value.trim();
    if (!recetaFrecuencia.disabled) recetaFrecuencia.focus();
    clearPrescriptionMessage();
    updateStepActionState();
  });

  recetaDosis.addEventListener('input', () => {
    const [integerPart = '', decimalPart = ''] = recetaDosis.value.split('.');
    if (decimalPart.length > 2) {
      recetaDosis.value = `${integerPart}.${decimalPart.slice(0, 2)}`;
    }
    if (Number(recetaDosis.value) > 1000) {
      recetaDosis.value = '';
      recetaFrecuencia.disabled = true;
      recetaFrecuencia.value = '';
      showPrescriptionMessage('La dosis máxima permitida es 1000 por dosis.', recetaDosis);
      updateStepActionState();
      return;
    }
    recetaFrecuencia.disabled = !recetaDosis.value.trim();
    if (recetaFrecuencia.disabled) recetaFrecuencia.value = '';
    clearPrescriptionMessage();
    updateStepActionState();
  });

  [recetaFrecuencia, recetaIndicaciones].forEach(field => {
    field.addEventListener('input', () => {
      clearPrescriptionMessage();
      updateStepActionState();
    });
    field.addEventListener('change', updateStepActionState);
  });

  addPrescriptionItemButton.addEventListener('click', () => {
    if (commitPrescriptionItem(true)) updateStepActionState();
  });

  prescriptionList.addEventListener('click', event => {
    const button = event.target.closest('[data-prescription-action]');
    if (!button) return;
    const index = Number(button.dataset.prescriptionIndex);
    if (!Number.isInteger(index) || !prescriptionItems[index]) return;

    if (button.dataset.prescriptionAction === 'remove') {
      prescriptionItems.splice(index, 1);
      if (editingPrescriptionIndex === index) clearPrescriptionFields();
      renderPrescriptionList();
      serializePrescription();
      updateStepActionState();
      return;
    }

    editingPrescriptionIndex = index;
    setPrescriptionFields(prescriptionItems[index]);
    addPrescriptionItemButton.querySelector('span').textContent = 'Actualizar medicamento';
    recetaMedicamento.focus();
    updateStepActionState();
  });

  [
    diagnosticoInput,
    tratamientoInput,
    recomendacionesInput,
    observacionesInput
  ].forEach(input => {
    input.addEventListener('input', () => {
      clearConsultaMessage();
      updateConsultaPreview();
      updateStepActionState();
    });
  });

  stepButtons.forEach(button => {
    button.addEventListener('click', () => {
      const targetIndex = stepOrder.indexOf(button.dataset.consultaStepTarget);
      if (targetIndex < 0 || targetIndex === currentStepIndex) return;
      if (targetIndex > currentStepIndex && !validateStepBeforeContinue(stepOrder[currentStepIndex])) return;
      const nextIndex = targetIndex > currentStepIndex ? currentStepIndex + 1 : targetIndex;
      showConsultaStep(nextIndex, true);
    });
  });

  prevStepButton.addEventListener('click', () => {
    showConsultaStep(currentStepIndex - 1, true);
  });

  nextStepButton.addEventListener('click', () => {
    if (!validateStepBeforeContinue(stepOrder[currentStepIndex])) return;
    showConsultaStep(currentStepIndex + 1, true);
  });

  saveDraftButton.addEventListener('click', () => {
    if (!validateFilledClinicalFields()) return;

    accionInput.value = 'borrador';

    if (typeof window.openCriticalFormConfirmation === 'function') {
      window.openCriticalFormConfirmation(consultaForm, {
        title: 'Guardar consulta en progreso',
        message: 'La consulta quedará en progreso y no aparecerá como atención completada. Podrás continuarla luego antes de confirmar diagnóstico y receta médica.',
        button: 'Guardar en progreso'
      });
      return;
    }

    consultaForm.submit();
  });

  function updateConfirmConsultaButtonState() {
    const isConfirmed = medicalResponsibilityCheck.checked;
    confirmConsultaButton.disabled = !isConfirmed;
    confirmConsultaButton.setAttribute('aria-disabled', String(!isConfirmed));
  }

  openConfirmModal.addEventListener('click', () => {
    if (!validateRequiredForConfirmation()) return;

    medicalResponsibilityCheck.checked = false;
    updateConfirmConsultaButtonState();
    confirmConsultaModal.classList.remove('hidden');
  });

  medicalResponsibilityCheck.addEventListener('change', () => {
    updateConfirmConsultaButtonState();
  });

  closeConfirmModal.addEventListener('click', () => {
    confirmConsultaModal.classList.add('hidden');
  });

  closeConfirmModalTop.addEventListener('click', () => {
    confirmConsultaModal.classList.add('hidden');
  });

  confirmConsultaModal.addEventListener('click', event => {
    if (event.target === confirmConsultaModal) {
      confirmConsultaModal.classList.add('hidden');
    }
  });

  cancelConsultaButton.addEventListener('click', () => {
    if (!consultaHasChanges()) {
      window.location.href = cancelConsultaButton.dataset.cancelUrl;
      return;
    }

    cancelConsultaModal.classList.remove('hidden');
    closeCancelModal.focus();
  });

  closeCancelModal.addEventListener('click', () => {
    cancelConsultaModal.classList.add('hidden');
    cancelConsultaButton.focus();
  });

  closeCancelModalTop.addEventListener('click', () => {
    cancelConsultaModal.classList.add('hidden');
    cancelConsultaButton.focus();
  });

  cancelConsultaModal.addEventListener('click', event => {
    if (event.target === cancelConsultaModal) {
      cancelConsultaModal.classList.add('hidden');
      cancelConsultaButton.focus();
    }
  });

  confirmCancelConsultaButton.addEventListener('click', () => {
    window.location.href = cancelConsultaButton.dataset.cancelUrl;
  });

  confirmConsultaButton.addEventListener('click', () => {
    if (!medicalResponsibilityCheck.checked) {
      showConsultaMessage('Confirma que revisaste la información clínica antes de completar la consulta.');
      return;
    }

    accionInput.value = 'confirmar';
    consultaForm.submit();
  });

  consultaForm.addEventListener('submit', event => {
    if (!accionInput.value) {
      event.preventDefault();
      showConsultaMessage('Selecciona si deseas guardar en progreso o confirmar la consulta.');
      return;
    }

    if (accionInput.value === 'borrador' && !validateFilledClinicalFields()) {
      event.preventDefault();
      return;
    }

    if (accionInput.value === 'confirmar' && !validateRequiredForConfirmation()) {
      event.preventDefault();
    }
  });

  renderPrescriptionList();
  serializePrescription();
  showConsultaStep(0);
  initialConsultaState = getConsultaState();
</script>
