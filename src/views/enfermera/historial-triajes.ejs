<%
  const estadoHistorial = {
    completada: 'Completada',
    cancelada: 'Cancelada'
  };
%>

<div class="module-card citas-card">
  <div class="module-header">
    <p>Consulta los triajes cerrados por atenciones completadas o citas canceladas.</p>
  </div>

  <form action="/enfermera/historial-triajes" method="GET" class="filter-card js-role-validated-form" novalidate>
    <div class="filter-grid">
      <div class="form-group">
        <label for="q" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-search"></use></svg>
          <span>Buscar</span>
        </label>
        <input
          type="text"
          id="q"
          name="q"
          value="<%= filters.q || '' %>"
          placeholder="Paciente, DNI, médico, síntoma o motivo"
          maxlength="120"
          data-validate="search"
        >
        <span class="field-message" data-for="q"></span>
      </div>

      <div class="form-group">
        <label for="desde" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-calendar"></use></svg>
          <span>Desde</span>
        </label>
        <input type="date" id="desde" name="desde" value="<%= filters.desde || '' %>" data-validate="date">
        <span class="field-message" data-for="desde"></span>
      </div>

      <div class="form-group">
        <label for="hasta" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-calendar"></use></svg>
          <span>Hasta</span>
        </label>
        <input type="date" id="hasta" name="hasta" value="<%= filters.hasta || '' %>" data-validate="date">
        <span class="field-message" data-for="hasta"></span>
      </div>
    </div>

    <div class="filter-actions">
      <a href="/enfermera/historial-triajes" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
        <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/limpiar.png" alt="" aria-hidden="true">
        <span class="visually-hidden">Limpiar filtros</span>
      </a>
      <button type="submit" class="btn-dark icon-action" title="Filtrar" aria-label="Filtrar">
        <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/filtrar.png" alt="" aria-hidden="true">
        <span class="visually-hidden">Filtrar</span>
      </button>
    </div>
  </form>

  <% if (triajes.length === 0) { %>
    <div class="empty-state">
      <h3>No hay triajes en historial</h3>
      <p>Los triajes apareceran aqui cuando la cita se complete o se cancele despues de registrar triaje.</p>
      <div class="empty-actions">
        <a href="/enfermera/triajes" class="btn-dark icon-action" title="Ver triajes activos" aria-label="Ver triajes activos">
          <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/buscar.png" alt="" aria-hidden="true">
          <span class="visually-hidden">Ver triajes activos</span>
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Paciente</th>
            <th>DNI</th>
            <th>Medico</th>
            <th>Especialidad</th>
            <th>Estado</th>
            <th>Accion</th>
          </tr>
        </thead>
        <tbody>
          <% triajes.forEach(triaje => { %>
            <tr>
              <td><%= new Date(triaje.fecha).toLocaleDateString('es-PE') %></td>
              <td><%= triaje.hora %></td>
              <td><strong><%= triaje.paciente_nombres %> <%= triaje.paciente_apellido_paterno %> <%= triaje.paciente_apellido_materno || '' %></strong></td>
              <td><%= triaje.paciente_dni || 'No registrado' %></td>
              <td>Dr(a). <%= triaje.medico_nombres %> <%= triaje.medico_apellido_paterno %></td>
              <td><%= triaje.especialidad %></td>
              <td><span class="status-badge status-<%= triaje.estado %>"><%= estadoHistorial[triaje.estado] || triaje.estado %></span></td>
              <td>
                <a href="/enfermera/triajes/<%= triaje.id_cita %>/detalle?returnTo=historial" class="btn-table-primary icon-action" title="Ver detalle" aria-label="Ver detalle">
                  <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/buscar.png" alt="" aria-hidden="true">
                  <span class="visually-hidden">Ver detalle</span>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="table-pagination">
      <p>Mostrando <strong>1-<%= triajes.length %></strong> de <strong><%= triajes.length %></strong> registros</p>
    </div>
  <% } %>
</div>

<script src="/js/role-validations.js"></script>
