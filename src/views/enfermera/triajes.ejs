<%
  const estadoAtencion = {
    triaje_registrado: 'En espera médica',
    en_consulta: 'En consulta',
    completada: 'Completada',
    cancelada: 'Cancelada'
  };
%>

<div class="module-card citas-card">
  <div class="module-header">
    <p>Consulta los triajes activos registrados por ti antes de que pasen al historial.</p>
  </div>

  <form action="/enfermera/triajes" method="GET" class="filter-card js-role-validated-form" novalidate>
    <% if (filters.estado) { %>
      <input type="hidden" name="estado" value="<%= filters.estado %>">
    <% } %>
    <div class="filter-grid">
      <div class="form-group">
        <label for="q" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-search"></use></svg>
          <span>Buscar</span>
        </label>
        <input
          type="text"
          id="q"
          name="q"
          value="<%= filters.q || '' %>"
          placeholder="Paciente, DNI, médico, síntoma o motivo"
          maxlength="120"
          data-validate="search"
        >
        <span class="field-message" data-for="q"></span>
      </div>

      <div class="form-group">
        <label for="desde" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-calendar"></use></svg>
          <span>Desde</span>
        </label>
        <input type="date" id="desde" name="desde" value="<%= filters.desde || '' %>" data-validate="date">
        <span class="field-message" data-for="desde"></span>
      </div>

      <div class="form-group">
        <label for="hasta" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-calendar"></use></svg>
          <span>Hasta</span>
        </label>
        <input type="date" id="hasta" name="hasta" value="<%= filters.hasta || '' %>" data-validate="date">
        <span class="field-message" data-for="hasta"></span>
      </div>
    </div>

    <div class="filter-actions">
      <a href="/enfermera/triajes" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
        <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/limpiar.png" alt="" aria-hidden="true">
        <span>Limpiar</span>
      </a>
      <button type="submit" class="btn-dark icon-action" title="Buscar" aria-label="Buscar">
        <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/buscar.png" alt="" aria-hidden="true">
        <span>Buscar</span>
      </button>
    </div>
  </form>

  <% if (triajes.length === 0) { %>
    <div class="empty-state">
      <h3>No se encontraron triajes</h3>
      <p>No hay resultados con los filtros seleccionados.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Paciente</th>
            <th>DNI</th>
            <th>Especialidad</th>
            <th>Médico</th>
            <th>Signos vitales</th>
            <th>Estado de atención</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          <% triajes.forEach(triaje => { %>
            <tr>
              <td><%= new Date(triaje.fecha).toLocaleDateString('es-PE') %></td>
              <td><%= triaje.hora %></td>
              <td><strong><%= triaje.paciente_nombres %> <%= triaje.paciente_apellido_paterno %> <%= triaje.paciente_apellido_materno || '' %></strong></td>
              <td><%= triaje.paciente_dni || 'No registrado' %></td>
              <td><%= triaje.especialidad %></td>
              <td>Dr(a). <%= triaje.medico_nombres %> <%= triaje.medico_apellido_paterno %></td>
              <td>T <%= triaje.temperatura %>, PA <%= triaje.presion_arterial %>, FC <%= triaje.frecuencia_cardiaca %>, O2 <%= triaje.saturacion %>%</td>
              <td><span class="status-badge status-<%= triaje.estado %>"><%= estadoAtencion[triaje.estado] || triaje.estado %></span></td>
              <td>
                <div class="table-actions">
                  <a href="/enfermera/triajes/<%= triaje.id_cita %>/detalle" class="btn-table-primary icon-action" title="Ver detalle" aria-label="Ver detalle">
                    <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/ver_triaje.png" alt="" aria-hidden="true">
                    <span class="visually-hidden">Ver detalle</span>
                  </a>
                  <% if (triaje.estado === 'triaje_registrado') { %>
                    <a href="/enfermera/triajes/<%= triaje.id_cita %>/editar" class="btn-table-secondary icon-action" title="Editar triaje" aria-label="Editar triaje">
                      <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/editar.png" alt="" aria-hidden="true">
                      <span class="visually-hidden">Editar</span>
                    </a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="table-pagination">
      <p>Mostrando <strong>1-<%= triajes.length %></strong> de <strong><%= triajes.length %></strong> registros</p>
    </div>
  <% } %>
</div>

<script src="/js/role-validations.js"></script>
