<%
  const esModoDetalle = typeof modoDetalle !== 'undefined' && modoDetalle;
  const esModoEdicion = typeof modoEdicion !== 'undefined' && modoEdicion;
  const triajeSeguro = typeof triaje !== 'undefined' && triaje ? triaje : {};
  const citaSegura = typeof cita !== 'undefined' && cita ? cita : {};
  const actionUrlSeguro = typeof actionUrl !== 'undefined' ? actionUrl : '#';
  const backUrlSeguro = typeof backUrl !== 'undefined' ? backUrl : '/enfermera/triajes';
  const normalizarSintomaGuardadoTriaje = item => ({
    'Congestion nasal': 'Congestión nasal',
    'Nauseas': 'Náuseas',
    'Vomitos': 'Vómitos'
  }[item] || item);
  const sintomasGuardados = triajeSeguro.sintomas ? triajeSeguro.sintomas.split(',').map(item => {
    const sintoma = item.trim();
    return sintoma.startsWith('Otro:') ? sintoma : normalizarSintomaGuardadoTriaje(sintoma);
  }) : [];
  const otroTriajeGuardado = sintomasGuardados.find(item => item.startsWith('Otro:'));
  const sintomasBaseTriaje = sintomasGuardados.map(item => item.startsWith('Otro:') ? 'Otro' : item);
  const gruposTriaje = [
    { titulo: 'Generales', icono: 'bi-person-fill', items: ['Fiebre', 'Malestar general', 'Cansancio', 'Dolor muscular'] },
    { titulo: 'Respiratorios', icono: 'bi-lungs', items: ['Tos', 'Dolor de garganta', 'Congestión nasal', 'Dificultad respiratoria'] },
    { titulo: 'Digestivos', icono: 'bi-capsule', items: ['Dolor abdominal', 'Náuseas', 'Vómitos', 'Diarrea'] },
    { titulo: 'Neurológicos / otros', icono: 'bi-activity', items: ['Dolor de cabeza', 'Mareos', 'Ansiedad', 'Otro'] }
  ];
  const antecedentesClinicos = [
    { etiqueta: 'Alergias', valor: citaSegura.alergias },
    { etiqueta: 'Enfermedades previas', valor: citaSegura.enfermedades_previas },
    { etiqueta: 'Medicación actual', valor: citaSegura.medicacion_actual },
    { etiqueta: 'Cirugías', valor: citaSegura.cirugias },
    { etiqueta: 'Antecedentes familiares', valor: citaSegura.antecedentes_familiares },
    { etiqueta: 'Observaciones', valor: citaSegura.antecedentes_observaciones }
  ].filter(item => item.valor && String(item.valor).trim() !== '');
%>

<div class="module-card triaje-card">
  <div class="module-header">
    <p>
      <% if (esModoDetalle) { %>
        Revisa la información registrada durante el triaje. Los campos se muestran en modo lectura.
      <% } else if (esModoEdicion) { %>
        Actualiza los signos vitales antes de que el médico inicie la consulta.
      <% } else { %>
        Registra signos vitales y síntomas verificados durante el triaje.
      <% } %>
    </p>
  </div>

  <div class="clinical-workspace clinical-workspace-triaje">
    <aside class="clinical-workspace-side" aria-label="Contexto del paciente">
      <div class="clinical-overview">
    <section class="patient-summary clinical-panel clinical-two-column nurse-appointment-summary nurse-context-panel consistent-info-panel consistent-info-direct-panel">
      <h3><i class="bi bi-calendar-check" aria-hidden="true"></i>Datos de la cita</h3>
      <div class="consistent-info-grid">
      <div class="clinical-info-item"><i class="bi bi-person clinical-info-icon" aria-hidden="true" data-clinical-tone="primary"></i><span>Paciente</span><strong><%= citaSegura.paciente_nombres %> <%= citaSegura.paciente_apellido_paterno %> <%= citaSegura.paciente_apellido_materno || '' %></strong></div>
      <div class="clinical-info-item"><i class="bi bi-person-badge clinical-info-icon" aria-hidden="true" data-clinical-tone="neutral"></i><span>DNI</span><strong><%= citaSegura.paciente_dni || 'No registrado' %></strong></div>
      <div class="clinical-info-item"><i class="bi bi-hourglass-split clinical-info-icon" aria-hidden="true" data-clinical-tone="neutral"></i><span>Edad</span><strong><%= citaSegura.paciente_edad !== null ? citaSegura.paciente_edad + ' años' : 'No registrada' %></strong></div>
      <div class="clinical-info-item"><i class="bi bi-person-lines-fill clinical-info-icon" aria-hidden="true" data-clinical-tone="neutral"></i><span>Sexo</span><strong><%= citaSegura.paciente_sexo || 'No registrado' %></strong></div>
      <div class="clinical-info-item"><i class="bi bi-calendar-event clinical-info-icon" aria-hidden="true" data-clinical-tone="primary"></i><span>Fecha y hora</span><strong><%= citaSegura.fecha ? new Date(citaSegura.fecha).toLocaleDateString('es-PE') : 'No registrada' %> - <%= citaSegura.hora || 'Sin hora' %></strong></div>
      <div class="clinical-info-item"><i class="bi bi-stethoscope clinical-info-icon" aria-hidden="true" data-clinical-tone="clinical"></i><span>Especialidad</span><strong><%= citaSegura.especialidad %></strong></div>
      <% if (citaSegura.medico_nombres) { %>
        <div class="clinical-info-item"><i class="bi bi-person-vcard clinical-info-icon" aria-hidden="true" data-clinical-tone="primary"></i><span>Médico</span><strong>Dr(a). <%= citaSegura.medico_nombres %> <%= citaSegura.medico_apellido_paterno %> <%= citaSegura.medico_apellido_materno || '' %></strong></div>
      <% } %>
      <div class="clinical-info-item"><i class="bi bi-chat-left-text clinical-info-icon" aria-hidden="true" data-clinical-tone="neutral"></i><span>Motivo de consulta</span><strong><%= citaSegura.motivo %></strong></div>
      </div>
    </section>

    <section class="triaje-summary clinical-panel clinical-antecedentes-panel nurse-context-panel nurse-antecedentes-panel consistent-info-panel">
      <h3><i class="bi bi-journal-medical" aria-hidden="true"></i>Antecedentes médicos</h3>
      <% if (antecedentesClinicos.length > 0) { %>
        <div class="clinical-note-list clinical-note-grid consistent-info-grid">
          <% antecedentesClinicos.forEach(item => { %>
            <div class="clinical-note-item">
              <span><%= item.etiqueta %></span>
              <strong><%= item.valor %></strong>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="clinical-empty-text">No hay antecedentes médicos registrados.</p>
      <% } %>
    </section>
      </div>
    </aside>

    <div class="clinical-workspace-main">

  <form
    action="<%= actionUrlSeguro %>"
    method="POST"
    class="triaje-form js-role-validated-form <%= esModoDetalle ? 'readonly-clinical-form' : '' %>"
    id="triajeForm"
    data-required-checkbox-name="sintomas[]"
    data-confirm-title="<%= esModoEdicion ? 'Actualizar triaje' : 'Registrar triaje' %>"
    data-confirm="Revisa signos vitales, síntomas verificados y observaciones antes de guardar. Esta información orientará la atención médica posterior."
    data-confirm-button="<%= esModoEdicion ? 'Actualizar triaje' : 'Registrar triaje' %>"
    novalidate
  >
    <div id="triajeMessage" class="step-message hidden"></div>

    <section class="clinical-form-section">
      <div class="clinical-form-section-heading">
        <i class="bi bi-activity" aria-hidden="true"></i>
        <div>
          <h3>Signos vitales</h3>
          <p>Registra los valores medidos antes de derivar al m&eacute;dico.</p>
        </div>
      </div>

    <div class="triaje-grid">
      <div class="form-group">
        <label for="temperatura" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-thermometer"></use></svg>
          <span>Temperatura (°C)</span>
        </label>
        <input type="text" inputmode="decimal" id="temperatura" name="temperatura" value="<%= triajeSeguro.temperatura || '' %>" placeholder="36.8" min="35" max="43" maxlength="4" data-validate="decimal" data-vital="temperature" <%= esModoDetalle ? 'readonly' : 'required' %>>
        <span class="field-message" data-for="temperatura"></span>
      </div>
      <div class="form-group">
        <label for="presion_arterial" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-activity"></use></svg>
          <span>Presión arterial</span>
        </label>
        <input type="text" inputmode="numeric" id="presion_arterial" name="presion_arterial" value="<%= triajeSeguro.presion_arterial || '' %>" placeholder="120/80" maxlength="7" data-validate="blood-pressure" data-systolic-min="50" data-systolic-max="260" data-diastolic-min="30" data-diastolic-max="150" <%= esModoDetalle ? 'readonly' : 'required' %>>
        <span class="field-message" data-for="presion_arterial"></span>
      </div>
      <div class="form-group">
        <label for="frecuencia_cardiaca" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-heart"></use></svg>
          <span>Frecuencia cardíaca</span>
        </label>
        <input type="text" inputmode="numeric" id="frecuencia_cardiaca" name="frecuencia_cardiaca" value="<%= triajeSeguro.frecuencia_cardiaca || '' %>" placeholder="75" min="30" max="220" maxlength="3" data-validate="digits" data-vital="heart-rate" <%= esModoDetalle ? 'readonly' : 'required' %>>
        <span class="field-message" data-for="frecuencia_cardiaca"></span>
      </div>
      <div class="form-group">
        <label for="saturacion" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-activity"></use></svg>
          <span>Saturación O2 (%)</span>
        </label>
        <input type="text" inputmode="numeric" id="saturacion" name="saturacion" value="<%= triajeSeguro.saturacion || '' %>" placeholder="98" min="50" max="100" maxlength="3" data-validate="digits" data-vital="oxygen-saturation" <%= esModoDetalle ? 'readonly' : 'required' %>>
        <span class="field-message" data-for="saturacion"></span>
      </div>
    </div>
    </section>

    <section class="clinical-form-section">
      <div class="clinical-form-section-heading">
        <i class="bi bi-heart-pulse" aria-hidden="true"></i>
        <div>
          <h3>S&iacute;ntomas verificados por enfermer&iacute;a</h3>
          <p>Selecciona los s&iacute;ntomas que el paciente refiere durante el triaje.</p>
        </div>
      </div>

    <div class="form-group">
      <div class="symptom-category-grid symptom-category-grid-four">
        <% gruposTriaje.forEach((grupo, grupoIndex) => { %>
          <fieldset class="symptom-category">
            <legend><i class="bi <%= grupo.icono %>" aria-hidden="true"></i><span><%= grupo.titulo %></span></legend>
            <% grupo.items.forEach((sintoma, sintomaIndex) => { %>
              <label class="checkbox-option" for="triaje_sintoma_<%= grupoIndex %>_<%= sintomaIndex %>">
                <input
                  id="triaje_sintoma_<%= grupoIndex %>_<%= sintomaIndex %>"
                  type="checkbox"
                  name="sintomas[]"
                  value="<%= sintoma %>"
                  <%= sintomasBaseTriaje.includes(sintoma) ? 'checked' : '' %>
                  <%= esModoDetalle ? 'disabled' : '' %>
                >
                <span><%= sintoma === 'Otro' ? 'Otro síntoma' : sintoma %></span>
              </label>
            <% }) %>
          </fieldset>
        <% }) %>
      </div>
      <span class="field-message" data-for="sintomas"></span>

      <div class="form-group symptom-other-field <%= otroTriajeGuardado ? '' : 'hidden' %>" id="triajeOtherSymptomGroup">
        <label for="sintomas_otro" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-note"></use></svg>
          <span>Otro síntoma verificado</span>
        </label>
        <input
          type="text"
          id="sintomas_otro"
          name="sintomas_otro"
          maxlength="120"
          data-validate="clinical-text"
          data-min="5"
          placeholder="Describe el síntoma adicional"
          value="<%= otroTriajeGuardado ? otroTriajeGuardado.replace('Otro:', '').trim() : '' %>"
          <%= esModoDetalle ? 'readonly' : (otroTriajeGuardado ? '' : 'disabled') %>
        >
        <span class="field-message" data-for="sintomas_otro"></span>
      </div>
    </div>
    </section>

    <section class="clinical-form-section">
      <div class="clinical-form-section-heading">
        <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>
        <div>
          <h3>Notas de enfermer&iacute;a</h3>
          <p>A&ntilde;ade datos relevantes para orientar la atenci&oacute;n posterior.</p>
        </div>
      </div>

    <div class="form-group">
      <label for="observaciones" class="field-label-with-icon">
        <svg class="field-icon" aria-hidden="true"><use href="#field-icon-note"></use></svg>
        <span>Observaciones</span>
      </label>
      <textarea id="observaciones" name="observaciones" placeholder="Opcional: paciente llega acompañado, ansioso, requiere prioridad, no colabora con la toma de signos, se deriva a médico." maxlength="800" data-validate="clinical-text" data-min="5" <%= esModoDetalle ? 'readonly' : '' %>><%= triajeSeguro.observaciones || '' %></textarea>
      <span class="field-message" data-for="observaciones"></span>
    </div>
    </section>

    <div class="form-actions">
      <% if (esModoDetalle) { %>
        <a href="<%= backUrlSeguro %>" class="btn-light">Volver</a>
      <% } else { %>
        <a
          href="<%= backUrlSeguro %>"
          class="btn-light js-cancel-triaje"
         data-cancel-message="<%= esModoEdicion ? 'Si cancelas, se perderán los cambios no guardados del triaje.' : 'Si cancelas, no se guardará el triaje de esta cita.' %>"
          title="Cancelar"
          aria-label="Cancelar"
        >
          <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/cancelar.png" alt="" aria-hidden="true">
          <span>Cancelar</span>
        </a>
        <button type="submit" class="btn-dark icon-action" title="<%= esModoEdicion ? 'Actualizar triaje' : 'Guardar triaje' %>" aria-label="<%= esModoEdicion ? 'Actualizar triaje' : 'Guardar triaje' %>">
          <img class="action-metaphor" src="/img/action-metaphors/enfermera/triaje/<%= esModoEdicion ? 'editar.png' : 'guardar.png' %>" alt="" aria-hidden="true">
          <span><%= esModoEdicion ? 'Actualizar triaje' : 'Guardar triaje' %></span>
        </button>
      <% } %>
    </div>
  </form>
    </div>
  </div>
</div>

<div class="modal-overlay hidden" id="cancelTriajeModal" role="dialog" aria-modal="true" aria-labelledby="cancelTriajeTitle" aria-describedby="cancelTriajeText">
  <div class="confirm-modal confirm-modal-polished" data-confirm-action="cancelar">
    <button type="button" class="modal-close confirm-modal-close" id="closeCancelTriajeModalTop" aria-label="Cerrar confirmación">&times;</button>
    <div class="confirm-modal-icon" aria-hidden="true">
      <i class="bi bi-x-lg"></i>
    </div>
    <h3 id="cancelTriajeTitle">Cancelar cambios</h3>
    <p id="cancelTriajeText">¿Deseas salir sin guardar este triaje?</p>
    <small class="confirm-modal-note">Puedes seguir editando si necesitas revisar los signos vitales.</small>
    <div class="modal-actions">
      <button type="button" class="btn-light icon-action" id="closeCancelTriajeModal" title="Seguir editando" aria-label="Seguir editando">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>Seguir editando</span>
      </button>
      <a href="#" class="btn-danger" id="confirmCancelTriaje" title="Salir sin guardar" aria-label="Salir sin guardar">
        <i class="bi bi-x-circle" aria-hidden="true"></i>
        <span>Salir sin guardar</span>
      </a>
    </div>
  </div>
</div>

<script src="/js/role-validations.js"></script>

<script>
  const triajeForm = document.getElementById('triajeForm');
  const triajeMessage = document.getElementById('triajeMessage');
  const temperaturaInput = document.getElementById('temperatura');
  const presionInput = document.getElementById('presion_arterial');
  const frecuenciaInput = document.getElementById('frecuencia_cardiaca');
  const saturacionInput = document.getElementById('saturacion');
  const triajeSymptomChecks = document.querySelectorAll('input[name="sintomas[]"]');
  const otherTriajeGroup = document.getElementById('triajeOtherSymptomGroup');
  const otherTriajeInput = document.getElementById('sintomas_otro');
  const cancelTriajeLink = document.querySelector('.js-cancel-triaje');
  const cancelTriajeModal = document.getElementById('cancelTriajeModal');
  const cancelTriajeText = document.getElementById('cancelTriajeText');
  const closeCancelTriajeModal = document.getElementById('closeCancelTriajeModal');
  const closeCancelTriajeModalTop = document.getElementById('closeCancelTriajeModalTop');
  const confirmCancelTriaje = document.getElementById('confirmCancelTriaje');
  const isTriajeReadOnly = <%= esModoDetalle ? 'true' : 'false' %>;
  const observacionesInput = document.getElementById('observaciones');
  function getTriajeState() {
    return {
      temperatura: temperaturaInput.value,
      presion: presionInput.value,
      frecuencia: frecuenciaInput.value,
      saturacion: saturacionInput.value,
      otro: otherTriajeInput.value,
      observaciones: observacionesInput.value,
      sintomas: Array.from(triajeSymptomChecks).filter(input => input.checked).map(input => input.value).sort().join('|')
    };
  }

  let initialTriajeState;

  function triajeHasChanges() {
    const currentTriajeState = getTriajeState();
    return (
      currentTriajeState.temperatura !== initialTriajeState.temperatura ||
      currentTriajeState.presion !== initialTriajeState.presion ||
      currentTriajeState.frecuencia !== initialTriajeState.frecuencia ||
      currentTriajeState.saturacion !== initialTriajeState.saturacion ||
      currentTriajeState.otro !== initialTriajeState.otro ||
      currentTriajeState.observaciones !== initialTriajeState.observaciones ||
      currentTriajeState.sintomas !== initialTriajeState.sintomas
    );
  }

  function showTriajeMessage(message, field = null) {
    triajeMessage.textContent = '';
    triajeMessage.classList.add('hidden');
    document.querySelectorAll('.field-error').forEach(input => input.classList.remove('field-error'));
    if (field) {
      field.classList.add('field-error');
      field.setAttribute('aria-invalid', 'true');
      const target = triajeForm.querySelector(`.field-message[data-for="${field.id}"]`);
      if (target) {
        target.textContent = message;
        target.classList.add('is-visible');
      }
      field.focus();
    } else {
      const target = triajeForm.querySelector('.field-message[data-for="sintomas"]');
      target.textContent = message;
      target.classList.add('is-visible');
      const firstSymptom = triajeSymptomChecks[0];
      if (firstSymptom) firstSymptom.focus();
    }
  }

  function clearTriajeMessage() {
    triajeMessage.textContent = '';
    triajeMessage.classList.add('hidden');
  }

  function updateOtherTriajeSymptom() {
    const checked = Array.from(triajeSymptomChecks).some(input => input.value === 'Otro' && input.checked);
    otherTriajeGroup.classList.toggle('hidden', !checked);
    otherTriajeInput.disabled = !checked && !isTriajeReadOnly;
    if (!checked && !isTriajeReadOnly) otherTriajeInput.value = '';
  }

  [temperaturaInput, presionInput, frecuenciaInput, saturacionInput, otherTriajeInput].forEach(input => {
    input.addEventListener('input', clearTriajeMessage);
  });
  triajeSymptomChecks.forEach(input => input.addEventListener('change', () => {
    clearTriajeMessage();
    const symptomMessage = triajeForm.querySelector('.field-message[data-for="sintomas"]');
    if (symptomMessage) {
      symptomMessage.textContent = '';
      symptomMessage.classList.remove('is-visible');
    }
    updateOtherTriajeSymptom();
  }));

  if (cancelTriajeLink) {
    cancelTriajeLink.addEventListener('click', event => {
      event.preventDefault();
      if (!triajeHasChanges()) {
        window.location.href = cancelTriajeLink.href;
        return;
      }
      cancelTriajeText.textContent = cancelTriajeLink.dataset.cancelMessage;
      confirmCancelTriaje.href = cancelTriajeLink.href;
      cancelTriajeModal.classList.remove('hidden');
      closeCancelTriajeModal.focus();
    });
  }

  closeCancelTriajeModal.addEventListener('click', () => cancelTriajeModal.classList.add('hidden'));
  closeCancelTriajeModalTop.addEventListener('click', () => cancelTriajeModal.classList.add('hidden'));
  cancelTriajeModal.addEventListener('click', event => {
    if (event.target === cancelTriajeModal) cancelTriajeModal.classList.add('hidden');
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !cancelTriajeModal.classList.contains('hidden')) {
      cancelTriajeModal.classList.add('hidden');
    }
  });

  if (!isTriajeReadOnly) triajeForm.addEventListener('submit', event => {
    const temperatura = Number(temperaturaInput.value);
    const frecuencia = Number(frecuenciaInput.value);
    const saturacion = Number(saturacionInput.value);
    const sintomasSeleccionados = Array.from(triajeSymptomChecks).filter(input => input.checked).map(input => input.value);

    if (!temperaturaInput.value || !/^\d{2}(\.\d)?$/.test(temperaturaInput.value) || temperatura < 35 || temperatura > 43) {
      event.preventDefault();
      showTriajeMessage('Ingresa una temperatura válida entre 35 y 43 °C.', temperaturaInput);
      return;
    }

    if (!/^\d{2,3}\/\d{2,3}$/.test(presionInput.value.trim())) {
      event.preventDefault();
      showTriajeMessage('Ingresa la presión arterial con formato 120/80.', presionInput);
      return;
    }

    const presionMatch = presionInput.value.trim().match(/^(\d{2,3})\/(\d{2,3})$/);
    const sistolica = Number(presionMatch[1]);
    const diastolica = Number(presionMatch[2]);
    if (sistolica < 50 || sistolica > 260 || diastolica < 30 || diastolica > 150) {
      event.preventDefault();
      showTriajeMessage('La presión arterial no está dentro de un rango válido.', presionInput);
      return;
    }

    if (!frecuenciaInput.value || frecuencia < 30 || frecuencia > 220) {
      event.preventDefault();
      showTriajeMessage('Ingresa una frecuencia cardíaca entre 30 y 220.', frecuenciaInput);
      return;
    }

    if (!saturacionInput.value || saturacion < 50 || saturacion > 100) {
      event.preventDefault();
      showTriajeMessage('La saturación debe estar entre 50 y 100.', saturacionInput);
      return;
    }

    if (sintomasSeleccionados.length === 0) {
      event.preventDefault();
      showTriajeMessage('Selecciona al menos un síntoma verificado por enfermería.');
      return;
    }

    if (sintomasSeleccionados.includes('Otro') && !window.RoleValidation.validateField(otherTriajeInput)) {
      event.preventDefault();
      showTriajeMessage('Describe el otro síntoma verificado.', otherTriajeInput);
    }
  });

  updateOtherTriajeSymptom();
  initialTriajeState = getTriajeState();
</script>
