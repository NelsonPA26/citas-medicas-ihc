<div class="module-card historial-card">
  <div class="module-header">
    <p>Consulta tus atenciones medicas completadas.</p>
  </div>

  <form action="/paciente/historial" method="GET" class="filter-card js-patient-validated-form" novalidate>
    <div class="filter-grid">
      <div class="form-group">
        <label for="q">Buscar</label>
        <input
          type="text"
          id="q"
          name="q"
          value="<%= filters.q || '' %>"
          placeholder="Medico, especialidad, motivo o diagnostico"
          maxlength="120"
          data-validate="search"
        >
        <small class="field-message" data-for="q"></small>
      </div>

      <div class="form-group">
        <label for="desde">Desde</label>
        <input type="date" id="desde" name="desde" value="<%= filters.desde || '' %>">
        <small class="field-message" data-for="desde"></small>
      </div>

      <div class="form-group">
        <label for="hasta">Hasta</label>
        <input type="date" id="hasta" name="hasta" value="<%= filters.hasta || '' %>">
        <small class="field-message" data-for="hasta"></small>
      </div>
    </div>

    <div class="filter-actions">
      <a href="/paciente/historial" class="btn-light">Limpiar filtros</a>
      <button type="submit" class="btn-dark">Filtrar</button>
    </div>
  </form>

  <% if (consultas.length === 0) { %>
    <div class="empty-state">
      <h3>No se encontraron consultas</h3>
      <p>No hay resultados con los filtros seleccionados.</p>
      <div class="empty-actions">
        <a href="/paciente/historial" class="btn-light">Limpiar filtros</a>
        <a href="/paciente/reservar-cita" class="btn-dark">Reservar cita</a>
      </div>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Medico</th>
            <th>Especialidad</th>
            <th>Motivo</th>
            <th>Diagnostico</th>
            <th>Accion</th>
          </tr>
        </thead>
        <tbody>
          <% consultas.forEach(consulta => { %>
            <tr>
              <td><%= new Date(consulta.fecha).toLocaleDateString('es-PE') %></td>
              <td><%= consulta.hora %></td>
              <td>Dr(a). <%= consulta.medico_nombres %> <%= consulta.medico_apellido_paterno %></td>
              <td><%= consulta.especialidad %></td>
              <td><strong><%= consulta.motivo %></strong></td>
              <td><%= consulta.diagnostico || 'No registrado' %></td>
              <td>
                <div class="table-actions">
                  <a href="/paciente/historial/<%= consulta.id_consulta %>" class="btn-table-primary">Ver detalle</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="table-pagination">
      <p>Mostrando <strong>1-<%= consultas.length %></strong> de <strong><%= consultas.length %></strong> registros</p>
    </div>
  <% } %>
</div>

<script src="/js/patient-validations.js"></script>
