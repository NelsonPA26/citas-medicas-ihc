<%
  const estadoTexto = {
    pendiente: 'Pendiente',
    triaje_registrado: 'Triaje registrado',
    en_consulta: 'En consulta',
    cancelada: 'Cancelada'
  };
%>

<div class="module-card citas-card">
  <div class="module-header">
    <p>Consulta tus citas activas y canceladas. Las consultas completadas se muestran en Historial medico.</p>
  </div>

  <form action="/paciente/mis-citas" method="GET" class="filter-card js-patient-validated-form" novalidate>
    <div class="filter-grid two-columns">
      <div class="form-group">
        <label for="q">Buscar</label>
        <input
          type="text"
          id="q"
          name="q"
          value="<%= filters.q || '' %>"
          placeholder="Medico, especialidad o motivo"
          maxlength="120"
          data-validate="search"
        >
        <small class="field-message" data-for="q"></small>
      </div>

      <div class="form-group">
        <label for="fecha">Fecha</label>
        <input type="date" id="fecha" name="fecha" value="<%= filters.fecha || '' %>">
        <small class="field-message" data-for="fecha"></small>
      </div>
    </div>

    <div class="filter-actions">
      <a href="/paciente/mis-citas" class="btn-light">Limpiar filtros</a>
      <button type="submit" class="btn-dark">Filtrar</button>
    </div>
  </form>

  <% if (citas.length === 0) { %>
    <div class="empty-state">
      <h3>No se encontraron citas</h3>
      <p>No hay resultados con los filtros seleccionados.</p>
      <div class="empty-actions">
        <a href="/paciente/mis-citas" class="btn-light">Limpiar filtros</a>
      </div>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Medico</th>
            <th>Especialidad</th>
            <th>Motivo</th>
            <th>Estado</th>
            <th>Accion</th>
          </tr>
        </thead>
        <tbody>
          <% citas.forEach(cita => { %>
            <tr>
              <td><%= new Date(cita.fecha).toLocaleDateString('es-PE') %></td>
              <td><%= cita.hora %></td>
              <td>Dr(a). <%= cita.medico_nombres %> <%= cita.medico_apellido_paterno %></td>
              <td><%= cita.especialidad %></td>
              <td><strong><%= cita.motivo %></strong></td>
              <td>
                <span class="status-badge status-<%= cita.estado %>"><%= estadoTexto[cita.estado] || cita.estado %></span>
              </td>
              <td>
                <% if (cita.estado === 'pendiente') { %>
                  <div class="table-actions">
                    <a href="/paciente/mis-citas/<%= cita.id_cita %>/resumen" class="btn-table-secondary">Ver resumen</a>
                    <a href="/paciente/mis-citas/<%= cita.id_cita %>/editar" class="btn-table-primary">Editar</a>
                    <button
                      type="button"
                      class="btn-cancel"
                      data-cancel-url="/paciente/mis-citas/<%= cita.id_cita %>/cancelar"
                      data-cita-info="<%= new Date(cita.fecha).toLocaleDateString('es-PE') %> a las <%= cita.hora %>"
                    >
                      Cancelar
                    </button>
                  </div>
                <% } else { %>
                  <a href="/paciente/mis-citas/<%= cita.id_cita %>/resumen" class="btn-table-primary">Ver resumen</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="table-pagination">
      <p>Mostrando <strong>1-<%= citas.length %></strong> de <strong><%= citas.length %></strong> registros</p>
    </div>
  <% } %>
</div>

<div class="modal-overlay hidden" id="cancelModal">
  <div class="confirm-modal">
    <h3>Cancelar cita</h3>
    <p id="cancelModalText">Estas por cancelar esta cita. Esta accion cambiara su estado a cancelada.</p>
    <div class="modal-actions">
      <button type="button" class="btn-light" id="closeCancelModal">Conservar cita</button>
      <form method="POST" id="cancelForm">
        <button type="submit" class="btn-danger">Si, cancelar</button>
      </form>
    </div>
  </div>
</div>

<script src="/js/patient-validations.js"></script>

<script>
  const cancelButtons = document.querySelectorAll('.btn-cancel');
  const cancelModal = document.getElementById('cancelModal');
  const cancelForm = document.getElementById('cancelForm');
  const closeCancelModal = document.getElementById('closeCancelModal');
  const cancelModalText = document.getElementById('cancelModalText');

  cancelButtons.forEach(button => {
    button.addEventListener('click', () => {
      cancelForm.action = button.dataset.cancelUrl;
      cancelModalText.textContent = `Estas por cancelar la cita programada para ${button.dataset.citaInfo}. Esta accion cambiara su estado a cancelada.`;
      cancelModal.classList.remove('hidden');
    });
  });

  closeCancelModal.addEventListener('click', () => cancelModal.classList.add('hidden'));
  cancelModal.addEventListener('click', event => {
    if (event.target === cancelModal) cancelModal.classList.add('hidden');
  });
</script>
