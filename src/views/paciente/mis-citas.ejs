<%
  const estadoTexto = {
    pendiente: 'Pendiente',
    triaje_registrado: 'Triaje registrado',
    en_consulta: 'En consulta',
    cancelada: 'Cancelada'
  };
%>

<div class="module-card citas-card">
  <div class="module-header">
    <p>Consulta tus citas activas y canceladas. Las consultas completadas se muestran en Historial médico.</p>
  </div>

  <form action="/paciente/mis-citas" method="GET" class="filter-card js-patient-validated-form" novalidate>
    <div class="filter-grid two-columns">
      <div class="form-group">
        <label for="q" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-search"></use></svg>
          <span>Buscar</span>
        </label>
        <input
          type="text"
          id="q"
          name="q"
          value="<%= filters.q || '' %>"
          placeholder="Médico, especialidad o motivo"
          maxlength="120"
          data-validate="search"
        >
        <small class="field-message" data-for="q"></small>
      </div>

      <div class="form-group">
        <label for="fecha" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-calendar"></use></svg>
          <span>Fecha</span>
        </label>
        <input type="date" id="fecha" name="fecha" value="<%= filters.fecha || '' %>">
        <small class="field-message" data-for="fecha"></small>
      </div>
    </div>

    <div class="filter-actions">
      <a href="/paciente/mis-citas" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
        <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/limpiar.png" alt="" aria-hidden="true">
        <span>Limpiar</span>
      </a>
      <button type="submit" class="btn-dark icon-action" title="Buscar" aria-label="Buscar">
        <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/filtrar.png" alt="" aria-hidden="true">
        <span>Buscar</span>
      </button>
    </div>
  </form>

  <% if (citas.length === 0) { %>
    <div class="empty-state">
      <h3>No se encontraron citas</h3>
      <p>No hay resultados con los filtros seleccionados.</p>
      <div class="empty-actions">
        <a href="/paciente/mis-citas" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
          <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/limpiar.png" alt="" aria-hidden="true">
          <span>Limpiar</span>
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Médico</th>
            <th>Especialidad</th>
            <th>Motivo</th>
            <th>Estado</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          <% citas.forEach(cita => { %>
            <tr>
              <td><%= new Date(cita.fecha).toLocaleDateString('es-PE') %></td>
              <td><%= cita.hora %></td>
              <td>Dr(a). <%= cita.medico_nombres %> <%= cita.medico_apellido_paterno %></td>
              <td><%= cita.especialidad %></td>
              <td><strong class="table-text-clip" title="<%= cita.motivo %>"><%= cita.motivo %></strong></td>
              <td>
                <span class="status-badge status-<%= cita.estado %>" title="Ver significado en Ayuda"><%= estadoTexto[cita.estado] || cita.estado %></span>
              </td>
              <td>
                <% if (cita.estado === 'pendiente') { %>
                  <div class="table-actions">
                    <a href="/paciente/mis-citas/<%= cita.id_cita %>/resumen" class="btn-table-secondary icon-action" title="Ver resumen" aria-label="Ver resumen">
                      <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/buscar.png" alt="" aria-hidden="true">
                      <span class="visually-hidden">Ver resumen</span>
                    </a>
                    <a href="/paciente/mis-citas/<%= cita.id_cita %>/editar" class="btn-table-primary icon-action" title="Editar cita" aria-label="Editar cita">
                      <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/editar.png" alt="" aria-hidden="true">
                      <span class="visually-hidden">Editar</span>
                    </a>
                    <button
                      type="button"
                      class="btn-cancel"
                      data-cancel-url="/paciente/mis-citas/<%= cita.id_cita %>/cancelar"
                      data-cita-info="<%= new Date(cita.fecha).toLocaleDateString('es-PE') %> a las <%= cita.hora %>"
                      title="Cancelar cita"
                      aria-label="Cancelar cita"
                    >
                      <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/cancelar.png" alt="" aria-hidden="true">
                      <span>Cancelar</span>
                    </button>
                  </div>
                <% } else { %>
                  <a href="/paciente/mis-citas/<%= cita.id_cita %>/resumen" class="btn-table-primary icon-action" title="Ver resumen" aria-label="Ver resumen">
                    <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/buscar.png" alt="" aria-hidden="true">
                    <span class="visually-hidden">Ver resumen</span>
                  </a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="table-pagination">
      <p>Mostrando <strong>1-<%= citas.length %></strong> de <strong><%= citas.length %></strong> registros</p>
    </div>
  <% } %>
</div>

<div class="modal-overlay hidden" id="cancelModal" role="dialog" aria-modal="true" aria-labelledby="cancelModalTitle" aria-describedby="cancelModalText">
  <div class="confirm-modal confirm-modal-polished" data-confirm-action="cancelar">
    <button type="button" class="modal-close confirm-modal-close" id="closeCancelModalTop" aria-label="Cerrar confirmación">&times;</button>
    <div class="confirm-modal-icon" aria-hidden="true">
      <i class="bi bi-calendar-x"></i>
    </div>
    <h3 id="cancelModalTitle">Cancelar cita</h3>
    <p id="cancelModalText">Estás por cancelar esta cita. Esta acción cambiará su estado a cancelada.</p>
    <small class="confirm-modal-note">La cita no se eliminará, pero quedará marcada como cancelada.</small>
    <div class="modal-actions">
      <button type="button" class="btn-light icon-action" id="closeCancelModal" title="Conservar cita" aria-label="Conservar cita">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>Conservar cita</span>
      </button>
      <form method="POST" id="cancelForm">
        <button type="submit" class="btn-danger" title="Sí, cancelar" aria-label="Sí, cancelar">
          <i class="bi bi-calendar-x" aria-hidden="true"></i>
          <span>Sí, cancelar</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script src="/js/patient-validations.js"></script>

<script>
  const cancelButtons = document.querySelectorAll('.btn-cancel');
  const cancelModal = document.getElementById('cancelModal');
  const cancelForm = document.getElementById('cancelForm');
  const closeCancelModal = document.getElementById('closeCancelModal');
  const closeCancelModalTop = document.getElementById('closeCancelModalTop');
  const cancelModalText = document.getElementById('cancelModalText');

  function closePatientCancelModal() {
    cancelModal.classList.add('hidden');
  }

  cancelButtons.forEach(button => {
    button.addEventListener('click', () => {
      cancelForm.action = button.dataset.cancelUrl;
      cancelModalText.textContent = `Estás por cancelar la cita programada para ${button.dataset.citaInfo}. Esta acción cambiará su estado a cancelada.`;
      cancelModal.classList.remove('hidden');
      closeCancelModal.focus();
    });
  });

  closeCancelModal.addEventListener('click', closePatientCancelModal);
  closeCancelModalTop.addEventListener('click', closePatientCancelModal);
  cancelModal.addEventListener('click', event => {
    if (event.target === cancelModal) closePatientCancelModal();
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !cancelModal.classList.contains('hidden')) closePatientCancelModal();
  });
</script>
