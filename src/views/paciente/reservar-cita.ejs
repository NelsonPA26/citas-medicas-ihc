<%
  const esModoEdicion = typeof modoEdicion !== 'undefined' && modoEdicion;
  const citaSegura = typeof cita !== 'undefined' && cita ? cita : {};
  const especialidadesSeguras = typeof especialidades !== 'undefined' && Array.isArray(especialidades) ? especialidades : [];
  const medicosSeguros = typeof medicos !== 'undefined' && Array.isArray(medicos) ? medicos : [];
  const actionUrlSeguro = typeof actionUrl !== 'undefined' ? actionUrl : (esModoEdicion && citaSegura.id_cita ? `/paciente/mis-citas/${citaSegura.id_cita}/editar` : '/paciente/reservar-cita');
%>

<div class="module-card">
  <div class="module-header">
    <p><%= esModoEdicion ? 'Actualiza los datos de tu reserva mientras sigue pendiente de triaje.' : 'Completa los pasos para reservar una atención médica.' %></p>
  </div>

  <div class="step-indicator step-indicator-labeled" data-current-step="1" aria-label="Progreso de la reserva">
    <span class="step active" data-step-indicator="1">
      <strong>1</strong>
      <small>Especialidad y médico</small>
    </span>
    <span class="step" data-step-indicator="2">
      <strong>2</strong>
      <small>Fecha y motivo</small>
    </span>
    <span class="step" data-step-indicator="3">
      <strong>3</strong>
      <small>Confirmación</small>
    </span>
  </div>

  <form action="<%= actionUrlSeguro %>" method="POST" class="appointment-form js-patient-validated-form" id="appointmentForm" novalidate>
    <div id="stepMessage" class="step-message hidden"></div>

    <section class="appointment-step active" data-step="1">
      <div class="form-group">
        <label for="especialidad" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-stethoscope"></use></svg>
          <span>Seleccionar especialidad</span>
        </label>
        <select id="especialidad" name="especialidad" required>
          <option value="">Seleccione una especialidad</option>
          <% especialidadesSeguras.forEach(especialidad => { %>
            <option value="<%= especialidad %>" <%= esModoEdicion && citaSegura.especialidad === especialidad ? 'selected' : '' %>><%= especialidad %></option>
          <% }) %>
        </select>
        <small class="field-message" data-for="especialidad"></small>
        <small class="form-help">Primero elige la especialidad que necesitas.</small>
      </div>

      <div class="form-group">
        <label for="id_medico" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-user"></use></svg>
          <span>Seleccionar médico</span>
        </label>
        <select id="id_medico" name="id_medico" required <%= esModoEdicion ? '' : 'disabled' %>>
          <option value="">Seleccione un médico</option>
          <% medicosSeguros.forEach(medico => { %>
            <option
              value="<%= medico.id_medico %>"
              data-especialidad="<%= medico.especialidad %>"
              <%= esModoEdicion && Number(citaSegura.id_medico) === Number(medico.id_medico) ? 'selected' : '' %>
            >
              Dr(a). <%= medico.nombres %> <%= medico.apellido_paterno %> - <%= medico.especialidad %>
            </option>
          <% }) %>
        </select>
        <small class="field-message" data-for="id_medico"></small>
        <small class="form-help">Solo se mostrarán médicos de la especialidad seleccionada.</small>
      </div>

      <div class="form-actions">
        <a
          href="<%= esModoEdicion ? '/paciente/mis-citas' : '/paciente/dashboard' %>"
          class="btn-light js-cancel-appointment"
          data-cancel-message="<%= esModoEdicion ? 'Si cancelas, se perderán los cambios no guardados de la reserva.' : 'Si cancelas, no se registrará la cita.' %>"
          title="Cancelar cambios"
          aria-label="Cancelar cambios"
        >
          <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/cancelar.png" alt="" aria-hidden="true">
          <span>Cancelar</span>
        </a>
        <span class="button-tooltip" title="Selecciona una especialidad y un médico para continuar.">
          <button type="button" class="btn-dark" id="nextStep1" disabled title="Selecciona una especialidad y un médico para continuar.">
            Siguiente
          </button>
        </span>
      </div>
    </section>

    <section class="appointment-step" data-step="2">
      <div class="appointment-date-grid">
        <div class="form-group">
          <label for="fecha" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-calendar"></use></svg>
            <span>Seleccionar fecha</span>
          </label>
          <input type="date" id="fecha" name="fecha" value="<%= esModoEdicion ? citaSegura.fecha : '' %>" required>
          <small class="field-message" data-for="fecha"></small>
          <small class="form-help">Solo se permiten fechas de lunes a viernes.</small>
        </div>

        <div class="form-group">
          <label for="hora" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-clock"></use></svg>
            <span>Seleccionar hora disponible</span>
          </label>
          <select id="hora" name="hora" required <%= esModoEdicion ? '' : 'disabled' %>>
            <% if (esModoEdicion) { %>
              <option value="<%= citaSegura.hora || '' %>" selected><%= citaSegura.hora ? citaSegura.hora.substring(0, 5) : 'Sin hora' %></option>
            <% } else { %>
              <option value="">Primero selecciona médico y fecha</option>
            <% } %>
          </select>
          <small class="field-message" data-for="hora"></small>
          <small class="form-help">El sistema muestra solo las horas libres.</small>
        </div>
      </div>

      <div class="form-group">
        <label for="motivo" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-note"></use></svg>
          <span>Motivo de consulta</span>
        </label>
        <textarea
          id="motivo"
          name="motivo"
          placeholder="Ejemplo: dolor de cabeza constante desde hace 3 días."
          minlength="8"
          maxlength="255"
          data-validate="medical-text"
          data-min="8"
          required
        ><%= esModoEdicion ? citaSegura.motivo : '' %></textarea>
        <small class="field-message" data-for="motivo"></small>
        <small class="form-help">Describe el motivo con una frase breve y clara, por ejemplo: dolor abdominal desde ayer.</small>
      </div>

      <div class="notice-box appointment-notice" role="note">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <span>Si presentas síntomas graves, acude a emergencia o comunícate con el personal de salud.</span>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-light" id="backStep2">
          Atrás
        </button>
        <span class="button-tooltip" title="Completa fecha, hora y motivo para continuar.">
          <button type="button" class="btn-dark" id="nextStep2" disabled title="Completa fecha, hora y motivo para continuar.">
            Siguiente
          </button>
        </span>
      </div>
    </section>

    <section class="appointment-step" data-step="3">
      <div class="summary-box consistent-info-panel">
        <h3><i class="bi bi-calendar-check" aria-hidden="true"></i>Resumen de la cita</h3>
        <div class="consistent-info-grid">
          <div class="summary-row"><span>Especialidad:</span><strong id="summaryEspecialidad">-</strong></div>
          <div class="summary-row"><span>Médico:</span><strong id="summaryMedico">-</strong></div>
          <div class="summary-row"><span>Fecha:</span><strong id="summaryFecha">-</strong></div>
          <div class="summary-row"><span>Hora:</span><strong id="summaryHora">-</strong></div>
          <div class="summary-row full-row"><span>Motivo:</span><strong id="summaryMotivo">-</strong></div>
        </div>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-light" id="backStep3">
          Atrás
        </button>
        <button type="submit" class="btn-dark icon-action" title="<%= esModoEdicion ? 'Actualizar reserva' : 'Confirmar cita' %>" aria-label="<%= esModoEdicion ? 'Actualizar reserva' : 'Confirmar cita' %>">
          <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/<%= esModoEdicion ? 'editar.png' : 'confirmar.png' %>" alt="" aria-hidden="true">
          <span><%= esModoEdicion ? 'Actualizar reserva' : 'Confirmar cita' %></span>
        </button>
      </div>
    </section>
  </form>
</div>

<div class="modal-overlay hidden" id="cancelAppointmentModal" role="dialog" aria-modal="true" aria-labelledby="cancelAppointmentTitle" aria-describedby="cancelAppointmentText">
  <div class="confirm-modal confirm-modal-polished" data-confirm-action="cancelar">
    <button type="button" class="modal-close confirm-modal-close" id="closeCancelAppointmentModalTop" aria-label="Cerrar confirmación">&times;</button>
    <div class="confirm-modal-icon" aria-hidden="true">
      <i class="bi bi-x-lg"></i>
    </div>
    <h3 id="cancelAppointmentTitle">Cancelar cambios</h3>
    <p id="cancelAppointmentText">¿Deseas salir sin guardar esta reserva?</p>
    <small class="confirm-modal-note">Puedes volver y revisar los datos antes de salir.</small>
    <div class="modal-actions">
      <button type="button" class="btn-light icon-action" id="closeCancelAppointmentModal" title="Seguir editando" aria-label="Seguir editando">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>Seguir editando</span>
      </button>
      <a href="#" class="btn-danger" id="confirmCancelAppointment" title="Salir sin guardar" aria-label="Salir sin guardar">
        <i class="bi bi-x-circle" aria-hidden="true"></i>
        <span>Salir sin guardar</span>
      </a>
    </div>
  </div>
</div>

<script src="/js/patient-validations.js"></script>

<script>
  const isAppointmentEditMode = <%= esModoEdicion ? 'true' : 'false' %>;
  const citaId = <%- JSON.stringify(esModoEdicion ? Number(citaSegura.id_cita || 0) : null) %>;
  const selectedHora = <%- JSON.stringify(esModoEdicion ? (citaSegura.hora || '') : '') %>;
  const appointmentForm = document.getElementById('appointmentForm');
  const especialidadSelect = document.getElementById('especialidad');
  const medicoSelect = document.getElementById('id_medico');
  const fechaInput = document.getElementById('fecha');
  const horaSelect = document.getElementById('hora');
  const motivoInput = document.getElementById('motivo');
  const steps = document.querySelectorAll('.appointment-step');
  const indicators = document.querySelectorAll('[data-step-indicator]');
  const nextStep1 = document.getElementById('nextStep1');
  const nextStep2 = document.getElementById('nextStep2');
  const backStep2 = document.getElementById('backStep2');
  const backStep3 = document.getElementById('backStep3');
  const summaryEspecialidad = document.getElementById('summaryEspecialidad');
  const summaryMedico = document.getElementById('summaryMedico');
  const summaryFecha = document.getElementById('summaryFecha');
  const summaryHora = document.getElementById('summaryHora');
  const summaryMotivo = document.getElementById('summaryMotivo');
  const stepMessage = document.getElementById('stepMessage');
  const cancelAppointmentLink = document.querySelector('.js-cancel-appointment');
  const cancelAppointmentModal = document.getElementById('cancelAppointmentModal');
  const cancelAppointmentText = document.getElementById('cancelAppointmentText');
  const closeCancelAppointmentModal = document.getElementById('closeCancelAppointmentModal');
  const closeCancelAppointmentModalTop = document.getElementById('closeCancelAppointmentModalTop');
  const confirmCancelAppointment = document.getElementById('confirmCancelAppointment');
  const initialAppointmentState = {
    especialidad: especialidadSelect.value,
    medico: medicoSelect.value,
    fecha: fechaInput.value,
    hora: horaSelect.value,
    motivo: motivoInput.value
  };

  function appointmentHasChanges() {
    return (
      especialidadSelect.value !== initialAppointmentState.especialidad ||
      medicoSelect.value !== initialAppointmentState.medico ||
      fechaInput.value !== initialAppointmentState.fecha ||
      horaSelect.value !== initialAppointmentState.hora ||
      motivoInput.value !== initialAppointmentState.motivo
    );
  }

  [especialidadSelect, medicoSelect, fechaInput, horaSelect, motivoInput].forEach(input => {
    input.addEventListener('input', () => {
      clearInlineMessage();
      updateStep1State();
      updateStep2State();
    });
    input.addEventListener('change', () => {
      clearInlineMessage();
      updateStep1State();
      updateStep2State();
    });
  });

  fechaInput.min = new Date().toISOString().split('T')[0];

  function formatDateForUser(value) {
    if (!value) return '';
    const date = new Date(`${value}T00:00:00`);
    if (Number.isNaN(date.getTime())) return value;
    return date.toLocaleDateString('es-PE', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  function resetHours(message = 'Primero selecciona médico y fecha') {
    horaSelect.value = '';
    horaSelect.disabled = true;
    horaSelect.innerHTML = `<option value="">${message}</option>`;
  }

  function showStep(stepNumber) {
    clearInlineMessage();
    steps.forEach(step => step.classList.toggle('active', step.dataset.step === String(stepNumber)));
    indicators.forEach(indicator => {
      const indicatorStep = Number(indicator.dataset.stepIndicator);
      indicator.classList.toggle('active', indicatorStep === stepNumber);
      indicator.classList.toggle('completed', indicatorStep < stepNumber);
      indicator.setAttribute('aria-current', indicatorStep === stepNumber ? 'step' : 'false');
    });
    const progress = document.querySelector('.step-indicator-labeled');
    if (progress) progress.dataset.currentStep = String(stepNumber);
  }

  function showInlineMessage(message, field = null) {
    stepMessage.textContent = '';
    stepMessage.classList.add('hidden');
    document.querySelectorAll('.field-error').forEach(input => input.classList.remove('field-error'));
    if (field) {
      setAppointmentFieldMessage(field, message);
      field.focus();
    }
  }

  function setAppointmentFieldMessage(field, message = '') {
    const target = appointmentForm.querySelector(`.field-message[data-for="${field.id}"]`);
    field.classList.toggle('field-error', Boolean(message));
    field.setAttribute('aria-invalid', message ? 'true' : 'false');
    if (target) {
      target.textContent = message;
      target.classList.toggle('is-visible', Boolean(message));
    }
  }

  function clearInlineMessage() {
    stepMessage.textContent = '';
    stepMessage.classList.add('hidden');
  }

  function setNextButtonState(button, enabled, message) {
    button.disabled = !enabled;
    button.title = enabled ? 'Puedes continuar.' : message;
    if (button.parentElement && button.parentElement.classList.contains('button-tooltip')) {
      button.parentElement.title = button.title;
    }
  }

  function appointmentDateMessage() {
    if (!fechaInput.value) return '';
    if (fechaInput.validity.rangeUnderflow) return `Selecciona una fecha desde el ${formatDateForUser(fechaInput.min)}.`;

    const fechaSeleccionada = new Date(`${fechaInput.value}T00:00:00`);
    const dia = fechaSeleccionada.getDay();
    if (dia === 0 || dia === 6) return 'Solo puedes reservar citas de lunes a viernes.';

    return '';
  }

  function updateStep1State(showDoctorMessage = false) {
    const hasSpecialty = Boolean(especialidadSelect.value);
    const hasDoctor = Boolean(medicoSelect.value);
    const doctorMessage = document.querySelector('.field-message[data-for="id_medico"]');
    const message = hasSpecialty ? 'Selecciona un médico para continuar.' : 'Selecciona una especialidad para continuar.';

    setNextButtonState(nextStep1, hasSpecialty && hasDoctor, message);

    if (doctorMessage) {
      const visibleMessage = hasSpecialty && !hasDoctor && showDoctorMessage
        ? 'Selecciona un médico disponible para continuar.'
        : '';
      doctorMessage.textContent = visibleMessage;
      doctorMessage.classList.toggle('is-visible', Boolean(visibleMessage));
      medicoSelect.classList.toggle('field-error', Boolean(visibleMessage));
      medicoSelect.setAttribute('aria-invalid', visibleMessage ? 'true' : 'false');
    }
  }

  function updateStep2State() {
    const hasDate = Boolean(fechaInput.value);
    const dateMessage = appointmentDateMessage();
    const hasHour = Boolean(horaSelect.value);
    const hasReason = motivoInput.value.trim().length >= 8;

    if (dateMessage) {
      setAppointmentFieldMessage(fechaInput, dateMessage);
    } else {
      setAppointmentFieldMessage(fechaInput);
    }

    setNextButtonState(
      nextStep2,
      hasDate && !dateMessage && hasHour && hasReason,
      'Completa fecha, hora y motivo para continuar.'
    );
  }

  function closeAppointmentCancelModal() {
    cancelAppointmentModal.classList.add('hidden');
  }

  function filtrarMedicos() {
    const especialidad = especialidadSelect.value;
    if (!especialidad) medicoSelect.value = '';
    medicoSelect.disabled = !especialidad;
    Array.from(medicoSelect.options).forEach(option => {
      if (!option.value) return;
      option.hidden = option.dataset.especialidad !== especialidad;
    });
  }

  especialidadSelect.addEventListener('change', () => {
    filtrarMedicos();
    medicoSelect.value = '';
    resetHours();
    updateStep1State(true);
    updateStep2State();
  });

  async function cargarHorasDisponibles() {
    const idMedico = medicoSelect.value;
    const fecha = fechaInput.value;
    if (!idMedico || !fecha) {
      resetHours();
      updateStep2State();
      return;
    }
    const dateMessage = appointmentDateMessage();
    if (dateMessage) {
      resetHours('Corrige la fecha para ver horarios');
      setAppointmentFieldMessage(fechaInput, dateMessage);
      updateStep2State();
      return;
    }
    setAppointmentFieldMessage(fechaInput);
    setAppointmentFieldMessage(horaSelect);
    horaSelect.disabled = true;
    horaSelect.innerHTML = '<option value="">Cargando horas disponibles...</option>';
    updateStep2State();

    try {
      const params = new URLSearchParams({ id_medico: idMedico, fecha });
      if (isAppointmentEditMode && citaId) params.set('id_cita', citaId);
      const response = await fetch(`/paciente/horas-disponibles?${params.toString()}`);
      const data = await response.json();

      if (!data.ok) {
        horaSelect.innerHTML = `<option value="">${data.mensaje}</option>`;
        setAppointmentFieldMessage(fechaInput, data.mensaje || 'Selecciona una fecha válida de lunes a viernes.');
        updateStep2State();
        return;
      }

      if (data.horas.length === 0) {
        horaSelect.innerHTML = '<option value="">No hay horas disponibles</option>';
        setAppointmentFieldMessage(horaSelect, 'No hay horas disponibles para el médico y la fecha seleccionados.');
        updateStep2State();
        return;
      }

      horaSelect.innerHTML = '<option value="">Seleccione una hora</option>';
      data.horas.forEach(hora => {
        const option = document.createElement('option');
        option.value = hora;
        option.textContent = hora.substring(0, 5);
        if (isAppointmentEditMode && hora === selectedHora) option.selected = true;
        horaSelect.appendChild(option);
      });
      horaSelect.disabled = false;
      updateStep2State();
    } catch (error) {
      horaSelect.innerHTML = '<option value="">Error al cargar horas</option>';
      setAppointmentFieldMessage(horaSelect, 'No se pudieron cargar los horarios. Intenta nuevamente en unos segundos.');
      updateStep2State();
    }
  }

  medicoSelect.addEventListener('change', () => {
    updateStep1State(true);
    cargarHorasDisponibles();
  });
  fechaInput.addEventListener('change', () => {
    const dateMessage = appointmentDateMessage();
    if (dateMessage) {
      setAppointmentFieldMessage(fechaInput, dateMessage);
      resetHours('Corrige la fecha para ver horarios');
      if (fechaInput.value && !fechaInput.validity.rangeUnderflow) fechaInput.value = '';
      setNextButtonState(nextStep2, false, 'Corrige la fecha para continuar.');
      return;
    }
    cargarHorasDisponibles();
  });

  nextStep1.addEventListener('click', () => {
    updateStep1State(true);
    if (!especialidadSelect.value) return showInlineMessage('Selecciona una especialidad para continuar.', especialidadSelect);
    if (!medicoSelect.value) return showInlineMessage('Selecciona un médico disponible para continuar.', medicoSelect);
    showStep(2);
  });

  nextStep2.addEventListener('click', () => {
    updateStep2State();
    if (!fechaInput.value) return showInlineMessage('Selecciona una fecha para la cita.', fechaInput);
    const dateMessage = appointmentDateMessage();
    if (dateMessage) return showInlineMessage(dateMessage, fechaInput);
    if (!horaSelect.value) return showInlineMessage('Selecciona una hora disponible para la cita.', horaSelect);
    if (!window.PatientValidation.validateField(motivoInput)) return showInlineMessage('Revisa el motivo de la consulta.', motivoInput);

    const medicoTexto = medicoSelect.options[medicoSelect.selectedIndex].textContent.trim();
    summaryEspecialidad.textContent = especialidadSelect.value;
    summaryMedico.textContent = medicoTexto;
    summaryFecha.textContent = formatDateForUser(fechaInput.value);
    summaryHora.textContent = horaSelect.value.substring(0, 5);
    summaryMotivo.textContent = motivoInput.value;
    showStep(3);
  });

  backStep2.addEventListener('click', () => showStep(1));
  backStep3.addEventListener('click', () => showStep(2));

  cancelAppointmentLink.addEventListener('click', (event) => {
    event.preventDefault();
    if (!appointmentHasChanges()) {
      window.location.href = cancelAppointmentLink.href;
      return;
    }
    cancelAppointmentText.textContent = cancelAppointmentLink.dataset.cancelMessage;
    confirmCancelAppointment.href = cancelAppointmentLink.href;
    cancelAppointmentModal.classList.remove('hidden');
    closeCancelAppointmentModal.focus();
  });

  closeCancelAppointmentModal.addEventListener('click', closeAppointmentCancelModal);
  closeCancelAppointmentModalTop.addEventListener('click', closeAppointmentCancelModal);
  cancelAppointmentModal.addEventListener('click', event => {
    if (event.target === cancelAppointmentModal) closeAppointmentCancelModal();
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !cancelAppointmentModal.classList.contains('hidden')) closeAppointmentCancelModal();
  });

  filtrarMedicos();
  if (isAppointmentEditMode) cargarHorasDisponibles();
  updateStep1State(false);
  updateStep2State();
</script>
