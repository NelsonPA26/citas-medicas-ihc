<%
  const citasActivas = Number(stats.activas || 0);
  const nextLabel = proximaCita
    ? `${new Date(proximaCita.fecha).toLocaleDateString('es-PE')} - ${proximaCita.hora}`
    : 'No hay próximas disponibles';

  function statusLabel(estado) {
    if (estado === 'pendiente') return 'Pendiente';
    if (estado === 'triaje_registrado') return 'Triaje registrado';
    if (estado === 'en_consulta') return 'En consulta';
    return 'Activa';
  }
%>

<div class="dashboard-grid dashboard-grid-compact">
  <article class="stat-card dashboard-stat-card highlight-card">
    <div class="dashboard-stat-copy">
      <h3>Citas activas</h3>
      <p class="stat-number"><%= citasActivas %></p>
      <p class="dashboard-stat-detail"><%= nextLabel %></p>
    </div>
    <span class="dashboard-stat-icon" aria-hidden="true"><i class="bi bi-calendar-event-fill"></i></span>
  </article>

  <article class="stat-card dashboard-stat-card">
    <div class="dashboard-stat-copy">
      <h3>Citas pendientes</h3>
      <p class="stat-number"><%= stats.pendientes || 0 %></p>
      <p class="dashboard-stat-detail">Reservas por atender</p>
    </div>
    <span class="dashboard-stat-icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
  </article>

  <article class="stat-card dashboard-stat-card">
    <div class="dashboard-stat-copy">
      <h3>Consultas completadas</h3>
      <p class="stat-number"><%= stats.completadas || 0 %></p>
      <p class="dashboard-stat-detail">Disponibles en historial</p>
    </div>
    <span class="dashboard-stat-icon" aria-hidden="true"><i class="bi bi-clipboard2-check-fill"></i></span>
  </article>

  <article class="stat-card dashboard-stat-card">
    <div class="dashboard-stat-copy">
      <h3>Citas canceladas</h3>
      <p class="stat-number"><%= stats.canceladas || 0 %></p>
      <p class="dashboard-stat-detail">Registros conservados</p>
    </div>
    <span class="dashboard-stat-icon" aria-hidden="true"><i class="bi bi-calendar-x-fill"></i></span>
  </article>
</div>

<div class="dashboard-secondary-grid dashboard-secondary-grid-even">
  <section class="dashboard-info-card dashboard-record-card" aria-labelledby="patientNextTitle">
    <div class="dashboard-info-heading">
      <span class="dashboard-info-icon" aria-hidden="true"><i class="bi bi-calendar-week"></i></span>
      <div>
        <h3 id="patientNextTitle">Próximas citas</h3>
        <p>Resumen breve de tus atenciones programadas.</p>
      </div>
    </div>

    <% if (proximasCitas && proximasCitas.length > 0) { %>
      <div class="dashboard-record-list">
        <% proximasCitas.forEach(function(cita) { %>
          <a class="dashboard-record-row" href="/paciente/mis-citas/<%= cita.id_cita %>/resumen?returnTo=dashboard">
            <span class="dashboard-record-icon" aria-hidden="true"><i class="bi bi-calendar-event"></i></span>
            <span class="dashboard-record-copy">
              <strong><%= new Date(cita.fecha).toLocaleDateString('es-PE') %> - <%= cita.hora %></strong>
              <small>Dr(a). <%= cita.medico_nombres %> <%= cita.medico_apellido_paterno %> · <%= cita.especialidad %></small>
            </span>
            <span class="status-badge status-<%= cita.estado %>"><%= statusLabel(cita.estado) %></span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="clinical-empty-text">No hay citas próximas disponibles.</p>
    <% } %>
  </section>

  <section class="dashboard-info-card" aria-labelledby="patientQuickTitle">
    <div class="dashboard-info-heading">
      <span class="dashboard-info-icon" aria-hidden="true"><i class="bi bi-lightning-charge"></i></span>
      <div>
        <h3 id="patientQuickTitle">Accesos rápidos</h3>
        <p>Acciones principales sin repetir formularios dentro del panel.</p>
      </div>
    </div>

    <div class="dashboard-info-list">
      <a href="/paciente/reservar-cita?returnTo=dashboard" class="dashboard-info-row">
        <span><i class="bi bi-calendar-plus" aria-hidden="true"></i>Reservar cita</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </a>
      <a href="/paciente/mis-citas?returnTo=dashboard" class="dashboard-info-row">
        <span><i class="bi bi-calendar3" aria-hidden="true"></i>Mis citas</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </a>
      <a href="/paciente/antecedentes?returnTo=dashboard" class="dashboard-info-row">
        <span><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>Antecedentes médicos</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </a>
    </div>
  </section>
</div>
