<div class="dashboard-grid">
  <div class="stat-card highlight-card">
    <h3>Proxima cita</h3>

    <% if (proximaCita) { %>
      <p>
        <strong><%= new Date(proximaCita.fecha).toLocaleDateString('es-PE') %> - <%= proximaCita.hora %></strong>
      </p>
      <p>
        Dr(a). <%= proximaCita.medico_nombres %> <%= proximaCita.medico_apellido_paterno %>
      </p>
      <p><%= proximaCita.especialidad %></p>
      <span class="status-badge status-<%= proximaCita.estado %>">
        <% if (proximaCita.estado === 'pendiente') { %>
          Pendiente
        <% } else if (proximaCita.estado === 'triaje_registrado') { %>
          Triaje registrado
        <% } else if (proximaCita.estado === 'en_consulta') { %>
          En consulta
        <% } %>
      </span>
    <% } else { %>
      <p>No tienes citas proximas registradas.</p>
      <a href="/paciente/reservar-cita" class="card-link">Reservar cita</a>
    <% } %>
  </div>

  <div class="stat-card">
    <h3>Citas pendientes</h3>
    <p class="stat-number"><%= stats.pendientes || 0 %></p>
    <a href="/paciente/mis-citas" class="card-link">Revisar citas</a>
  </div>

  <div class="stat-card">
    <h3>Consultas completadas</h3>
    <p class="stat-number"><%= stats.completadas || 0 %></p>
    <a href="/paciente/historial" class="card-link">Ver historial</a>
  </div>

  <div class="stat-card">
    <h3>Citas canceladas</h3>
    <p class="stat-number"><%= stats.canceladas || 0 %></p>
    <a href="/paciente/mis-citas" class="card-link">Ver registros</a>
  </div>
</div>
