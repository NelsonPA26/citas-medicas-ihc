<%
  const estadoTexto = {
    pendiente: 'Pendiente',
    triaje_registrado: 'Triaje registrado',
    en_consulta: 'En consulta',
    cancelada: 'Cancelada'
  };

  const mensajeTriajePendiente = cita.estado === 'cancelada'
    ? 'La cita fue cancelada antes de registrar el triaje.'
    : 'El triaje aún no se ha registrado. Se completará antes de la atención médica.';

  const mensajeConsultaPendiente = cita.estado === 'cancelada'
    ? 'La cita fue cancelada; no se registrará una consulta médica.'
    : cita.estado === 'en_consulta'
      ? 'La atención médica está en curso. La información se mostrará cuando el médico finalice la consulta.'
      : cita.estado === 'triaje_registrado'
        ? 'El triaje ya fue registrado. La consulta médica se completará durante la atención del médico.'
        : 'La consulta médica se registrará después del triaje y la atención médica.';
%>

<div class="module-card resumen-cita-card">
  <div class="module-header">
    <p>Revisa la información principal de esta cita.</p>
  </div>

  <div class="clinical-overview patient-history-overview">
    <section class="patient-summary clinical-panel consistent-info-panel consistent-info-direct-panel">
      <h3>Datos de la cita</h3>

      <div class="consistent-info-grid">
      <div>
        <span>Fecha</span>
        <strong><%= new Date(cita.fecha).toLocaleDateString('es-PE') %></strong>
      </div>

      <div>
        <span>Hora</span>
        <strong><%= cita.hora %></strong>
      </div>

      <div>
        <span>Estado</span>
        <strong><span class="status-badge status-<%= cita.estado %>"><%= estadoTexto[cita.estado] || cita.estado %></span></strong>
      </div>

      <div>
        <span>Médico</span>
        <strong>Dr(a). <%= cita.medico_nombres %> <%= cita.medico_apellido_paterno %> <%= cita.medico_apellido_materno || '' %></strong>
      </div>

      <div>
        <span>Especialidad</span>
        <strong><%= cita.especialidad %></strong>
      </div>

      <div>
        <span>Registro</span>
        <strong><%= cita.fecha_creacion ? new Date(cita.fecha_creacion).toLocaleString('es-PE') : 'No registrado' %></strong>
      </div>

      <div class="full-row">
        <span>Motivo de consulta</span>
        <strong><%= cita.motivo %></strong>
      </div>
      </div>

    </section>

    <section class="triaje-summary clinical-panel consistent-info-panel">
      <h3>Triaje registrado</h3>

      <% if (cita.id_triaje) { %>
        <div class="triaje-summary-grid compact-clinical-grid consistent-info-grid">
          <% if (cita.temperatura) { %>
            <div>
              <span>Temperatura</span>
              <strong><%= cita.temperatura %> °C</strong>
            </div>
          <% } %>

          <% if (cita.presion_arterial) { %>
            <div>
              <span>Presión arterial</span>
              <strong><%= cita.presion_arterial %></strong>
            </div>
          <% } %>

          <% if (cita.frecuencia_cardiaca) { %>
            <div>
              <span>Frecuencia cardíaca</span>
              <strong><%= cita.frecuencia_cardiaca %> lpm</strong>
            </div>
          <% } %>

          <% if (cita.saturacion) { %>
            <div>
              <span>Saturación O2</span>
              <strong><%= cita.saturacion %>%</strong>
            </div>
          <% } %>

          <% if (cita.sintomas_triaje) { %>
            <div class="full-row">
              <span>Síntomas verificados</span>
              <strong><%= cita.sintomas_triaje %></strong>
            </div>
          <% } %>

          <% if (cita.triaje_observaciones) { %>
            <div class="full-row">
              <span>Observaciones de enfermería</span>
              <strong><%= cita.triaje_observaciones %></strong>
            </div>
          <% } %>

          <% if (cita.triaje_fecha_registro) { %>
            <div class="full-row">
              <span>Fecha de triaje</span>
              <strong><%= new Date(cita.triaje_fecha_registro).toLocaleString('es-PE') %></strong>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <p class="clinical-empty-text clinical-pending-state" role="status">
          <i class="bi bi-clock-history" aria-hidden="true"></i>
          <span><%= mensajeTriajePendiente %></span>
        </p>
      <% } %>
    </section>
  </div>

  <section class="consulta-detail-section consulta-medica-section detail-info-panel consistent-info-panel appointment-consulta-pending">
    <h3><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>Consulta médica</h3>
    <p class="clinical-empty-text clinical-pending-state" role="status">
      <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>
      <span><%= mensajeConsultaPendiente %></span>
    </p>
  </section>
</div>
