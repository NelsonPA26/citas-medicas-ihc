<%
  function formatDate(value) {
    if (!value) return 'No registrada';

    const date = new Date(`${value}T00:00:00`);
    if (Number.isNaN(date.getTime())) return 'No registrada';

    return date.toLocaleDateString('es-PE', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric'
    });
  }

  function formatPhone(value) {
    const digits = String(value || '').replace(/\D/g, '').slice(0, 9);
    return digits.replace(/(\d{3})(?=\d)/g, '$1 ').trim();
  }

  const profileMetaphorFolder = 'perfil';
  const profileMetaphorExt = 'png';
%>

<div class="module-card profile-card">
  <div class="module-header">
    <p>Consulta tus datos personales, actualiza tu información de contacto y cambia tu contraseña.</p>
  </div>

  <div class="profile-grid">
    <section class="profile-section">
      <h3>Datos personales</h3>

      <div class="profile-info">
        <div>
          <span>Nombres</span>
          <strong><%= profile.nombres %></strong>
        </div>

        <div>
          <span>Apellidos</span>
          <strong>
            <%= profile.apellido_paterno %>
            <%= profile.apellido_materno || '' %>
          </strong>
        </div>

        <div>
          <span>DNI</span>
          <strong><%= profile.dni || 'No registrado' %></strong>
        </div>

        <div>
          <span>Fecha de nacimiento</span>
          <strong><%= formatDate(profile.fecha_nacimiento) %></strong>
        </div>

        <div>
          <span>Sexo</span>
          <strong><%= profile.sexo || 'No registrado' %></strong>
        </div>

        <div>
          <span>Rol</span>
          <strong class="capitalize"><%= profile.rol %></strong>
        </div>
      </div>
    </section>

    <section class="profile-section">
      <h3>Información editable</h3>
      <p class="section-help">Puedes actualizar estos datos cuando sea necesario.</p>

      <form action="/perfil/actualizar" method="POST" class="profile-form js-role-validated-form" id="profileForm" novalidate>
        <div class="profile-form-grid">
          <div class="form-group">
            <label for="correo" class="field-label-with-icon">
              <svg class="field-icon" aria-hidden="true"><use href="#field-icon-mail"></use></svg>
              <span>Correo electrónico</span>
            </label>
            <input
              type="email"
              id="correo"
              name="correo"
              value="<%= profile.correo || '' %>"
              placeholder="usuario@unt.edu.pe"
              maxlength="120"
              data-validate="email"
              required
            >
            <span class="field-message" data-for="correo"></span>
          </div>

          <div class="form-group">
            <label for="telefono" class="field-label-with-icon">
              <svg class="field-icon" aria-hidden="true"><use href="#field-icon-phone"></use></svg>
              <span>Teléfono</span>
            </label>
            <input
              type="text"
              inputmode="numeric"
              id="telefono"
              name="telefono"
              value="<%= formatPhone(profile.telefono) %>"
              placeholder="987 654 321"
              maxlength="11"
              data-validate="phone-pe"
              autocomplete="tel"
              required
            >
            <span class="field-message" data-for="telefono"></span>
          </div>

          <div class="form-group">
            <label for="fecha_nacimiento" class="field-label-with-icon">
              <svg class="field-icon" aria-hidden="true"><use href="#field-icon-calendar"></use></svg>
              <span>Fecha de nacimiento</span>
            </label>
            <input
              type="date"
              id="fecha_nacimiento"
              name="fecha_nacimiento"
              value="<%= profile.fecha_nacimiento || '' %>"
              data-validate="date-not-future"
              required
            >
            <span class="field-message" data-for="fecha_nacimiento"></span>
          </div>

          <div class="form-group">
            <label for="sexo" class="field-label-with-icon">
              <svg class="field-icon" aria-hidden="true"><use href="#field-icon-user"></use></svg>
              <span>Sexo</span>
            </label>
            <select id="sexo" name="sexo" data-validate="select" required>
              <option value="">Seleccione una opción</option>
              <option value="Masculino" <%= profile.sexo === 'Masculino' ? 'selected' : '' %>>Masculino</option>
              <option value="Femenino" <%= profile.sexo === 'Femenino' ? 'selected' : '' %>>Femenino</option>
              <option value="Otro" <%= profile.sexo === 'Otro' ? 'selected' : '' %>>Otro</option>
              <option value="No especifica" <%= profile.sexo === 'No especifica' ? 'selected' : '' %>>No especifica</option>
            </select>
            <span class="field-message" data-for="sexo"></span>
          </div>

          <div class="form-group profile-half-field">
            <label for="direccion" class="field-label-with-icon">
              <svg class="field-icon" aria-hidden="true"><use href="#field-icon-home"></use></svg>
              <span>Dirección</span>
            </label>
            <input
              type="text"
              id="direccion"
              name="direccion"
              value="<%= profile.direccion || '' %>"
              placeholder="Av. ejemplo 123"
              maxlength="160"
              data-validate="address"
            >
            <span class="field-message" data-for="direccion"></span>
          </div>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-light" id="resetProfileForm" title="Cancelar cambios" aria-label="Cancelar cambios">
            <img class="action-metaphor" src="/img/action-metaphors/<%= profileMetaphorFolder %>/cancelar.<%= profileMetaphorExt %>" alt="" aria-hidden="true">
            <span>Cancelar cambios</span>
          </button>
          <button type="submit" class="btn-dark icon-action" title="Guardar cambios" aria-label="Guardar cambios">
            <img class="action-metaphor" src="/img/action-metaphors/<%= profileMetaphorFolder %>/guardar.<%= profileMetaphorExt %>" alt="" aria-hidden="true">
            <span class="visually-hidden">Guardar cambios</span>
          </button>
        </div>
      </form>
    </section>
  </div>

  <div class="profile-grid profile-grid-secondary">
    <section class="profile-section profile-role-section">
      <h3>Datos según rol</h3>
      <p class="section-help">Estos datos son administrados por el personal autorizado.</p>

      <div class="profile-info profile-role-info">
        <% if (profile.rol === 'paciente') { %>
          <div>
            <span>Código de estudiante</span>
            <strong><%= extra && extra.codigo_estudiante ? extra.codigo_estudiante : 'No registrado' %></strong>
          </div>

          <div>
            <span>Escuela</span>
            <strong><%= extra && extra.escuela ? extra.escuela : 'No registrado' %></strong>
          </div>

          <div>
            <span>Facultad</span>
            <strong><%= extra && extra.facultad ? extra.facultad : 'No registrado' %></strong>
          </div>

          <div>
            <span>Contexto universitario</span>
            <strong><%= extra && extra.contexto_universitario ? extra.contexto_universitario : 'No registrado' %></strong>
          </div>
        <% } %>

        <% if (profile.rol === 'medico') { %>
          <div>
            <span>Especialidad</span>
            <strong><%= extra && extra.especialidad ? extra.especialidad : 'No registrado' %></strong>
          </div>

          <div>
            <span>N.º de colegiatura</span>
            <strong><%= extra && extra.numero_colegiatura ? extra.numero_colegiatura : 'No registrado' %></strong>
          </div>

          <div>
            <span>Turno</span>
            <strong><%= extra && extra.turno ? extra.turno : 'No registrado' %></strong>
          </div>
        <% } %>

        <% if (profile.rol === 'enfermera') { %>
          <div>
            <span>Área</span>
            <strong><%= extra && extra.area ? extra.area : 'No registrado' %></strong>
          </div>

          <div>
            <span>Turno</span>
            <strong><%= extra && extra.turno ? extra.turno : 'No registrado' %></strong>
          </div>
        <% } %>

        <% if (profile.rol === 'administrativo') { %>
          <div>
            <span>Cargo</span>
            <strong><%= extra && extra.cargo ? extra.cargo : 'No registrado' %></strong>
          </div>

          <div>
            <span>Anexo</span>
            <strong><%= extra && extra.anexo ? extra.anexo : 'No registrado' %></strong>
          </div>
        <% } %>
      </div>
    </section>

    <section class="profile-section profile-security-form">
      <div class="profile-section-heading">
        <h3>Actualizar contraseña</h3>
      </div>

      <p class="section-help">Usa una contraseña fuerte para proteger las funciones administrativas del sistema.</p>

      <form action="/perfil/cambiar-password" method="POST" class="profile-form js-role-validated-form" id="passwordForm" novalidate>
        <div class="profile-form-grid">
          <div class="form-group">
            <label for="current_password" class="field-label-with-icon">
              <svg class="field-icon" aria-hidden="true"><use href="#field-icon-lock"></use></svg>
              <span>Contraseña actual</span>
            </label>
            <input
              type="password"
              id="current_password"
              name="current_password"
              minlength="6"
              data-validate="password"
              required
            >
            <span class="field-message" data-for="current_password"></span>
          </div>

          <div class="form-group">
            <label for="new_password" class="field-label-with-icon">
              <svg class="field-icon" aria-hidden="true"><use href="#field-icon-lock"></use></svg>
              <span>Nueva contraseña</span>
            </label>
            <input
              type="password"
              id="new_password"
              name="new_password"
              minlength="8"
              data-validate="strong-password"
              required
            >
            <small class="form-help">Mínimo 8 caracteres, mayúscula, minúscula, número y símbolo.</small>
            <div class="password-strength" aria-live="polite">
              <span></span>
              <p>Seguridad: sin evaluar</p>
            </div>
            <span class="field-message" data-for="new_password"></span>
          </div>

          <div class="form-group profile-half-field">
            <label for="confirm_password" class="field-label-with-icon">
              <svg class="field-icon" aria-hidden="true"><use href="#field-icon-lock"></use></svg>
              <span>Confirmar nueva contraseña</span>
            </label>
            <input
              type="password"
              id="confirm_password"
              name="confirm_password"
              minlength="8"
              data-validate="password-confirm"
              data-match="new_password"
              required
            >
            <span class="field-message" data-for="confirm_password"></span>
          </div>
        </div>

        <div class="form-actions">
          <button type="reset" class="btn-light" title="Cancelar cambios" aria-label="Cancelar cambios">
            <img class="action-metaphor" src="/img/action-metaphors/<%= profileMetaphorFolder %>/cancelar.<%= profileMetaphorExt %>" alt="" aria-hidden="true">
            <span>Cancelar cambios</span>
          </button>
          <button type="submit" class="btn-dark password-update-action" title="Actualizar contraseña" aria-label="Actualizar contraseña">
            <span class="button-symbol" aria-hidden="true">🔒</span>
            <span>Actualizar contraseña</span>
          </button>
        </div>
      </form>
    </section>
  </div>
</div>

<script src="/js/role-validations.js"></script>

<script>
  const fechaNacimientoInput = document.getElementById('fecha_nacimiento');
  const profileForm = document.getElementById('profileForm');
  const resetProfileForm = document.getElementById('resetProfileForm');
  const newPassword = document.getElementById('new_password');
  const strengthBox = document.querySelector('.password-strength');

  function yesterdayISO() {
    const date = new Date();
    date.setDate(date.getDate() - 1);
    return date.toISOString().split('T')[0];
  }

  if (fechaNacimientoInput) {
    fechaNacimientoInput.max = yesterdayISO();
  }

  if (resetProfileForm && profileForm) {
    resetProfileForm.addEventListener('click', () => {
      profileForm.reset();
      profileForm.querySelectorAll('.field-error').forEach(field => {
        field.classList.remove('field-error');
        field.setAttribute('aria-invalid', 'false');
      });
      profileForm.querySelectorAll('.field-message').forEach(message => {
        message.textContent = '';
        message.classList.remove('is-visible');
      });
    });
  }

  function passwordScore(value) {
    return [
      value.length >= 8,
      /[A-Z]/.test(value),
      /[a-z]/.test(value),
      /\d/.test(value),
      /[^A-Za-z0-9]/.test(value)
    ].filter(Boolean).length;
  }

  function updateStrength() {
    if (!newPassword || !strengthBox) return;

    const score = passwordScore(newPassword.value);
    const labels = ['sin evaluar', 'muy débil', 'débil', 'media', 'buena', 'fuerte'];
    const state = score >= 5 ? 'strong' : score >= 4 ? 'good' : score >= 3 ? 'medium' : 'weak';

    strengthBox.dataset.strength = newPassword.value ? state : 'empty';
    strengthBox.querySelector('p').textContent = `Seguridad: ${newPassword.value ? labels[score] : labels[0]}`;
  }

  if (newPassword) {
    newPassword.addEventListener('input', updateStrength);
    updateStrength();
  }
</script>
