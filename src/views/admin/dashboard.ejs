<div class="dashboard-grid">
  <div class="stat-card highlight-card">
    <h3>Usuarios registrados</h3>
    <p class="stat-number"><%= stats.usuarios || 0 %></p>
    <a href="/admin/usuarios" class="card-link">Gestionar usuarios</a>
  </div>

  <div class="stat-card">
    <h3>Citas registradas</h3>
    <p class="stat-number"><%= stats.citas || 0 %></p>
    <a href="/admin/citas" class="card-link">Ver citas</a>
  </div>

  <div class="stat-card">
    <h3>Médicos</h3>
    <p class="stat-number"><%= stats.medicos || 0 %></p>
    <a href="/admin/usuarios?rol=medico" class="card-link">Ver en usuarios</a>
  </div>

  <div class="stat-card">
    <h3>Enfermeras</h3>
    <p class="stat-number"><%= stats.enfermeras || 0 %></p>
    <a href="/admin/usuarios?rol=enfermera" class="card-link">Ver en usuarios</a>
  </div>

  <div class="stat-card">
    <h3>Citas pendientes</h3>
    <p class="stat-number"><%= stats.citas_pendientes || 0 %></p>
  </div>

  <div class="stat-card">
    <h3>Citas completadas</h3>
    <p class="stat-number"><%= stats.citas_completadas || 0 %></p>
  </div>
</div>
