<%
  const personalAsistencial = Number(stats.medicos || 0) + Number(stats.enfermeras || 0);
  const roleLabel = {
    paciente: 'Paciente',
    medico: 'Doctor',
    enfermera: 'Enfermera',
    administrativo: 'Administrador'
  };

  function userInitials(usuario) {
    const first = (usuario.nombres || '').trim().charAt(0);
    const last = (usuario.apellido_paterno || '').trim().charAt(0);
    return `${first}${last}`.toUpperCase() || 'US';
  }

  function formatRecentDate(value) {
    if (!value) return 'No registrada';
    return new Date(value).toLocaleDateString('es-PE');
  }
%>

<div class="dashboard-grid dashboard-grid-compact">
  <article class="stat-card dashboard-stat-card highlight-card">
    <div class="dashboard-stat-copy">
      <h3>Usuarios registrados</h3>
      <p class="stat-number"><%= stats.usuarios || 0 %></p>
      <p class="dashboard-stat-detail"><%= personalAsistencial %> usuarios asistenciales</p>
    </div>
    <span class="dashboard-stat-icon" aria-hidden="true"><i class="bi bi-people-fill"></i></span>
  </article>

  <article class="stat-card dashboard-stat-card">
    <div class="dashboard-stat-copy">
      <h3>Citas registradas</h3>
      <p class="stat-number"><%= stats.citas || 0 %></p>
      <p class="dashboard-stat-detail"><%= stats.citas_pendientes || 0 %> pendientes</p>
    </div>
    <span class="dashboard-stat-icon" aria-hidden="true"><i class="bi bi-calendar3"></i></span>
  </article>

  <article class="stat-card dashboard-stat-card">
    <div class="dashboard-stat-copy">
      <h3>Citas pendientes</h3>
      <p class="stat-number"><%= stats.citas_pendientes || 0 %></p>
      <p class="dashboard-stat-detail">Requieren seguimiento</p>
    </div>
    <span class="dashboard-stat-icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
  </article>

  <article class="stat-card dashboard-stat-card">
    <div class="dashboard-stat-copy">
      <h3>Citas completadas</h3>
      <p class="stat-number"><%= stats.citas_completadas || 0 %></p>
      <p class="dashboard-stat-detail">Atenciones cerradas</p>
    </div>
    <span class="dashboard-stat-icon" aria-hidden="true"><i class="bi bi-calendar-check-fill"></i></span>
  </article>
</div>

<div class="dashboard-secondary-grid dashboard-secondary-grid-admin">
  <section class="admin-recent-users-card" aria-labelledby="recentUsersTitle">
    <div class="admin-recent-users-heading">
      <span class="admin-recent-users-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
      <div>
        <h3 id="recentUsersTitle">Usuarios recientes</h3>
        <p>Últimos registros creados en el sistema</p>
      </div>
    </div>

    <% if (recentUsers && recentUsers.length > 0) { %>
      <div class="admin-recent-users-table admin-recent-users-list" aria-label="Usuarios recientes">
        <% recentUsers.forEach(function(usuario, index) { %>
          <a class="admin-recent-users-row" href="/admin/usuarios/<%= usuario.id_usuario %>/editar?returnTo=dashboard">
            <span class="admin-recent-user-name">
              <span class="admin-recent-avatar admin-recent-avatar-<%= index % 5 %>" aria-hidden="true"><%= userInitials(usuario) %></span>
              <span class="admin-recent-user-copy">
                <strong><%= usuario.nombres %> <%= usuario.apellido_paterno %> <%= usuario.apellido_materno || '' %></strong>
                <small><%= roleLabel[usuario.rol] || usuario.rol %></small>
              </span>
            </span>
            <time class="admin-recent-date" datetime="<%= usuario.fecha_creacion ? new Date(usuario.fecha_creacion).toISOString().slice(0, 10) : '' %>"><%= formatRecentDate(usuario.fecha_creacion) %></time>
            <span class="admin-recent-open" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
          </a>
        <% }) %>
      </div>

      <a class="admin-recent-users-all" href="/admin/usuarios?returnTo=dashboard">
        <span>Ver gestión completa</span>
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
    <% } else { %>
      <p class="clinical-empty-text">No hay usuarios recientes disponibles.</p>
    <% } %>
  </section>

  <section class="dashboard-info-card" aria-labelledby="adminQuickTitle">
    <div class="dashboard-info-heading">
      <span class="dashboard-info-icon" aria-hidden="true"><i class="bi bi-lightning-charge"></i></span>
      <div>
        <h3 id="adminQuickTitle">Accesos rápidos</h3>
        <p>Entradas directas a tareas frecuentes, sin duplicar formularios.</p>
      </div>
    </div>

    <div class="dashboard-info-list">
      <a href="/admin/usuarios?returnTo=dashboard" class="dashboard-info-row">
        <span><i class="bi bi-people" aria-hidden="true"></i>Usuarios</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </a>
      <a href="/admin/usuarios/nuevo?returnTo=dashboard" class="dashboard-info-row">
        <span><i class="bi bi-person-plus" aria-hidden="true"></i>Registrar usuario</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </a>
      <a href="/admin/citas?returnTo=dashboard" class="dashboard-info-row">
        <span><i class="bi bi-calendar3" aria-hidden="true"></i>Citas</span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </a>
    </div>
  </section>
</div>
