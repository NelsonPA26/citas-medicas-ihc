<div class="module-card citas-card">
  <div class="module-header">
    <p>Supervisa el estado de las citas médicas registradas en el sistema.</p>
  </div>

  <form action="/admin/citas" method="GET" class="filter-card">
    <div class="filter-grid">
        <div class="form-group">
        <label for="q">Buscar</label>
        <input
            type="text"
            id="q"
            name="q"
            value="<%= filters.q || '' %>"
            placeholder="Paciente, DNI, médico o motivo"
        >
        </div>

        <div class="form-group">
        <label for="estado">Estado</label>
        <select id="estado" name="estado">
            <option value="">Todos</option>
            <option value="pendiente" <%= filters.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
            <option value="triaje_registrado" <%= filters.estado === 'triaje_registrado' ? 'selected' : '' %>>Triaje registrado</option>
            <option value="completada" <%= filters.estado === 'completada' ? 'selected' : '' %>>Completada</option>
            <option value="cancelada" <%= filters.estado === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
        </select>
        </div>

        <div class="form-group">
        <label for="fecha">Fecha</label>
        <input
            type="date"
            id="fecha"
            name="fecha"
            value="<%= filters.fecha || '' %>"
        >
        </div>
    </div>

    <div class="filter-actions">
        <a href="/admin/citas" class="btn-light">Limpiar filtros</a>
        <button type="submit" class="btn-dark">Filtrar</button>
    </div>
    </form>

  <% if (citas.length === 0) { %>
    <div class="empty-state">
    <h3>No se encontraron citas</h3>
    <p>No hay resultados con los filtros seleccionados.</p>
    <a href="/admin/citas" class="btn-dark">Limpiar filtros</a>
    </div>
  <% } else { %>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Paciente</th>
            <th>Médico</th>
            <th>Especialidad</th>
            <th>Motivo</th>
            <th>Estado</th>
            <th>Flujo</th>
          </tr>
        </thead>

        <tbody>
          <% citas.forEach(cita => { %>
            <tr>
              <td><%= new Date(cita.fecha).toLocaleDateString('es-PE') %></td>
              <td><%= cita.hora %></td>

              <td>
                <strong>
                  <%= cita.paciente_nombres %>
                  <%= cita.paciente_apellido_paterno %>
                  <%= cita.paciente_apellido_materno || '' %>
                </strong>
                <br>
                <span class="text-muted">DNI: <%= cita.paciente_dni || 'No registrado' %></span>
              </td>

              <td>
                Dr(a). <%= cita.medico_nombres %>
                <%= cita.medico_apellido_paterno %>
                <%= cita.medico_apellido_materno || '' %>
              </td>

              <td><%= cita.especialidad %></td>
              <td><%= cita.motivo %></td>

              <td>
                <% if (cita.estado === 'pendiente') { %>
                  <span class="status-badge status-pendiente">Pendiente</span>
                <% } else if (cita.estado === 'triaje_registrado') { %>
                  <span class="status-badge status-triaje_registrado">Triaje registrado</span>
                <% } else if (cita.estado === 'completada') { %>
                  <span class="status-badge status-completada">Completada</span>
                <% } else if (cita.estado === 'cancelada') { %>
                  <span class="status-badge status-cancelada">Cancelada</span>
                <% } %>
              </td>

              <td>
                <div class="flow-status">
                  <span class="<%= cita.estado !== 'cancelada' ? 'flow-done' : 'flow-muted' %>">Cita</span>

                  <span class="<%= cita.id_triaje ? 'flow-done' : 'flow-muted' %>">Triaje</span>

                  <% if (cita.id_consulta && cita.borrador === 1) { %>
                    <span class="flow-warning">Borrador</span>
                  <% } else if (cita.id_consulta && cita.borrador === 0) { %>
                    <span class="flow-done">Consulta</span>
                  <% } else { %>
                    <span class="flow-muted">Consulta</span>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  <% } %>
</div>