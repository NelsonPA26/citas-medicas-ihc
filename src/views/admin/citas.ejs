<div class="module-card citas-card">
  <div class="module-header">
    <p>Supervisa el estado de las citas médicas registradas en el sistema.</p>
  </div>

  <form action="/admin/citas" method="GET" class="filter-card js-role-validated-form" novalidate>
    <div class="filter-grid">
      <div class="form-group">
        <label for="q" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-search"></use></svg>
          <span>Buscar</span>
        </label>
       <input
        type="text"
        id="q"
        name="q"
        value="<%= filters.q || '' %>"
        placeholder="Paciente, médico o motivo"
        maxlength="120"
        data-validate="search"
      >
      <span class="field-message" data-for="q"></span>
      </div>

      <div class="form-group">
        <label for="estado" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-activity"></use></svg>
          <span>Estado</span>
        </label>
        <select id="estado" name="estado">
          <option value="">Todos</option>
          <option value="pendiente" <%= filters.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
          <option value="triaje_registrado" <%= filters.estado === 'triaje_registrado' ? 'selected' : '' %>>Triaje registrado</option>
          <option value="en_consulta" <%= filters.estado === 'en_consulta' ? 'selected' : '' %>>En consulta</option>
          <option value="completada" <%= filters.estado === 'completada' ? 'selected' : '' %>>Completada</option>
          <option value="cancelada" <%= filters.estado === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
        </select>
      </div>

      <div class="form-group">
        <label for="fecha" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-calendar"></use></svg>
          <span>Fecha</span>
        </label>
        <input type="date" id="fecha" name="fecha" value="<%= filters.fecha || '' %>">
      </div>
    </div>

    <div class="filter-actions">
      <a href="/admin/citas" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
        <img class="action-metaphor" src="/img/action-metaphors/administrador/citas/limpiar.png" alt="" aria-hidden="true">
        <span>Limpiar</span>
      </a>
      <button type="submit" class="btn-dark icon-action" title="Buscar" aria-label="Buscar">
        <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/buscar.png" alt="" aria-hidden="true">
        <span>Buscar</span>
      </button>
    </div>
  </form>

  <% if (citas.length === 0) { %>
    <div class="empty-state">
      <h3>No se encontraron citas</h3>
      <p>No hay resultados con los filtros seleccionados.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Paciente</th>
            <th>Médico</th>
            <th>Especialidad</th>
            <th>Motivo</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% citas.forEach(cita => { %>
            <tr>
              <td><%= new Date(cita.fecha).toLocaleDateString('es-PE') %></td>
              <td><%= cita.hora %></td>
              <td>
                <strong><%= cita.paciente_nombres %> <%= cita.paciente_apellido_paterno %> <%= cita.paciente_apellido_materno || '' %></strong>
              </td>
              <td>Dr(a). <%= cita.medico_nombres %> <%= cita.medico_apellido_paterno %> <%= cita.medico_apellido_materno || '' %></td>
              <td><%= cita.especialidad %></td>
              <td><strong class="table-text-clip" title="<%= cita.motivo %>"><%= cita.motivo %></strong></td>
              <td>
                <% if (cita.estado === 'pendiente') { %>
                  <span class="status-badge status-pendiente">Pendiente</span>
                <% } else if (cita.estado === 'triaje_registrado') { %>
                  <span class="status-badge status-triaje_registrado">Triaje registrado</span>
                <% } else if (cita.estado === 'en_consulta') { %>
                  <span class="status-badge status-en_consulta">En consulta</span>
                <% } else if (cita.estado === 'completada') { %>
                  <span class="status-badge status-completada">Completada</span>
                <% } else if (cita.estado === 'cancelada') { %>
                  <span class="status-badge status-cancelada">Cancelada</span>
                <% } %>
              </td>
              <td>
                <div class="table-actions">
                  <a href="/admin/citas/<%= cita.id_cita %>/detalle" class="btn-table-primary icon-action" title="Ver detalles" aria-label="Ver detalles">
                    <img class="action-metaphor" src="/img/action-metaphors/paciente/citas/ver_cita.png" alt="" aria-hidden="true">
                    <span class="visually-hidden">Ver detalles</span>
                  </a>

                  <% if (cita.estado === 'pendiente' || cita.estado === 'triaje_registrado') { %>
                    <form
                      action="/admin/citas/<%= cita.id_cita %>/cancelar"
                      method="POST"
                      data-confirm-title="Cancelar cita"
                      data-confirm="La cita será marcada como cancelada. Esta acción no eliminará el registro del sistema."
                      data-confirm-button="Cancelar cita"
                    >
                      <button type="submit" class="btn-cancel btn-table-action" title="Cancelar cita" aria-label="Cancelar cita">
                        <img class="action-metaphor" src="/img/action-metaphors/administrador/citas/cancelar.png" alt="" aria-hidden="true">
                        <span>Cancelar</span>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<script src="/js/role-validations.js"></script>
