<div class="module-card usuarios-card">
  <div class="module-header module-header-row admin-users-header">
    <div class="module-header-copy">
      <p>Administra datos, roles y acceso de los usuarios registrados en el sistema.</p>
    </div>
  </div>

  <form action="/admin/usuarios" method="GET" class="filter-card js-role-validated-form" novalidate>
    <input type="hidden" name="sort" value="<%= filters.sort || 'fecha' %>">
    <input type="hidden" name="direction" value="<%= filters.direction || 'desc' %>">

    <div class="filter-grid admin-filter-row">
      <div class="form-group">
        <label for="q" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-search"></use></svg>
          <span>Buscar</span>
        </label>
        <input
          type="text"
          id="q"
          name="q"
          value="<%= filters.q || '' %>"
          placeholder="Nombre, DNI o usuario"
          maxlength="120"
          data-validate="search"
        >
        <span class="field-message" data-for="q"></span>
      </div>

      <div class="form-group">
        <label for="rol" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-user"></use></svg>
          <span>Rol</span>
        </label>
        <select id="rol" name="rol">
          <option value="">Todos</option>
          <option value="paciente" <%= filters.rol === 'paciente' ? 'selected' : '' %>>Paciente</option>
          <option value="medico" <%= filters.rol === 'medico' ? 'selected' : '' %>>Médico</option>
          <option value="enfermera" <%= filters.rol === 'enfermera' ? 'selected' : '' %>>Enfermera</option>
          <option value="administrativo" <%= filters.rol === 'administrativo' ? 'selected' : '' %>>Administrativo</option>
        </select>
      </div>

      <div class="form-group">
        <label for="estado" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-activity"></use></svg>
          <span>Estado</span>
        </label>
        <select id="estado" name="estado">
          <option value="">Todos</option>
          <option value="activo" <%= filters.estado === 'activo' ? 'selected' : '' %>>Activo</option>
          <option value="inactivo" <%= filters.estado === 'inactivo' ? 'selected' : '' %>>Inactivo</option>
        </select>
      </div>
    </div>

    <div class="filter-actions">
      <a href="/admin/usuarios" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
        <img class="action-metaphor" src="/img/action-metaphors/administrador/usuarios/limpiar.png" alt="" aria-hidden="true">
        <span>Limpiar</span>
      </a>
      <button type="submit" class="btn-dark icon-action" title="Buscar" aria-label="Buscar">
        <img class="action-metaphor" src="/img/action-metaphors/administrador/usuarios/filtrar.png" alt="" aria-hidden="true">
        <span>Buscar</span>
      </button>
    </div>
  </form>

  <% if (usuarios.length === 0) { %>
    <div class="empty-state">
      <h3>No se encontraron usuarios</h3>
      <p>No hay resultados con los filtros seleccionados.</p>
      <a href="/admin/usuarios" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
        <img class="action-metaphor" src="/img/action-metaphors/administrador/usuarios/limpiar.png" alt="" aria-hidden="true">
        <span>Limpiar</span>
      </a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table admin-users-table">
        <colgroup>
          <col class="admin-users-col-user">
          <col class="admin-users-col-dni">
          <col class="admin-users-col-phone">
          <col class="admin-users-col-role">
          <col class="admin-users-col-status">
          <col class="admin-users-col-actions">
        </colgroup>
        <thead>
          <%
            const sortQuery = (column) => {
              const query = new URLSearchParams();
              if (filters.q) query.set('q', filters.q);
              if (filters.rol) query.set('rol', filters.rol);
              if (filters.estado) query.set('estado', filters.estado);
              query.set('sort', column);
              query.set('direction', filters.sort === column && filters.direction === 'asc' ? 'desc' : 'asc');
              query.set('page', 1);
              return `/admin/usuarios?${query.toString()}`;
            };
            const sortMark = (column) => filters.sort === column ? (filters.direction === 'asc' ? ' ↑' : ' ↓') : '';
          %>
          <tr>
            <th><a class="sort-link" href="<%= sortQuery('usuario') %>">Usuario<%= sortMark('usuario') %></a></th>
            <th><a class="sort-link" href="<%= sortQuery('dni') %>">DNI<%= sortMark('dni') %></a></th>
            <th><a class="sort-link" href="<%= sortQuery('telefono') %>">Teléfono<%= sortMark('telefono') %></a></th>
            <th><a class="sort-link" href="<%= sortQuery('rol') %>">Rol<%= sortMark('rol') %></a></th>
            <th><a class="sort-link" href="<%= sortQuery('estado') %>">Estado<%= sortMark('estado') %></a></th>
            <th>Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% usuarios.forEach(usuario => { %>
            <% const relatedCount = Number(usuario.citas_paciente || 0) + Number(usuario.citas_medico || 0) + Number(usuario.triajes_enfermera || 0) + Number(usuario.antecedentes || 0); %>
            <% const nombreCompleto = `${usuario.nombres} ${usuario.apellido_paterno} ${usuario.apellido_materno || ''}`.trim(); %>
            <tr>
              <td class="admin-users-cell-user">
                <strong><%= nombreCompleto %></strong>
                <br>
              </td>

              <td><%= usuario.dni || 'No registrado' %></td>
              <td><%= usuario.telefono || 'No registrado' %></td>

              <td>
                <span class="role-badge role-<%= usuario.rol %>">
                  <%= usuario.rol %>
                </span>
              </td>

              <td>
                <% if (usuario.activo === 1) { %>
                  <span class="status-badge status-activo">Activo</span>
                <% } else { %>
                  <span class="status-badge status-inactivo">Inactivo</span>
                <% } %>
              </td>

              <td class="admin-users-cell-actions">
                <div class="table-actions">
                  <a
                    href="/admin/usuarios/<%= usuario.id_usuario %>/editar"
                    class="btn-light btn-table-action icon-action"
                    title="Editar usuario"
                    aria-label="Editar usuario"
                  >
                    <img class="action-metaphor" src="/img/action-metaphors/administrador/usuarios/editar.png" alt="" aria-hidden="true">
                    <span class="visually-hidden">Editar usuario</span>
                  </a>

                  <% if (usuario.id_usuario === user.id_usuario) { %>
                      <span class="text-muted user-action-note">Cuenta actual</span>
                    <% } else { %>
                      <button
                        type="button"
                        class="<%= usuario.activo === 1 ? 'btn-cancel' : 'btn-activate' %> btn-table-action icon-action js-user-status"
                        data-action="<%= usuario.activo === 1 ? 'desactivar' : 'activar' %>"
                        data-url="/admin/usuarios/<%= usuario.id_usuario %>/estado"
                        data-user="<%= nombreCompleto %>"
                        title="<%= usuario.activo === 1 ? 'Desactivar usuario' : 'Activar usuario' %>"
                        aria-label="<%= usuario.activo === 1 ? 'Desactivar usuario' : 'Activar usuario' %>"
                      >
                        <img class="action-metaphor" src="/img/action-metaphors/administrador/usuarios/<%= usuario.activo === 1 ? 'desactivar.png' : 'activar.png' %>" alt="" aria-hidden="true">
                        <span class="visually-hidden"><%= usuario.activo === 1 ? 'Desactivar' : 'Activar' %></span>
                      </button>

                      <% if (relatedCount === 0) { %>
                        <form
                          action="/admin/usuarios/<%= usuario.id_usuario %>/eliminar"
                          method="POST"
                          data-confirm-title="Eliminar usuario"
                          data-confirm="Este usuario no tiene registros históricos asociados. Se eliminarán sus datos personales, cuenta de acceso y fichas asociadas. Esta acción no se puede deshacer."
                          data-confirm-button="Eliminar"
                        >
                          <button
                            type="submit"
                            class="btn-table-action icon-action btn-table-delete"
                            title="Eliminar usuario"
                            aria-label="Eliminar usuario"
                          >
                            <img class="action-metaphor" src="/img/action-metaphors/administrador/usuarios/eliminar.png" alt="" aria-hidden="true">
                            <span class="visually-hidden">Eliminar usuario</span>
                          </button>
                        </form>
                      <% } %>
                    <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="table-pagination">
      <p>
        Mostrando <strong><%= pagination.from %>-<%= pagination.to %></strong>
        de <strong><%= pagination.total %></strong> registros
      </p>

      <div class="pagination-actions">
        <% const baseQuery = new URLSearchParams(); %>
        <% if (filters.q) baseQuery.set('q', filters.q); %>
        <% if (filters.rol) baseQuery.set('rol', filters.rol); %>
        <% if (filters.estado) baseQuery.set('estado', filters.estado); %>
        <% if (filters.sort) baseQuery.set('sort', filters.sort); %>
        <% if (filters.direction) baseQuery.set('direction', filters.direction); %>

        <% const prevQuery = new URLSearchParams(baseQuery); %>
        <% prevQuery.set('page', Math.max(pagination.page - 1, 1)); %>
        <% const nextQuery = new URLSearchParams(baseQuery); %>
        <% nextQuery.set('page', Math.min(pagination.page + 1, pagination.totalPages)); %>

        <a
          href="/admin/usuarios?<%= prevQuery.toString() %>"
          class="pagination-button <%= pagination.page <= 1 ? 'disabled' : '' %>"
          aria-label="Página anterior"
        >
          &lt;
        </a>
        <span>Pagina <%= pagination.page %> de <%= pagination.totalPages %></span>
        <a
          href="/admin/usuarios?<%= nextQuery.toString() %>"
          class="pagination-button <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>"
          aria-label="Página siguiente"
        >
          &gt;
        </a>
      </div>
    </div>
  <% } %>
</div>

<div class="modal-overlay hidden" id="userStatusModal" role="dialog" aria-modal="true" aria-labelledby="userStatusTitle" aria-describedby="userStatusText">
  <div class="confirm-modal confirm-modal-polished" data-confirm-action="desactivar">
    <button type="button" class="modal-close confirm-modal-close" id="closeUserStatusModalTop" aria-label="Cerrar confirmación">&times;</button>
    <div class="confirm-modal-icon" aria-hidden="true">
      <i class="bi bi-person-dash"></i>
    </div>
    <h3 id="userStatusTitle">Confirmar acción</h3>
    <p id="userStatusText">¿Estás seguro de realizar esta acción?</p>
    <small class="confirm-modal-note" id="userStatusNote">Revisa la cuenta antes de continuar.</small>

    <div class="modal-actions">
      <button type="button" class="btn-light" id="closeUserStatusModal" title="Cancelar" aria-label="Cancelar">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>Cancelar</span>
      </button>

      <form method="POST" id="userStatusForm">
        <input type="hidden" name="accion" id="userStatusAction">
        <button type="submit" class="btn-danger icon-action" id="userStatusConfirmButton" title="Confirmar" aria-label="Confirmar">
          <i class="bi bi-person-dash" aria-hidden="true"></i>
          <span>Confirmar</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  const userStatusButtons = document.querySelectorAll('.js-user-status');
  const userStatusModal = document.getElementById('userStatusModal');
  const userStatusForm = document.getElementById('userStatusForm');
  const userStatusAction = document.getElementById('userStatusAction');
  const userStatusText = document.getElementById('userStatusText');
  const userStatusTitle = document.getElementById('userStatusTitle');
  const userStatusNote = document.getElementById('userStatusNote');
  const userStatusConfirmButton = document.getElementById('userStatusConfirmButton');
  const closeUserStatusModal = document.getElementById('closeUserStatusModal');
  const closeUserStatusModalTop = document.getElementById('closeUserStatusModalTop');
  const userStatusModalCard = userStatusModal.querySelector('.confirm-modal');
  const userStatusModalIcon = userStatusModal.querySelector('.confirm-modal-icon i');

  userStatusButtons.forEach(button => {
    button.addEventListener('click', () => {
      const action = button.dataset.action;
      const url = button.dataset.url;
      const userName = button.dataset.user;

      userStatusForm.action = url;
      userStatusAction.value = action;

      if (action === 'desactivar') {
        userStatusTitle.textContent = 'Desactivar usuario';
        userStatusText.textContent = `¿Estás seguro de desactivar la cuenta de ${userName}? Esta persona no podrá iniciar sesión.`;
        userStatusNote.textContent = 'La cuenta quedará bloqueada hasta que un administrador la reactive.';
        userStatusModalCard.dataset.confirmAction = 'desactivar';
        userStatusConfirmButton.className = 'btn-danger icon-action';
        userStatusConfirmButton.dataset.confirmAction = 'desactivar';
        userStatusConfirmButton.title = 'Sí, desactivar';
        userStatusConfirmButton.setAttribute('aria-label', 'Sí, desactivar');
        userStatusConfirmButton.querySelector('i').className = 'bi bi-person-dash';
        userStatusModalIcon.className = 'bi bi-person-dash';
        userStatusConfirmButton.querySelector('span').textContent = 'Sí, desactivar';
      } else {
        userStatusTitle.textContent = 'Activar usuario';
        userStatusText.textContent = `¿Deseas activar nuevamente la cuenta de ${userName}?`;
        userStatusNote.textContent = 'La persona podrá volver a iniciar sesión con normalidad.';
        userStatusModalCard.dataset.confirmAction = 'activar';
        userStatusConfirmButton.className = 'btn-success-action icon-action';
        userStatusConfirmButton.dataset.confirmAction = 'activar';
        userStatusConfirmButton.title = 'Sí, activar';
        userStatusConfirmButton.setAttribute('aria-label', 'Sí, activar');
        userStatusConfirmButton.querySelector('i').className = 'bi bi-person-check';
        userStatusModalIcon.className = 'bi bi-person-check';
        userStatusConfirmButton.querySelector('span').textContent = 'Sí, activar';
      }

      userStatusModal.classList.remove('hidden');
    });
  });

  closeUserStatusModal.addEventListener('click', () => {
    userStatusModal.classList.add('hidden');
  });

  closeUserStatusModalTop.addEventListener('click', () => {
    userStatusModal.classList.add('hidden');
  });

  userStatusModal.addEventListener('click', event => {
    if (event.target === userStatusModal) {
      userStatusModal.classList.add('hidden');
    }
  });
</script>
<script src="/js/role-validations.js"></script>
