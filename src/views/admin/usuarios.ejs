<div class="module-card usuarios-card">
  <div class="module-header module-header-row">
    <div>
      <p>Administra datos, roles y acceso de los usuarios registrados en el sistema.</p>
    </div>
  </div>

  <form action="/admin/usuarios" method="GET" class="filter-card js-role-validated-form" novalidate>
    <input type="hidden" name="sort" value="<%= filters.sort || 'fecha' %>">
    <input type="hidden" name="direction" value="<%= filters.direction || 'desc' %>">

    <div class="filter-grid admin-filter-row">
      <div class="form-group">
        <label for="q">Buscar</label>
        <input
          type="text"
          id="q"
          name="q"
          value="<%= filters.q || '' %>"
          placeholder="Nombre, DNI, correo o usuario"
          maxlength="120"
          data-validate="search"
        >
        <span class="field-message" data-for="q"></span>
      </div>

      <div class="form-group">
        <label for="rol">Rol</label>
        <select id="rol" name="rol">
          <option value="">Todos</option>
          <option value="paciente" <%= filters.rol === 'paciente' ? 'selected' : '' %>>Paciente</option>
          <option value="medico" <%= filters.rol === 'medico' ? 'selected' : '' %>>Medico</option>
          <option value="enfermera" <%= filters.rol === 'enfermera' ? 'selected' : '' %>>Enfermera</option>
          <option value="administrativo" <%= filters.rol === 'administrativo' ? 'selected' : '' %>>Administrativo</option>
        </select>
      </div>

      <div class="form-group">
        <label for="estado">Estado</label>
        <select id="estado" name="estado">
          <option value="">Todos</option>
          <option value="activo" <%= filters.estado === 'activo' ? 'selected' : '' %>>Activo</option>
          <option value="inactivo" <%= filters.estado === 'inactivo' ? 'selected' : '' %>>Inactivo</option>
        </select>
      </div>
    </div>

    <div class="filter-actions">
      <a href="/admin/usuarios" class="btn-light">Limpiar filtros</a>
      <button type="submit" class="btn-dark">Filtrar</button>
    </div>
  </form>

  <% if (usuarios.length === 0) { %>
    <div class="empty-state">
      <h3>No se encontraron usuarios</h3>
      <p>No hay resultados con los filtros seleccionados.</p>
      <a href="/admin/usuarios" class="btn-dark">Limpiar filtros</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <%
            const sortQuery = (column) => {
              const query = new URLSearchParams();
              if (filters.q) query.set('q', filters.q);
              if (filters.rol) query.set('rol', filters.rol);
              if (filters.estado) query.set('estado', filters.estado);
              query.set('sort', column);
              query.set('direction', filters.sort === column && filters.direction === 'asc' ? 'desc' : 'asc');
              query.set('page', 1);
              return `/admin/usuarios?${query.toString()}`;
            };
            const sortMark = (column) => filters.sort === column ? (filters.direction === 'asc' ? ' ↑' : ' ↓') : '';
          %>
          <tr>
            <th><a class="sort-link" href="<%= sortQuery('usuario') %>">Usuario<%= sortMark('usuario') %></a></th>
            <th><a class="sort-link" href="<%= sortQuery('dni') %>">DNI<%= sortMark('dni') %></a></th>
            <th><a class="sort-link" href="<%= sortQuery('correo') %>">Correo<%= sortMark('correo') %></a></th>
            <th><a class="sort-link" href="<%= sortQuery('telefono') %>">Telefono<%= sortMark('telefono') %></a></th>
            <th><a class="sort-link" href="<%= sortQuery('rol') %>">Rol<%= sortMark('rol') %></a></th>
            <th><a class="sort-link" href="<%= sortQuery('estado') %>">Estado<%= sortMark('estado') %></a></th>
            <th>Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% usuarios.forEach(usuario => { %>
            <% const relatedCount = Number(usuario.citas_paciente || 0) + Number(usuario.citas_medico || 0) + Number(usuario.triajes_enfermera || 0) + Number(usuario.antecedentes || 0); %>
            <% const nombreCompleto = `${usuario.nombres} ${usuario.apellido_paterno} ${usuario.apellido_materno || ''}`.trim(); %>
            <tr>
              <td>
                <strong><%= nombreCompleto %></strong>
                <br>
                <span class="text-muted">@<%= usuario.username %></span>
              </td>

              <td><%= usuario.dni || 'No registrado' %></td>
              <td><%= usuario.correo %></td>
              <td><%= usuario.telefono || 'No registrado' %></td>

              <td>
                <span class="role-badge role-<%= usuario.rol %>">
                  <%= usuario.rol %>
                </span>
              </td>

              <td>
                <% if (usuario.activo === 1) { %>
                  <span class="status-badge status-activo">Activo</span>
                <% } else { %>
                  <span class="status-badge status-inactivo">Inactivo</span>
                <% } %>
              </td>

              <td>
                <div class="table-actions">
                  <button
                    type="button"
                    class="btn-light btn-table-action js-user-edit"
                    data-url="/admin/usuarios/<%= usuario.id_usuario %>/editar"
                    data-id="<%= usuario.id_usuario %>"
                    data-self="<%= usuario.id_usuario === user.id_usuario ? '1' : '0' %>"
                    data-nombres="<%= usuario.nombres %>"
                    data-apellido-paterno="<%= usuario.apellido_paterno %>"
                    data-apellido-materno="<%= usuario.apellido_materno || '' %>"
                    data-dni="<%= usuario.dni || '' %>"
                    data-correo="<%= usuario.correo %>"
                    data-telefono="<%= usuario.telefono || '' %>"
                    data-username="<%= usuario.username %>"
                    data-rol="<%= usuario.rol %>"
                    data-activo="<%= usuario.activo %>"
                    data-has-paciente="<%= usuario.id_paciente ? '1' : '0' %>"
                    data-has-medico="<%= usuario.id_medico ? '1' : '0' %>"
                    data-medico-especialidad="<%= usuario.medico_especialidad || '' %>"
                    data-medico-colegiatura="<%= usuario.medico_colegiatura || '' %>"
                    data-medico-turno="<%= usuario.medico_turno || '' %>"
                    data-has-enfermera="<%= usuario.id_enfermera ? '1' : '0' %>"
                    data-enfermera-area="<%= usuario.enfermera_area || '' %>"
                    data-enfermera-turno="<%= usuario.enfermera_turno || '' %>"
                    data-has-administrativo="<%= usuario.id_administrativo ? '1' : '0' %>"
                    data-administrativo-cargo="<%= usuario.administrativo_cargo || 'Administrativo' %>"
                    data-administrativo-anexo="<%= usuario.administrativo_anexo || '' %>"
                    title="Editar acceso y rol"
                    aria-label="Editar acceso y rol"
                  >
                    Editar acceso
                  </button>

                  <% if (usuario.id_usuario === user.id_usuario) { %>
                      <span class="text-muted user-action-note">Cuenta actual</span>
                    <% } else { %>
                      <button
                        type="button"
                        class="<%= usuario.activo === 1 ? 'btn-cancel' : 'btn-activate' %> btn-table-action js-user-status"
                        data-action="<%= usuario.activo === 1 ? 'desactivar' : 'activar' %>"
                        data-url="/admin/usuarios/<%= usuario.id_usuario %>/estado"
                        data-user="<%= nombreCompleto %>"
                        title="<%= usuario.activo === 1 ? 'Desactivar usuario' : 'Activar usuario' %>"
                        aria-label="<%= usuario.activo === 1 ? 'Desactivar usuario' : 'Activar usuario' %>"
                      >
                        <%= usuario.activo === 1 ? 'Desactivar' : 'Activar' %>
                      </button>

                      <% if (relatedCount === 0) { %>
                        <form
                          action="/admin/usuarios/<%= usuario.id_usuario %>/eliminar"
                          method="POST"
                          data-confirm-title="Eliminar usuario"
                          data-confirm="Este usuario no tiene registros históricos asociados. Se eliminarán sus datos personales, cuenta de acceso y fichas asociadas. Esta acción no se puede deshacer."
                          data-confirm-button="Eliminar"
                        >
                          <button
                            type="submit"
                            class="btn-danger btn-table-action"
                            title="Eliminar usuario"
                            aria-label="Eliminar usuario"
                          >
                            Eliminar
                          </button>
                        </form>
                      <% } %>
                    <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="table-pagination">
      <p>
        Mostrando <strong><%= pagination.from %>-<%= pagination.to %></strong>
        de <strong><%= pagination.total %></strong> registros
      </p>

      <div class="pagination-actions">
        <% const baseQuery = new URLSearchParams(); %>
        <% if (filters.q) baseQuery.set('q', filters.q); %>
        <% if (filters.rol) baseQuery.set('rol', filters.rol); %>
        <% if (filters.estado) baseQuery.set('estado', filters.estado); %>
        <% if (filters.sort) baseQuery.set('sort', filters.sort); %>
        <% if (filters.direction) baseQuery.set('direction', filters.direction); %>

        <% const prevQuery = new URLSearchParams(baseQuery); %>
        <% prevQuery.set('page', Math.max(pagination.page - 1, 1)); %>
        <% const nextQuery = new URLSearchParams(baseQuery); %>
        <% nextQuery.set('page', Math.min(pagination.page + 1, pagination.totalPages)); %>

        <a
          href="/admin/usuarios?<%= prevQuery.toString() %>"
          class="pagination-button <%= pagination.page <= 1 ? 'disabled' : '' %>"
          aria-label="Pagina anterior"
        >
          &lt;
        </a>
        <span>Pagina <%= pagination.page %> de <%= pagination.totalPages %></span>
        <a
          href="/admin/usuarios?<%= nextQuery.toString() %>"
          class="pagination-button <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>"
          aria-label="Pagina siguiente"
        >
          &gt;
        </a>
      </div>
    </div>
  <% } %>
</div>

<div class="modal-overlay hidden" id="userEditModal">
  <div class="confirm-modal user-edit-modal user-edit-modal-polished">
    <div class="modal-header">
      <div>
       <h3>Editar acceso y rol de usuario</h3>
<p id="editUserSubtitle">Usuario seleccionado:</p>
      </div>
    </div>

    <form method="POST" id="userEditForm" class="modal-form">
      <div id="userEditMessage" class="step-message hidden"></div>
      <section class="modal-form-section">
        <h4>Acceso</h4>

        <div class="modal-form-grid auth-edit-grid">
          <div class="form-group">
            <label for="editUsername">Correo de acceso</label>
            <input type="email" id="editUsername" name="username" required>
            <small class="form-help">Se usará para iniciar sesión, recuperación e identificación de acceso.</small>
          </div>

          <div class="form-group">
            <label for="editPassword">Nueva contraseña</label>
            <input
              type="password"
              id="editPassword"
              name="password"
              placeholder="Dejar vacío para conservar"
              minlength="8"
            >
            <small class="form-help">Opcional. Si la cambias, debe tener mayúscula, minúscula, número y símbolo.</small>
          </div>
        </div>
      </section>

      <section class="modal-form-section">
        <h4>Permisos</h4>

        <div class="modal-form-grid modal-form-grid-single">
          <div class="form-group">
            <label for="editRol">Rol de acceso</label>
            <select id="editRol" name="rol" required>
              <option value="paciente">Paciente</option>
              <option value="medico">Médico</option>
              <option value="enfermera">Enfermera</option>
              <option value="administrativo">Administrativo</option>
            </select>
            <small class="form-help">
              Si cambias el rol a Médico o Enfermera y no existe una ficha asociada, deberás completar los datos mínimos requeridos.
            </small>

            <div class="role-change-note">
              <strong>Importante:</strong>
              El cambio de rol modifica el acceso al sistema, pero no elimina registros históricos asociados.
            </div>
          </div>
        </div>
      </section>

      <section class="modal-form-section hidden" id="medicoRoleFields">
        <h4>Ficha mínima de médico</h4>

        <div class="notice-box">
          Estos datos solo se solicitan porque el usuario aún no tiene ficha médica registrada.
        </div>

        <div class="modal-form-grid">
          <div class="form-group">
            <label for="editEspecialidad">Especialidad</label>
            <select id="editEspecialidad" name="especialidad">
              <option value="">Seleccione</option>
              <option value="Medicina General">Medicina General</option>
              <option value="Odontología">Odontología</option>
              <option value="Psicología">Psicología</option>
            </select>
          </div>

          <div class="form-group">
            <label for="editColegiatura">Número de colegiatura</label>
            <input type="text" id="editColegiatura" name="numero_colegiatura" maxlength="30">
          </div>

          <div class="form-group">
            <label for="editTurnoMedico">Turno</label>
            <select id="editTurnoMedico" name="turno_medico">
              <option value="">Seleccione</option>
              <option value="mañana">Mañana</option>
              <option value="tarde">Tarde</option>
              <option value="completo">Completo</option>
            </select>
          </div>
        </div>
      </section>

      <section class="modal-form-section hidden" id="enfermeraRoleFields">
        <h4>Ficha mínima de enfermería</h4>

        <div class="notice-box">
          Estos datos solo se solicitan porque el usuario aún no tiene ficha de enfermería registrada.
        </div>

        <div class="modal-form-grid">
          <div class="form-group">
            <label for="editArea">Área</label>
            <input type="text" id="editArea" name="area" maxlength="80">
          </div>

          <div class="form-group">
            <label for="editTurnoEnfermera">Turno</label>
            <select id="editTurnoEnfermera" name="turno_enfermera">
              <option value="">Seleccione</option>
              <option value="mañana">Mañana</option>
              <option value="tarde">Tarde</option>
              <option value="completo">Completo</option>
            </select>
          </div>
        </div>
      </section>

      <section class="modal-form-section hidden" id="adminRoleFields">
        <h4>Ficha administrativa</h4>

        <div class="modal-form-grid">
          <div class="form-group">
            <label for="editCargo">Cargo</label>
            <input type="text" id="editCargo" name="cargo" maxlength="80" value="Administrativo">
          </div>

          <div class="form-group">
            <label for="editAnexo">Anexo</label>
            <input type="text" id="editAnexo" name="anexo" maxlength="20">
          </div>
        </div>
      </section>

      <p class="form-help hidden" id="editSelfHelp">
        Por seguridad, tu propia cuenta conserva el rol administrativo. Puedes cambiar el correo o la contraseña, pero no tu rol.
      </p>
      <div class="modal-actions">
        <button type="button" class="btn-light" id="closeUserEditModal">Cancelar</button>
        <button type="submit" class="btn-dark">Guardar cambios</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay hidden" id="userStatusModal">
  <div class="confirm-modal">
    <h3 id="userStatusTitle">Confirmar accion</h3>
    <p id="userStatusText">Estas seguro de realizar esta accion?</p>

    <div class="modal-actions">
      <button type="button" class="btn-light" id="closeUserStatusModal">Cancelar</button>

      <form method="POST" id="userStatusForm">
        <input type="hidden" name="accion" id="userStatusAction">
        <button type="submit" class="btn-danger" id="userStatusConfirmButton">
          Confirmar
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  const userEditButtons = document.querySelectorAll('.js-user-edit');
  const userEditModal = document.getElementById('userEditModal');
  const userEditForm = document.getElementById('userEditForm');
  const closeUserEditModal = document.getElementById('closeUserEditModal');
  const editSelfHelp = document.getElementById('editSelfHelp');
  const userEditMessage = document.getElementById('userEditMessage');
  const medicoRoleFields = document.getElementById('medicoRoleFields');
  const enfermeraRoleFields = document.getElementById('enfermeraRoleFields');
  const adminRoleFields = document.getElementById('adminRoleFields');

  let selectedUserButton = null;

  const editFields = {
    username: document.getElementById('editUsername'),
    password: document.getElementById('editPassword'),
    rol: document.getElementById('editRol'),

    especialidad: document.getElementById('editEspecialidad'),
    colegiatura: document.getElementById('editColegiatura'),
    turnoMedico: document.getElementById('editTurnoMedico'),

    area: document.getElementById('editArea'),
    turnoEnfermera: document.getElementById('editTurnoEnfermera'),

    cargo: document.getElementById('editCargo'),
    anexo: document.getElementById('editAnexo')
  };

  function setRequired(section, required) {
    section.querySelectorAll('input, select').forEach(input => {
      input.required = required;
    });
  }

  function hideRoleSections() {
    medicoRoleFields.classList.add('hidden');
    enfermeraRoleFields.classList.add('hidden');
    adminRoleFields.classList.add('hidden');

    setRequired(medicoRoleFields, false);
    setRequired(enfermeraRoleFields, false);
    setRequired(adminRoleFields, false);
  }
  function showUserEditMessage(message, field = null) {
  userEditMessage.textContent = message;
  userEditMessage.classList.remove('hidden');

  if (field) {
    field.classList.add('field-error');
    field.focus();
  }
}

  function clearUserEditMessage() {
    userEditMessage.textContent = '';
    userEditMessage.classList.add('hidden');
    Object.values(editFields).forEach(field => {
      if (field && field.classList) field.classList.remove('field-error');
    });
  }
  function updateRoleFields() {
    hideRoleSections();

    if (!selectedUserButton) return;

    const selectedRole = editFields.rol.value;
    const isSelf = selectedUserButton.dataset.self === '1';

    if (isSelf) {
      return;
    }

    if (selectedRole === 'medico') {
      const needsMedicoData =
        selectedUserButton.dataset.hasMedico !== '1' ||
        !selectedUserButton.dataset.medicoEspecialidad ||
        !selectedUserButton.dataset.medicoColegiatura ||
        !selectedUserButton.dataset.medicoTurno;

      if (needsMedicoData) {
        medicoRoleFields.classList.remove('hidden');
        setRequired(medicoRoleFields, true);
      }
    }

    if (selectedRole === 'enfermera') {
      const needsEnfermeraData =
        selectedUserButton.dataset.hasEnfermera !== '1' ||
        !selectedUserButton.dataset.enfermeraArea ||
        !selectedUserButton.dataset.enfermeraTurno;

      if (needsEnfermeraData) {
        enfermeraRoleFields.classList.remove('hidden');
        setRequired(enfermeraRoleFields, true);
      }
    }

    if (selectedRole === 'administrativo') {
      const needsAdminData =
        selectedUserButton.dataset.hasAdministrativo !== '1' ||
        !selectedUserButton.dataset.administrativoCargo;

      if (needsAdminData) {
        adminRoleFields.classList.remove('hidden');
        editFields.cargo.required = true;
      }
    }
  }

  userEditButtons.forEach(button => {
    button.addEventListener('click', () => {
      selectedUserButton = button;

      userEditForm.action = button.dataset.url;

      editFields.username.value = button.dataset.correo || button.dataset.username;
      editFields.password.value = '';
      editFields.rol.value = button.dataset.rol;

      editFields.especialidad.value = button.dataset.medicoEspecialidad || '';
      editFields.colegiatura.value = button.dataset.medicoColegiatura || '';
      editFields.turnoMedico.value = button.dataset.medicoTurno || '';

      editFields.area.value = button.dataset.enfermeraArea || '';
      editFields.turnoEnfermera.value = button.dataset.enfermeraTurno || '';

      editFields.cargo.value = button.dataset.administrativoCargo || 'Administrativo';
      editFields.anexo.value = button.dataset.administrativoAnexo || '';

     const selectedUserFullName =
        `${button.dataset.nombres} ${button.dataset.apellidoPaterno} ${button.dataset.apellidoMaterno || ''}`.trim();

      document.getElementById('editUserSubtitle').textContent =
        `Usuario seleccionado: ${selectedUserFullName}`;
      const isSelf = button.dataset.self === '1';

      editFields.rol.disabled = isSelf;
      editSelfHelp.classList.toggle('hidden', !isSelf);

      if (isSelf) {
        const hiddenRole = document.createElement('input');
        hiddenRole.type = 'hidden';
        hiddenRole.name = 'rol';
        hiddenRole.value = button.dataset.rol;
        hiddenRole.id = 'hiddenSelfRole';

        const oldHidden = document.getElementById('hiddenSelfRole');
        if (oldHidden) oldHidden.remove();

        userEditForm.appendChild(hiddenRole);
      } else {
        const oldHidden = document.getElementById('hiddenSelfRole');
        if (oldHidden) oldHidden.remove();
      }

      updateRoleFields();
      userEditModal.classList.remove('hidden');
    });
  });

  editFields.rol.addEventListener('change', updateRoleFields);

  closeUserEditModal.addEventListener('click', () => {
    userEditModal.classList.add('hidden');
  });

  userEditModal.addEventListener('click', event => {
    if (event.target === userEditModal) {
      userEditModal.classList.add('hidden');
    }
  });

  userEditForm.addEventListener('submit', event => {
    const password = editFields.password.value.trim();

    if (password) {
      const strong =
        password.length >= 8 &&
        /[A-Z]/.test(password) &&
        /[a-z]/.test(password) &&
        /\d/.test(password) &&
        /[^A-Za-z0-9]/.test(password);

      if (!strong) {
        event.preventDefault();
        showUserEditMessage('La nueva contraseña debe tener mínimo 8 caracteres, mayúscula, minúscula, número y símbolo.',
          editFields.password
        );
        return;
      }
    }
  });

  const userStatusButtons = document.querySelectorAll('.js-user-status');
  const userStatusModal = document.getElementById('userStatusModal');
  const userStatusForm = document.getElementById('userStatusForm');
  const userStatusAction = document.getElementById('userStatusAction');
  const userStatusText = document.getElementById('userStatusText');
  const userStatusTitle = document.getElementById('userStatusTitle');
  const userStatusConfirmButton = document.getElementById('userStatusConfirmButton');
  const closeUserStatusModal = document.getElementById('closeUserStatusModal');

  userStatusButtons.forEach(button => {
    button.addEventListener('click', () => {
      const action = button.dataset.action;
      const url = button.dataset.url;
      const userName = button.dataset.user;

      userStatusForm.action = url;
      userStatusAction.value = action;

      if (action === 'desactivar') {
        userStatusTitle.textContent = 'Desactivar usuario';
        userStatusText.textContent = `¿Estás seguro de desactivar la cuenta de ${userName}? Esta persona no podrá iniciar sesión.`;
        userStatusConfirmButton.textContent = 'Sí, desactivar';
        userStatusConfirmButton.className = 'btn-danger';
      } else {
        userStatusTitle.textContent = 'Activar usuario';
        userStatusText.textContent = `¿Deseas activar nuevamente la cuenta de ${userName}?`;
        userStatusConfirmButton.textContent = 'Sí, activar';
        userStatusConfirmButton.className = 'btn-success-action';
      }

      userStatusModal.classList.remove('hidden');
    });
  });

  closeUserStatusModal.addEventListener('click', () => {
    userStatusModal.classList.add('hidden');
  });

  userStatusModal.addEventListener('click', event => {
    if (event.target === userStatusModal) {
      userStatusModal.classList.add('hidden');
    }
  });
</script>
<script src="/js/role-validations.js"></script>