<%
  const isEdit = modo === 'editar';
  const formIntro = isEdit
    ? 'Actualiza solo los datos necesarios del usuario seleccionado.'
    : 'Completa los datos personales, acceso y rol para crear una nueva cuenta.';

  const selectedRole = usuario.rol || 'paciente';

  const especialidades = ['Medicina General', 'Odontología', 'Psicología'];
  const turnos = [
    { value: 'mañana', label: 'Mañana' },
    { value: 'tarde', label: 'Tarde' },
    { value: 'completo', label: 'Completo' }
  ];
  const cargosAdministrativos = ['Admisión', 'Gestión de usuarios'];

  const selectedCargo = usuario.administrativo_cargo || '';
  const cargoNoListado = selectedCargo && !cargosAdministrativos.includes(selectedCargo);
  const isPrincipal = Boolean(isPrincipalAdministrador);
  const rolesPermitidosFormulario = rolesDisponibles || ['paciente', 'medico', 'enfermera'];
  const facultadesUNT = catalogoAcademico || {};
  const selectedFacultad = usuario.paciente_facultad || '';
  const escuelasDeFacultad = facultadesUNT[selectedFacultad] || [];
  const selectedEscuela = usuario.paciente_escuela || '';
  const facultadNoListada = selectedFacultad && !Object.prototype.hasOwnProperty.call(facultadesUNT, selectedFacultad);
  const escuelaNoListada = selectedEscuela && !escuelasDeFacultad.includes(selectedEscuela);
%>

<div class="module-card admin-user-form-card">
  <div class="module-header admin-user-form-intro">
    <p><%= formIntro %></p>
  </div>

  <form
    action="<%= actionUrl %>"
    method="POST"
    class="admin-user-form js-role-validated-form"
    id="adminUserForm"
    data-original-role="<%= selectedRole %>"
    data-confirm-title="<%= isEdit ? 'Actualizar usuario' : 'Registrar usuario' %>"
    data-confirm="Revisa DNI, correo, rol y datos profesionales antes de <%= isEdit ? 'actualizar la cuenta' : 'registrar la cuenta' %>."
    data-confirm-button="<%= isEdit ? 'Actualizar usuario' : 'Registrar usuario' %>"
    novalidate
  >
    <div class="form-section-card">
      <div class="form-section-heading">
        <h3><i class="bi bi-person-vcard" aria-hidden="true"></i>Datos personales</h3>
        <p>Registra información clara para identificar al usuario dentro del sistema.</p>
      </div>

      <div class="admin-user-form-grid">
        <div class="form-group">
          <label for="nombres" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-user"></use></svg>
            <span>Nombres</span>
          </label>
          <input type="text" id="nombres" name="nombres" value="<%= usuario.nombres || '' %>" maxlength="80" data-validate="personal-name" data-min="2" autocomplete="given-name" required>
          <small class="field-message" data-for="nombres"></small>
        </div>

        <div class="form-group">
          <label for="apellido_paterno" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-user"></use></svg>
            <span>Apellido paterno</span>
          </label>
          <input type="text" id="apellido_paterno" name="apellido_paterno" value="<%= usuario.apellido_paterno || '' %>" maxlength="80" data-validate="personal-name" data-min="2" autocomplete="family-name" required>
          <small class="field-message" data-for="apellido_paterno"></small>
        </div>

        <div class="form-group">
          <label for="apellido_materno" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-user"></use></svg>
            <span>Apellido materno</span>
          </label>
          <input type="text" id="apellido_materno" name="apellido_materno" value="<%= usuario.apellido_materno || '' %>" maxlength="80" data-validate="personal-name" data-min="2" autocomplete="additional-name">
          <small class="field-message" data-for="apellido_materno"></small>
        </div>

        <div class="form-group">
          <label for="dni" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-note"></use></svg>
            <span>DNI</span>
          </label>
          <input type="text" id="dni" name="dni" value="<%= usuario.dni || '' %>" maxlength="8" inputmode="numeric" data-validate="dni" autocomplete="off" required>
          <small class="field-message" data-for="dni"></small>
        </div>

        <div class="form-group">
          <label for="fecha_nacimiento" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-calendar"></use></svg>
            <span>Fecha de nacimiento</span>
          </label>
          <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" value="<%= usuario.fecha_nacimiento || '' %>" data-validate="birth-date" required>
          <small class="field-message" data-for="fecha_nacimiento"></small>
        </div>

        <div class="form-group">
          <label for="sexo" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-user"></use></svg>
            <span>Sexo</span>
          </label>
          <select id="sexo" name="sexo" required>
            <option value="">Seleccione</option>
            <option value="Masculino" <%= usuario.sexo === 'Masculino' ? 'selected' : '' %>>Masculino</option>
            <option value="Femenino" <%= usuario.sexo === 'Femenino' ? 'selected' : '' %>>Femenino</option>
            <option value="Otro" <%= usuario.sexo === 'Otro' ? 'selected' : '' %>>Otro</option>
            <option value="No especifica" <%= usuario.sexo === 'No especifica' ? 'selected' : '' %>>No especifica</option>
          </select>
          <small class="field-message" data-for="sexo"></small>
        </div>

        <div class="form-group">
          <label for="telefono" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-phone"></use></svg>
            <span>Teléfono</span>
          </label>
          <input type="text" id="telefono" name="telefono" value="<%= usuario.telefono || '' %>" maxlength="11" inputmode="numeric" data-validate="phone-pe" autocomplete="tel" placeholder="987 654 321" required>
          <small class="field-message" data-for="telefono"></small>
        </div>

        <div class="form-group">
          <label for="direccion" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-note"></use></svg>
            <span>Dirección</span>
          </label>
          <input type="text" id="direccion" name="direccion" value="<%= usuario.direccion || '' %>" maxlength="120" data-validate="address" autocomplete="street-address">
          <small class="field-message" data-for="direccion"></small>
        </div>
      </div>
    </div>

    <div class="form-section-card">
      <div class="form-section-heading">
        <h3><i class="bi bi-shield-lock" aria-hidden="true"></i>Acceso y permisos</h3>
        <p>Define el correo de acceso y el rol con el que ingresará al sistema.</p>
      </div>

      <div class="admin-user-form-grid admin-user-access-grid">
        <div class="form-group">
          <label for="username" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-mail"></use></svg>
            <span>Correo de acceso</span>
          </label>
          <input type="email" id="username" name="username" value="<%= usuario.username || usuario.correo || '' %>" maxlength="120" data-validate="email" autocomplete="email" required>
          <small class="field-message" data-for="username"></small>
          <small class="form-help form-help-with-icon"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Este correo se usará para iniciar sesión y recuperar la contraseña.</span></small>
        </div>

        <div class="form-group">
          <label for="password" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-lock"></use></svg>
            <span><%= isEdit ? 'Nueva contraseña' : 'Contraseña inicial' %></span>
          </label>
          <input type="password" id="password" name="password" minlength="8" data-validate="strong-password" autocomplete="new-password" placeholder="<%= isEdit ? 'Opcional: dejar vacío para conservar' : 'Opcional: se usará UNT12345*' %>">
          <small class="field-message" data-for="password"></small>
          <small class="form-help form-help-with-icon"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Opcional. Si la escribes, debe tener mayúscula, minúscula, número y símbolo.</span></small>
          <div class="password-strength" id="adminPasswordStrength" aria-live="polite">
            <span></span>
            <p>Seguridad: sin evaluar</p>
          </div>
        </div>

        <div class="form-group admin-user-role-field">
          <label for="rol" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-user"></use></svg>
            <span>Rol de acceso</span>
          </label>
          <select id="rol" name="rol" <%= isSelf ? 'disabled' : '' %> required>
            <% if (rolesPermitidosFormulario.includes('paciente')) { %>
              <option value="paciente" <%= selectedRole === 'paciente' ? 'selected' : '' %>>Paciente</option>
            <% } %>
            <% if (rolesPermitidosFormulario.includes('medico')) { %>
              <option value="medico" <%= selectedRole === 'medico' ? 'selected' : '' %>>Médico</option>
            <% } %>
            <% if (rolesPermitidosFormulario.includes('enfermera')) { %>
              <option value="enfermera" <%= selectedRole === 'enfermera' ? 'selected' : '' %>>Enfermera</option>
            <% } %>
            <% if (rolesPermitidosFormulario.includes('administrativo')) { %>
              <option value="administrativo" <%= selectedRole === 'administrativo' ? 'selected' : '' %>>Administrativo</option>
            <% } %>
          </select>
          <% if (isSelf) { %>
            <input type="hidden" name="rol" value="<%= selectedRole %>">
            <small class="form-help form-help-with-icon"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Por seguridad, tu propia cuenta conserva el rol administrativo.</span></small>
          <% } else { %>
            <small class="form-help form-help-with-icon" id="roleHelp"><i class="bi bi-info-circle" aria-hidden="true"></i><span>El rol determina qué módulo principal podrá usar la cuenta.</span></small>
          <% } %>
        </div>
      </div>

      <div class="role-change-note" id="roleChangeNote">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        <span><strong>Importante:</strong> Cambiar el rol modifica el acceso al sistema, pero no elimina citas, triajes, consultas ni historial registrado.</span>
      </div>
    </div>

    <div class="form-section-card role-extra-section" id="pacienteFields" data-role-section="paciente">
      <div class="form-section-heading">
        <h3><i class="bi bi-mortarboard" aria-hidden="true"></i>Ficha de paciente</h3>
        <p>Estos datos universitarios los registra o actualiza el personal administrativo.</p>
      </div>

      <div class="admin-user-form-grid">
        <div class="form-group">
          <label for="codigo_estudiante" class="field-label-with-icon student-field-label">
            <i class="bi bi-person-vcard" aria-hidden="true"></i>
            <span>Código de estudiante</span>
          </label>
          <input type="text" id="codigo_estudiante" name="codigo_estudiante" value="<%= usuario.paciente_codigo_estudiante || '' %>" maxlength="10" inputmode="numeric" data-validate="digits" data-exact-length="10" placeholder="Ejemplo: 2020123001">
          <small class="field-message" data-for="codigo_estudiante"></small>
        </div>

        <div class="form-group">
          <label for="facultad" class="field-label-with-icon student-field-label">
            <i class="bi bi-bank" aria-hidden="true"></i>
            <span>Facultad</span>
          </label>
          <select id="facultad" name="facultad">
            <option value="">Seleccione facultad</option>
            <% if (facultadNoListada) { %>
              <option value="<%= selectedFacultad %>" selected><%= selectedFacultad %> (registro previo)</option>
            <% } %>
            <% Object.keys(facultadesUNT).forEach(function(facultad) { %>
              <option value="<%= facultad %>" <%= selectedFacultad === facultad ? 'selected' : '' %>><%= facultad %></option>
            <% }) %>
          </select>
          <small class="field-message" data-for="facultad"></small>
        </div>

        <div class="form-group">
          <label for="escuela" class="field-label-with-icon student-field-label">
            <i class="bi bi-mortarboard" aria-hidden="true"></i>
            <span>Escuela profesional</span>
          </label>
          <select id="escuela" name="escuela" <%= selectedFacultad ? '' : 'disabled' %>>
            <option value="">Seleccione escuela profesional</option>
            <% if (escuelaNoListada) { %>
              <option value="<%= selectedEscuela %>" selected><%= selectedEscuela %> (registro previo)</option>
            <% } %>
            <% escuelasDeFacultad.forEach(function(escuela) { %>
              <option value="<%= escuela %>" <%= selectedEscuela === escuela ? 'selected' : '' %>><%= escuela %></option>
            <% }) %>
          </select>
          <small class="field-message" data-for="escuela"></small>
        </div>

        <div class="form-group">
          <label for="contexto_universitario" class="field-label-with-icon student-field-label">
            <i class="bi bi-person-workspace" aria-hidden="true"></i>
            <span>Contexto universitario</span>
          </label>
          <select id="contexto_universitario" name="contexto_universitario">
            <option value="">Seleccione</option>
            <% ['Estudiante regular', 'Internado', 'Egresante', 'Estudiante UNT'].forEach(function(contexto) { %>
              <option value="<%= contexto %>" <%= usuario.paciente_contexto_universitario === contexto ? 'selected' : '' %>><%= contexto %></option>
            <% }) %>
          </select>
          <small class="field-message" data-for="contexto_universitario"></small>
        </div>
      </div>
    </div>

    <div class="form-section-card role-extra-section" id="medicoFields" data-role-section="medico">
      <div class="form-section-heading">
        <h3><i class="bi bi-person-badge" aria-hidden="true"></i>Ficha de médico</h3>
        <p>Estos campos son obligatorios solo cuando el rol seleccionado es Médico.</p>
      </div>

      <div class="admin-user-form-grid">
        <div class="form-group">
          <label for="especialidad" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-stethoscope"></use></svg>
            <span>Especialidad</span>
          </label>
          <select id="especialidad" name="especialidad">
            <option value="">Seleccione</option>
            <% especialidades.forEach(function(especialidad) { %>
              <option value="<%= especialidad %>" <%= usuario.medico_especialidad === especialidad ? 'selected' : '' %>><%= especialidad %></option>
            <% }) %>
          </select>
          <small class="field-message" data-for="especialidad"></small>
        </div>

        <div class="form-group">
          <label for="numero_colegiatura" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-note"></use></svg>
            <span>Número de colegiatura</span>
          </label>
          <input type="text" id="numero_colegiatura" name="numero_colegiatura" value="<%= usuario.medico_colegiatura || '' %>" maxlength="10" inputmode="numeric" data-validate="digits" data-min-length="3" placeholder="Ejemplo: 10005">
          <small class="field-message" data-for="numero_colegiatura"></small>
        </div>

        <div class="form-group">
          <label for="turno_medico" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-clock"></use></svg>
            <span>Turno</span>
          </label>
          <select id="turno_medico" name="turno_medico">
            <option value="">Seleccione</option>
            <% turnos.forEach(function(turno) { %>
              <option value="<%= turno.value %>" <%= usuario.medico_turno === turno.value ? 'selected' : '' %>><%= turno.label %></option>
            <% }) %>
          </select>
          <small class="field-message" data-for="turno_medico"></small>
        </div>
      </div>
    </div>

    <div class="form-section-card role-extra-section" id="enfermeraFields" data-role-section="enfermera">
      <div class="form-section-heading">
        <h3><i class="bi bi-heart-pulse" aria-hidden="true"></i>Ficha de enfermería</h3>
        <p>Estos campos son obligatorios solo cuando el rol seleccionado es Enfermera.</p>
      </div>

      <div class="admin-user-form-grid">
        <div class="form-group">
          <label for="area_visual" class="field-label-with-icon nursing-area-label">
            <i class="bi bi-hospital" aria-hidden="true"></i>
            <span>Área de trabajo</span>
          </label>
          <input type="text" id="area_visual" value="Triaje" readonly aria-describedby="areaHelp">
          <input type="hidden" id="area" name="area" value="Triaje">
          <small class="form-help form-help-with-icon" id="areaHelp"><i class="bi bi-info-circle" aria-hidden="true"></i><span>El sistema asigna a las enfermeras al área de triaje.</span></small>
        </div>

        <div class="form-group">
          <label for="turno_enfermera" class="field-label-with-icon">
            <svg class="field-icon" aria-hidden="true"><use href="#field-icon-clock"></use></svg>
            <span>Turno</span>
          </label>
          <select id="turno_enfermera" name="turno_enfermera">
            <option value="">Seleccione</option>
            <% turnos.forEach(function(turno) { %>
              <option value="<%= turno.value %>" <%= usuario.enfermera_turno === turno.value ? 'selected' : '' %>><%= turno.label %></option>
            <% }) %>
          </select>
          <small class="field-message" data-for="turno_enfermera"></small>
        </div>
      </div>
    </div>

    <div class="form-section-card role-extra-section" id="administrativoFields" data-role-section="administrativo">
      <div class="form-section-heading">
        <h3><i class="bi bi-briefcase" aria-hidden="true"></i>Ficha administrativa</h3>
        <p>Define el área operativa de la cuenta administrativa.</p>
      </div>

      <div class="admin-user-form-grid">
        <div class="form-group">
          <label for="cargo" class="field-label-with-icon nursing-area-label">
            <i class="bi bi-building" aria-hidden="true"></i>
            <span>Área administrativa</span>
          </label>
          <select id="cargo" name="cargo">
            <option value="">Seleccione área administrativa</option>
            <% if (cargoNoListado) { %>
              <option value="<%= selectedCargo %>" selected><%= selectedCargo %></option>
            <% } %>
            <% cargosAdministrativos.forEach(function(cargo) { %>
              <option value="<%= cargo %>" <%= selectedCargo === cargo ? 'selected' : '' %>><%= cargo %></option>
            <% }) %>
          </select>
          <small class="field-message" data-for="cargo"></small>
        </div>

      </div>
    </div>

    <div class="form-actions admin-user-form-actions">
      <a href="<%= backUrl %>" class="btn-light" title="Cancelar" aria-label="Cancelar y volver a usuarios">
        <img class="action-metaphor" src="/img/action-metaphors/administrador/usuarios/cancelar.png" alt="" aria-hidden="true">
        <span>Cancelar</span>
      </a>

      <button type="submit" class="btn-dark icon-action" title="<%= isEdit ? 'Actualizar usuario' : 'Registrar usuario' %>" aria-label="<%= isEdit ? 'Actualizar usuario' : 'Registrar usuario' %>">
        <img class="action-metaphor" src="/img/action-metaphors/administrador/usuarios/<%= isEdit ? 'editar.png' : 'registrar.png' %>" alt="" aria-hidden="true">
        <span><%= isEdit ? 'Actualizar usuario' : 'Registrar usuario' %></span>
      </button>
    </div>
  </form>
</div>

<script>
  const roleSelect = document.getElementById('rol');
  const adminUserForm = document.getElementById('adminUserForm');
  const passwordInput = document.getElementById('password');
  const roleSections = document.querySelectorAll('[data-role-section]');
  const fechaNacimientoInput = document.getElementById('fecha_nacimiento');
  const roleHelp = document.getElementById('roleHelp');
  const roleChangeNote = document.getElementById('roleChangeNote');
  const facultadSelect = document.getElementById('facultad');
  const escuelaSelect = document.getElementById('escuela');
  const adminPasswordStrength = document.getElementById('adminPasswordStrength');
  const academicCatalog = <%- JSON.stringify(catalogoAcademico || {}).replace(/</g, '\\u003c') %>;

  const roleHelpText = {
    paciente: 'Paciente: podrá reservar citas, revisar historial y ver los datos universitarios registrados por administración.',
    medico: 'Médico: podrá atender citas, consultar pacientes y registrar atenciones médicas.',
    enfermera: 'Enfermera: podrá registrar triaje y revisar datos clínicos previos.',
    administrativo: 'Administrativo: realizará tareas de Admisión o Gestión de usuarios según el área asignada. Solo el administrador principal puede crear y gestionar cuentas administrativas.'
  };

  if (fechaNacimientoInput) {
    const hoy = new Date();
    fechaNacimientoInput.max = `${hoy.getFullYear() - 1}-12-31`;
  }

  function setSectionEnabled(section, enabled) {
    section.classList.toggle('hidden', !enabled);

    section.querySelectorAll('input, select').forEach(field => {
      field.disabled = !enabled;
      field.required = enabled && field.type !== 'hidden' && !field.readOnly;
    });
  }

  function updateSchoolOptions(resetSelection = false) {
    if (!facultadSelect || !escuelaSelect) return;

    const selectedFaculty = facultadSelect.value;
    const selectedSchool = resetSelection ? '' : escuelaSelect.value;
    const schools = academicCatalog[selectedFaculty] || [];

    escuelaSelect.innerHTML = '<option value="">Seleccione escuela profesional</option>';
    schools.forEach(school => {
      const option = document.createElement('option');
      option.value = school;
      option.textContent = school;
      option.selected = school === selectedSchool;
      escuelaSelect.appendChild(option);
    });

    escuelaSelect.disabled = !selectedFaculty || schools.length === 0;
  }

  function passwordScore(value) {
    return [
      value.length >= 8,
      /[A-Z]/.test(value),
      /[a-z]/.test(value),
      /\d/.test(value),
      /[^A-Za-z0-9]/.test(value)
    ].filter(Boolean).length;
  }

  function updatePasswordStrength() {
    if (!passwordInput || !adminPasswordStrength) return;

    const score = passwordScore(passwordInput.value);
    const labels = ['sin evaluar', 'muy débil', 'débil', 'media', 'buena', 'fuerte'];
    const state = score >= 5 ? 'strong' : score >= 4 ? 'good' : score >= 3 ? 'medium' : 'weak';

    adminPasswordStrength.dataset.strength = passwordInput.value ? state : 'empty';
    adminPasswordStrength.querySelector('p').textContent = `Seguridad: ${passwordInput.value ? labels[score] : labels[0]}`;
  }

  function updateRoleSections() {
    const selectedRole = roleSelect ? roleSelect.value : '<%= selectedRole %>';

    roleSections.forEach(section => {
      setSectionEnabled(section, section.dataset.roleSection === selectedRole);
    });

    if (roleHelp) {
      const roleHelpTextNode = roleHelp.querySelector('span');
      if (roleHelpTextNode) {
        roleHelpTextNode.textContent = roleHelpText[selectedRole] || 'El rol determina qué módulo principal podrá usar la cuenta.';
      }
    }

    if (roleChangeNote) {
      roleChangeNote.classList.toggle('is-warning', selectedRole === 'administrativo');
      roleChangeNote.innerHTML = selectedRole === 'administrativo'
        ? '<i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span><strong>Atención:</strong> La cuenta será administrativa operativa. No podrá crear, editar ni cambiar el estado de cuentas administrativas.</span>'
        : '<i class="bi bi-info-circle" aria-hidden="true"></i><span><strong>Importante:</strong> Cambiar el rol modifica el acceso al sistema, pero no elimina citas, triajes, consultas ni historial registrado.</span>';
    }

    if (selectedRole === 'paciente') updateSchoolOptions();
  }

  if (roleSelect) {
    roleSelect.addEventListener('change', updateRoleSections);
  }

  if (facultadSelect) {
    facultadSelect.addEventListener('change', () => updateSchoolOptions(true));
  }

  if (passwordInput) {
    passwordInput.addEventListener('input', updatePasswordStrength);
  }

  updateRoleSections();
  updatePasswordStrength();

  if (adminUserForm) {
    adminUserForm.addEventListener('submit', () => {
      const originalRole = adminUserForm.dataset.originalRole || '';
      const selectedRole = roleSelect ? roleSelect.value : originalRole;
      const changes = [];

      if (originalRole && selectedRole && originalRole !== selectedRole) {
        changes.push(`cambio de rol de ${originalRole} a ${selectedRole}`);
      }

      if (passwordInput && passwordInput.value.trim()) {
        changes.push('cambio de contraseña de acceso');
      }

      if (selectedRole === 'administrativo') {
        changes.push('acceso administrativo a usuarios y citas');
      }

      const details = changes.length
        ? `Detectado: ${changes.join(', ')}. `
        : '';

      adminUserForm.dataset.confirmTitle = 'Guardar usuario';
      adminUserForm.dataset.confirm = `${details}Confirma solo si los datos personales, correo, rol y ficha del usuario son correctos.`;
      adminUserForm.dataset.confirmButton = 'Guardar usuario';
    }, true);
  }
</script>
<script src="/js/role-validations.js"></script>
