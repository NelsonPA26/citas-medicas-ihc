<%
  const values = typeof old !== 'undefined' ? old : {};
  const rawTitle = typeof title !== 'undefined' ? title.toLowerCase() : '';
  const type = typeof tipoPersonal !== 'undefined'
    ? tipoPersonal
    : rawTitle.includes('enfer') ? 'enfermera' : 'medico';
  const isEdit = typeof modoEdicion !== 'undefined' && modoEdicion;
  const defaultAction = type === 'enfermera' ? '/admin/enfermeras/nuevo' : '/admin/medicos/nuevo';
  const action = typeof formAction !== 'undefined' ? formAction : defaultAction;
  const returnUrl = type === 'enfermera' ? '/admin/enfermeras' : '/admin/medicos';
  const roleLabel = type === 'enfermera' ? 'enfermera' : 'medico';
%>

<div class="module-card admin-form-card personal-form-card">
  <div class="module-header">
    <!-- H4/H8: la cabecera global ya contiene el titulo; aqui solo se da contexto breve y necesario. -->
    <p>
      <%= isEdit
        ? `Actualiza los datos operativos y de contacto del ${roleLabel}.`
        : `Completa la informacion del ${roleLabel} que tendra acceso al sistema.` %>
    </p>
  </div>

  <% if (typeof formError !== 'undefined' && formError) { %>
    <div class="step-message"><%= formError %></div>
  <% } %>

  <!-- H5: un unico formulario reusable reduce inconsistencias entre registrar y editar. -->
  <form action="<%= action %>" method="POST" class="admin-form js-admin-person-form" novalidate>
    <div class="step-message hidden js-form-message"></div>

    <section class="form-section">
      <h3>Datos personales</h3>

      <!-- H4/H8: grid por grupos relacionados para lectura rapida y layout consistente. -->
      <div class="admin-form-grid three-columns">
        <div class="form-group">
          <label for="nombres">Nombres</label>
          <input type="text" id="nombres" name="nombres" value="<%= values.nombres || '' %>" data-validate="letters" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ ]{2,80}" minlength="2" maxlength="80" autocomplete="given-name" required>
          <small class="field-message" data-for="nombres"></small>
        </div>

        <div class="form-group">
          <label for="apellido_paterno">Apellido paterno</label>
          <input type="text" id="apellido_paterno" name="apellido_paterno" value="<%= values.apellido_paterno || '' %>" data-validate="letters" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ ]{2,80}" minlength="2" maxlength="80" autocomplete="family-name" required>
          <small class="field-message" data-for="apellido_paterno"></small>
        </div>

        <div class="form-group">
          <label for="apellido_materno">Apellido materno</label>
          <input type="text" id="apellido_materno" name="apellido_materno" value="<%= values.apellido_materno || '' %>" data-validate="letters" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ ]{0,80}" maxlength="80" autocomplete="additional-name">
          <small class="field-message" data-for="apellido_materno"></small>
        </div>
      </div>

      <div class="admin-form-grid three-columns">
        <div class="form-group">
          <label for="dni">DNI</label>
          <!-- H5: readonly en edicion evita romper identificadores auditables y relaciones historicas. -->
          <input type="text" id="dni" name="dni" value="<%= values.dni || '' %>" data-validate="digits" pattern="[0-9]{8}" inputmode="numeric" maxlength="8" autocomplete="off" required>
          <small class="field-message" data-for="dni"></small>
        </div>

        <div class="form-group">
          <label for="fecha_nacimiento">Fecha de nacimiento</label>
          <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" value="<%= values.fecha_nacimiento || '' %>" required>
          <small class="field-message" data-for="fecha_nacimiento"></small>
        </div>

        <div class="form-group">
          <label for="sexo">Sexo</label>
          <select id="sexo" name="sexo" required>
            <option value="">Seleccione</option>
            <option value="Masculino" <%= values.sexo === 'Masculino' ? 'selected' : '' %>>Masculino</option>
            <option value="Femenino" <%= values.sexo === 'Femenino' ? 'selected' : '' %>>Femenino</option>
            <option value="Otro" <%= values.sexo === 'Otro' ? 'selected' : '' %>>Otro</option>
            <option value="No especifica" <%= values.sexo === 'No especifica' ? 'selected' : '' %>>No especifica</option>
          </select>
          <small class="field-message" data-for="sexo"></small>
        </div>
      </div>
    </section>

    <section class="form-section">
      <h3>Contacto</h3>

      <div class="admin-form-grid three-columns">
        <div class="form-group">
          <label for="correo">Correo de acceso</label>
          <!-- H5: readonly en edicion evita romper credenciales UNIQUE en usuario/persona. -->
          <input type="email" id="correo" name="correo" value="<%= values.correo || '' %>" data-validate="email" maxlength="120" autocomplete="email" required>
          <small class="field-message" data-for="correo"></small>
          <small class="form-help"><%= isEdit ? 'Si cambias el correo, también se actualizará el usuario de acceso.' : 'Este correo sera usado como usuario de acceso.' %></small>
        </div>

        <div class="form-group">
          <label for="telefono">Telefono</label>
          <input type="tel" id="telefono" name="telefono" value="<%= values.telefono || '' %>" data-validate="digits" pattern="[0-9]{7,15}" inputmode="numeric" maxlength="15" autocomplete="tel" required>
          <small class="field-message" data-for="telefono"></small>
        </div>

        <div class="form-group">
          <label for="direccion">Direccion</label>
          <input type="text" id="direccion" name="direccion" value="<%= values.direccion || '' %>" maxlength="150" autocomplete="street-address">
          <small class="field-message" data-for="direccion"></small>
        </div>
      </div>
    </section>

    <section class="form-section">
      <h3><%= type === 'enfermera' ? 'Datos de enfermeria' : 'Datos profesionales' %></h3>

      <% if (type === 'enfermera') { %>
        <div class="admin-form-grid three-columns">
          <div class="form-group">
            <label for="area">Area</label>
            <input type="text" id="area" name="area" value="<%= values.area || 'Triaje' %>" data-validate="letters" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ ]{2,80}" minlength="2" maxlength="80" required>
            <small class="field-message" data-for="area"></small>
          </div>

          <div class="form-group">
            <label for="turno">Turno</label>
            <select id="turno" name="turno" required>
              <option value="">Seleccione</option>
              <option value="mañana" <%= values.turno === 'mañana' ? 'selected' : '' %>>Manana</option>
              <option value="tarde" <%= values.turno === 'tarde' ? 'selected' : '' %>>Tarde</option>
              <option value="completo" <%= values.turno === 'completo' ? 'selected' : '' %>>Completo</option>
            </select>
            <small class="field-message" data-for="turno"></small>
          </div>

          <div class="form-group form-spacer" aria-hidden="true"></div>
        </div>
      <% } else { %>
        <div class="admin-form-grid three-columns">
          <div class="form-group">
            <label for="especialidad">Especialidad</label>
            <select id="especialidad" name="especialidad" required>
              <option value="">Seleccione</option>
              <option value="Medicina General" <%= values.especialidad === 'Medicina General' || values.especialidad === 'Medicina general' ? 'selected' : '' %>>Medicina General</option>
              <option value="Odontología" <%= values.especialidad === 'Odontología' ? 'selected' : '' %>>Odontología</option>
              <option value="Psicología" <%= values.especialidad === 'Psicología' ? 'selected' : '' %>>Psicología</option>
            </select>
            <small class="field-message" data-for="especialidad"></small>
          </div>

          <div class="form-group">
            <label for="numero_colegiatura">Numero de colegiatura</label>
            <input type="text" id="numero_colegiatura" name="numero_colegiatura" value="<%= values.numero_colegiatura || '' %>" data-validate="code" pattern="[A-Za-z0-9-]{3,30}" maxlength="30" required>
            <small class="field-message" data-for="numero_colegiatura"></small>
          </div>

          <div class="form-group">
            <label for="turno">Turno</label>
            <select id="turno" name="turno" required>
              <option value="">Seleccione</option>
              <option value="mañana" <%= values.turno === 'mañana' ? 'selected' : '' %>>Manana</option>
              <option value="tarde" <%= values.turno === 'tarde' ? 'selected' : '' %>>Tarde</option>
              <option value="completo" <%= values.turno === 'completo' ? 'selected' : '' %>>Completo</option>
            </select>
            <small class="field-message" data-for="turno"></small>
          </div>
        </div>
      <% } %>
    </section>

    <% if (!isEdit) { %>
      <div class="notice-box">
        La cuenta sera creada con contrasena temporal <strong>123456</strong> y debera cambiarla desde su perfil.
      </div>
    <% } %>

    <div class="form-actions">
      <a href="<%= returnUrl %>" class="btn-light">Cancelar</a>
      <button type="submit" class="btn-dark"><%= isEdit ? 'Actualizar' : 'Registrar' %></button>
    </div>
  </form>
</div>

<script src="/js/admin-forms.js"></script>
