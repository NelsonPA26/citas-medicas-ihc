<div class="module-card usuarios-card">
  <div class="module-header module-header-row">
    <div>
      <p>Consulta los médicos registrados en el sistema.</p>
    </div>

    <a href="/admin/medicos/nuevo" class="btn-dark btn-header-action icon-action" title="Registrar médico" aria-label="Registrar médico">
      <img class="action-metaphor" src="/img/action-metaphors/administrador/medicos/registrar.png" alt="" aria-hidden="true">
      <span class="visually-hidden">Registrar médico</span>
    </a>
  </div>
    <form action="/admin/medicos" method="GET" class="filter-card">
    <div class="filter-grid two-columns">
      <div class="form-group">
        <label for="q" class="field-label-with-icon">
          <svg class="field-icon" aria-hidden="true"><use href="#field-icon-search"></use></svg>
          <span>Buscar</span>
        </label>
        <input
          type="text"
          id="q"
          name="q"
          value="<%= filters?.q || '' %>"
          placeholder="Nombre, DNI, correo o colegiatura"
        >
      </div>
    </div>

    <div class="filter-actions">
      <a href="/admin/medicos" class="btn-light icon-action" title="Limpiar filtros" aria-label="Limpiar filtros">
        <img class="action-metaphor" src="/img/action-metaphors/administrador/medicos/limpiar.png" alt="" aria-hidden="true">
        <span class="visually-hidden">Limpiar filtros</span>
      </a>
      <button type="submit" class="btn-dark icon-action" title="Filtrar" aria-label="Filtrar">
        <img class="action-metaphor" src="/img/action-metaphors/administrador/medicos/filtrar.png" alt="" aria-hidden="true">
        <span class="visually-hidden">Filtrar</span>
      </button>
    </div>
  </form>
  <% if (medicos.length === 0) { %>
    <div class="empty-state">
      <h3>No hay médicos registrados</h3>
      <p>Registra médicos para que los pacientes puedan reservar citas.</p>
      <a href="/admin/medicos/nuevo" class="btn-dark icon-action" title="Registrar médico" aria-label="Registrar médico">
        <img class="action-metaphor" src="/img/action-metaphors/administrador/medicos/registrar.png" alt="" aria-hidden="true">
        <span class="visually-hidden">Registrar médico</span>
      </a>
    </div>
  <% } else { %>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Médico</th>
            <th>DNI</th>
            <th>Correo</th>
            <th>Especialidad</th>
            <th>Colegiatura</th>
            <th>Turno</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% medicos.forEach(medico => { %>
            <tr>
              <td>
                <strong>
                  Dr(a). <%= medico.nombres %>
                  <%= medico.apellido_paterno %>
                  <%= medico.apellido_materno || '' %>
                </strong>
                <br>
                <span class="text-muted">@<%= medico.username %></span>
              </td>

              <td><%= medico.dni || 'No registrado' %></td>
              <td><%= medico.correo %></td>
              <td><%= medico.especialidad %></td>
              <td><%= medico.numero_colegiatura || 'No registrado' %></td>
              <td class="capitalize"><%= medico.turno %></td>

              <td>
                <% if (medico.activo === 1) { %>
                  <span class="status-badge status-activo">Activo</span>
                <% } else { %>
                  <span class="status-badge status-inactivo">Inactivo</span>
                <% } %>
              </td>

              <td>
                <div class="table-actions">
                  <a
                    class="btn-light btn-table-action icon-action"
                    href="/admin/medicos/<%= medico.id_medico %>/editar"
                    title="Editar médico"
                    aria-label="Editar médico"
                  >
                    <img class="action-metaphor" src="/img/action-metaphors/administrador/medicos/editar.png" alt="" aria-hidden="true">
                    <span class="visually-hidden">Editar</span>
                  </a>

                  <form
                    action="/admin/medicos/<%= medico.id_medico %>/estado"
                    method="POST"
                    data-confirm-title="<%= medico.activo === 1 ? 'Desactivar médico' : 'Activar médico' %>"
                    data-confirm="<%= medico.activo === 1 ? 'El médico no podrá acceder ni atender nuevas citas mientras esté desactivado.' : 'El médico recuperará el acceso operativo al sistema.' %>"
                    data-confirm-button="<%= medico.activo === 1 ? 'Desactivar' : 'Activar' %>"
                  >
                    <input type="hidden" name="accion" value="<%= medico.activo === 1 ? 'desactivar' : 'activar' %>">
                    <button type="submit" class="<%= medico.activo === 1 ? 'btn-cancel' : 'btn-activate' %> btn-table-action icon-action" title="<%= medico.activo === 1 ? 'Desactivar médico' : 'Activar médico' %>" aria-label="<%= medico.activo === 1 ? 'Desactivar médico' : 'Activar médico' %>">
                      <img class="action-metaphor" src="/img/action-metaphors/administrador/medicos/<%= medico.activo === 1 ? 'desactivar.png' : 'activar.png' %>" alt="" aria-hidden="true">
                      <span class="visually-hidden"><%= medico.activo === 1 ? 'Desactivar' : 'Activar' %></span>
                    </button>
                  </form>

                                    <% if (Number(medico.registros_asociados || 0) === 0) { %>
                    <form
                      action="/admin/medicos/<%= medico.id_medico %>/eliminar"
                      method="POST"
                      data-confirm-title="Eliminar ficha profesional"
                      data-confirm="Este médico no tiene citas asociadas. Se eliminará su ficha y su cuenta de acceso."
                      data-confirm-button="Eliminar"
                    >
                      <button type="submit" class="btn-danger btn-table-action icon-action" title="Eliminar médico" aria-label="Eliminar médico">
                        <img class="action-metaphor" src="/img/action-metaphors/administrador/medicos/eliminar.png" alt="" aria-hidden="true">
                        <span class="visually-hidden">Eliminar</span>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  <% } %>
</div>
