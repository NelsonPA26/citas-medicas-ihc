<div class="module-card usuarios-card">
  <div class="module-header module-header-row">
    <div>
      <p>Consulta los médicos registrados en el sistema.</p>
    </div>

    <a href="/admin/medicos/nuevo" class="btn-dark btn-header-action">
      Registrar médico
    </a>
  </div>
    <form action="/admin/medicos" method="GET" class="filter-card">
    <div class="filter-grid two-columns">
      <div class="form-group">
        <label for="q">Buscar</label>
        <input
          type="text"
          id="q"
          name="q"
          value="<%= filters?.q || '' %>"
          placeholder="Nombre, DNI, correo o colegiatura"
        >
      </div>
    </div>

    <div class="filter-actions">
      <a href="/admin/medicos" class="btn-light">Limpiar filtros</a>
      <button type="submit" class="btn-dark">Filtrar</button>
    </div>
  </form>
  <% if (medicos.length === 0) { %>
    <div class="empty-state">
      <h3>No hay médicos registrados</h3>
      <p>Registra médicos para que los pacientes puedan reservar citas.</p>
      <a href="/admin/medicos/nuevo" class="btn-dark">Registrar médico</a>
    </div>
  <% } else { %>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Médico</th>
            <th>DNI</th>
            <th>Correo</th>
            <th>Especialidad</th>
            <th>Colegiatura</th>
            <th>Turno</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% medicos.forEach(medico => { %>
            <tr>
              <td>
                <strong>
                  Dr(a). <%= medico.nombres %>
                  <%= medico.apellido_paterno %>
                  <%= medico.apellido_materno || '' %>
                </strong>
                <br>
                <span class="text-muted">@<%= medico.username %></span>
              </td>

              <td><%= medico.dni || 'No registrado' %></td>
              <td><%= medico.correo %></td>
              <td><%= medico.especialidad %></td>
              <td><%= medico.numero_colegiatura || 'No registrado' %></td>
              <td class="capitalize"><%= medico.turno %></td>

              <td>
                <% if (medico.activo === 1) { %>
                  <span class="status-badge status-activo">Activo</span>
                <% } else { %>
                  <span class="status-badge status-inactivo">Inactivo</span>
                <% } %>
              </td>

              <td>
                <div class="table-actions">
                  <a
                    class="btn-light btn-table-action"
                    href="/admin/medicos/<%= medico.id_medico %>/editar"
                  >
                    Editar
                  </a>

                  <form
                    action="/admin/medicos/<%= medico.id_medico %>/estado"
                    method="POST"
                    data-confirm-title="<%= medico.activo === 1 ? 'Desactivar medico' : 'Activar medico' %>"
                    data-confirm="<%= medico.activo === 1 ? 'El medico no podra acceder ni atender nuevas citas mientras este desactivado.' : 'El medico recuperara el acceso operativo al sistema.' %>"
                    data-confirm-button="<%= medico.activo === 1 ? 'Desactivar' : 'Activar' %>"
                  >
                    <input type="hidden" name="accion" value="<%= medico.activo === 1 ? 'desactivar' : 'activar' %>">
                    <button type="submit" class="<%= medico.activo === 1 ? 'btn-cancel' : 'btn-activate' %> btn-table-action">
                      <%= medico.activo === 1 ? 'Desactivar' : 'Activar' %>
                    </button>
                  </form>

                                    <% if (Number(medico.registros_asociados || 0) === 0) { %>
                    <form
                      action="/admin/medicos/<%= medico.id_medico %>/eliminar"
                      method="POST"
                      data-confirm-title="Eliminar ficha profesional"
                      data-confirm="Este médico no tiene citas asociadas. Se eliminará su ficha y su cuenta de acceso."
                      data-confirm-button="Eliminar"
                    >
                      <button type="submit" class="btn-danger btn-table-action">Eliminar</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  <% } %>
</div>
