<div class="auth-card login-card">
  <h2>Nueva contraseña</h2>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <p class="auth-description">
    Crea una nueva contraseña para recuperar el acceso a tu cuenta.
  </p>

  <form action="/reset-password/<%= token %>" method="POST" class="auth-form" id="resetPasswordForm">
    <div id="resetMessage" class="step-message hidden"></div>

    <div class="form-group">
      <label for="new_password">Nueva contraseña</label>
      <input 
         type="password"
          id="new_password"
          name="new_password"
          minlength="8"
          required
      >
      <small class="form-help">Debe tener mínimo 8 caracteres, una mayúscula, una minúscula, un número y un símbolo.</small>
    </div>

    <div class="form-group">
      <label for="confirm_password">Confirmar contraseña</label>
      <input 
        type="password" 
        id="confirm_password" 
        name="confirm_password" 
        required
      >
    </div>

    <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
  </form>

  <a href="/login" class="auth-link center-link">Volver al inicio de sesión</a>
</div>

<script>
  const resetPasswordForm = document.getElementById('resetPasswordForm');
  const resetMessage = document.getElementById('resetMessage');

  const newPasswordInput = document.getElementById('new_password');
  const confirmPasswordInput = document.getElementById('confirm_password');

  function showResetMessage(message, field = null) {
    resetMessage.textContent = message;
    resetMessage.classList.remove('hidden');

    document.querySelectorAll('.field-error').forEach(input => {
      input.classList.remove('field-error');
    });

    if (field) {
      field.classList.add('field-error');
      field.focus();
    }
  }

  function clearResetMessage() {
    resetMessage.textContent = '';
    resetMessage.classList.add('hidden');

    document.querySelectorAll('.field-error').forEach(input => {
      input.classList.remove('field-error');
    });
  }

  [newPasswordInput, confirmPasswordInput].forEach(input => {
    input.addEventListener('input', clearResetMessage);
  });

  resetPasswordForm.addEventListener('submit', (event) => {
    if (newPasswordInput.value.length < 6) {
      event.preventDefault();
      showResetMessage('La nueva contraseña debe tener al menos 6 caracteres.', newPasswordInput);
      return;
    }

    if (newPasswordInput.value !== confirmPasswordInput.value) {
      event.preventDefault();
      showResetMessage('Las contraseñas no coinciden.', confirmPasswordInput);
      return;
    }
  });
</script>