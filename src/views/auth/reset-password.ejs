<div class="auth-card login-card">
  <h2>Nueva contraseña</h2>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <p class="auth-description">
    Crea una nueva contraseña para recuperar el acceso a tu cuenta.
  </p>

  <form action="/reset-password/<%= token %>" method="POST" class="auth-form js-auth-validated-form" id="resetPasswordForm" novalidate>
    <div id="resetMessage" class="step-message hidden"></div>

    <div class="form-group">
      <label for="new_password">Nueva contraseña</label>
      <input 
         type="password"
          id="new_password"
          name="new_password"
          minlength="8"
          data-validate="strong-password"
          autocomplete="new-password"
          required
      >
      <small class="form-help">Debe tener mínimo 8 caracteres, una mayúscula, una minúscula, un número y un símbolo.</small>
      <small class="field-message" data-for="new_password"></small>
    </div>

    <div class="form-group">
      <label for="confirm_password">Confirmar contraseña</label>
      <input 
        type="password" 
        id="confirm_password" 
        name="confirm_password" 
        data-validate="password-confirm"
        data-match="new_password"
        autocomplete="new-password"
        required
      >
      <small class="field-message" data-for="confirm_password"></small>
    </div>

    <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
  </form>

  <a href="/login" class="auth-link center-link">Volver al inicio de sesión</a>
</div>

<script>
  const resetPasswordForm = document.getElementById('resetPasswordForm');
  const resetMessage = document.getElementById('resetMessage');

  const newPasswordInput = document.getElementById('new_password');
  const confirmPasswordInput = document.getElementById('confirm_password');

  function showResetMessage(message, field = null) {
    resetMessage.textContent = '';
    resetMessage.classList.add('hidden');

    document.querySelectorAll('.field-error').forEach(input => {
      input.classList.remove('field-error');
    });

    if (field) {
      field.classList.add('field-error');
      field.setAttribute('aria-invalid', 'true');
      const target = resetPasswordForm.querySelector(`.field-message[data-for="${field.id}"]`);
      if (target) {
        target.textContent = message;
        target.classList.add('is-visible');
      }
      field.focus();
    }
  }

  function clearResetMessage() {
    resetMessage.textContent = '';
    resetMessage.classList.add('hidden');

    document.querySelectorAll('.field-error').forEach(input => {
      input.classList.remove('field-error');
      input.setAttribute('aria-invalid', 'false');
    });

    resetPasswordForm.querySelectorAll('.field-message').forEach(target => {
      target.textContent = '';
      target.classList.remove('is-visible');
    });
  }

  [newPasswordInput, confirmPasswordInput].forEach(input => {
    input.addEventListener('input', clearResetMessage);
  });

  function isStrongPassword(value) {
    return value.length >= 8
      && /[A-Z]/.test(value)
      && /[a-z]/.test(value)
      && /\d/.test(value)
      && /[^A-Za-z0-9]/.test(value);
  }

  resetPasswordForm.addEventListener('submit', (event) => {
    if (!isStrongPassword(newPasswordInput.value)) {
      event.preventDefault();
      showResetMessage('La nueva contraseña debe tener mínimo 8 caracteres, una mayúscula, una minúscula, un número y un símbolo.', newPasswordInput);
      return;
    }

    if (newPasswordInput.value !== confirmPasswordInput.value) {
      event.preventDefault();
      showResetMessage('Las contraseñas no coinciden.', confirmPasswordInput);
      return;
    }
  });
</script>
