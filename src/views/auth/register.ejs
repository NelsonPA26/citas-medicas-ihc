<div class="auth-card register-card">
  <h2>Registro</h2>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/register" method="POST" class="auth-form js-auth-validated-form" novalidate>
    <div class="form-group">
      <label for="nombres">Nombre</label>
      <input type="text" id="nombres" name="nombres" value="<%= old.nombres || '' %>" minlength="2" maxlength="80" data-validate="personal-name" autocomplete="given-name" required>
      <small class="field-message" data-for="nombres"></small>
    </div>

    <div class="form-group">
      <label for="apellido_paterno">Apellido Paterno</label>
      <input type="text" id="apellido_paterno" name="apellido_paterno" value="<%= old.apellido_paterno || '' %>" minlength="2" maxlength="80" data-validate="personal-name" autocomplete="family-name" required>
      <small class="field-message" data-for="apellido_paterno"></small>
    </div>

    <div class="form-group">
      <label for="apellido_materno">Apellido Materno</label>
      <input type="text" id="apellido_materno" name="apellido_materno" value="<%= old.apellido_materno || '' %>" maxlength="80" data-validate="personal-name" autocomplete="additional-name">
      <small class="field-message" data-for="apellido_materno"></small>
    </div>

    <div class="form-group">
      <label for="dni">DNI</label>
      <input type="text" id="dni" name="dni" inputmode="numeric" maxlength="8" data-validate="dni" value="<%= old.dni || '' %>" autocomplete="off" required>
      <small class="field-message" data-for="dni"></small>
    </div>

    <div class="form-group">
      <label for="correo">Correo Electrónico</label>
      <input type="email" id="correo" name="correo" value="<%= old.correo || '' %>" maxlength="120" data-validate="email" autocomplete="email" required>
      <small class="field-message" data-for="correo"></small>
    </div>

    <div class="form-group">
      <label for="telefono">Número Telefónico</label>
      <input type="text" id="telefono" name="telefono" value="<%= old.telefono || '' %>" inputmode="numeric" maxlength="11" data-validate="phone-pe" autocomplete="tel" placeholder="987 654 321" required>
      <small class="field-message" data-for="telefono"></small>
    </div>

    <div class="form-group">
      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" minlength="8" data-validate="strong-password" autocomplete="new-password" required>
      <small class="form-help">Mínimo 8 caracteres, una mayúscula, una minúscula, un número y un símbolo.</small>
      <div class="password-strength auth-password-strength" data-password-strength-for="password" aria-live="polite">
        <span></span>
        <p>Seguridad: sin evaluar</p>
      </div>
      <small class="field-message" data-for="password"></small>
    </div>

    <div class="form-group">
      <label for="confirm_password">Repetir Contraseña</label>
      <input type="password" id="confirm_password" name="confirm_password" minlength="8" data-validate="password-confirm" data-match="password" autocomplete="new-password" required>
      <small class="field-message" data-for="confirm_password"></small>
    </div>

    <button type="submit" class="btn btn-primary">Crear Cuenta</button>
  </form>

  <a href="/login" class="auth-link center-link">Ya tengo una cuenta</a>
</div>
