<div class="auth-card login-card">
  <h2>Recuperar contraseña</h2>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <p class="auth-description">
    Ingresa tu correo o usuario. Si la cuenta existe, se generará un enlace temporal para restablecer la contraseña.
  </p>

  <form action="/forgot-password" method="POST" class="auth-form">
    <div class="form-group">
      <label for="identificador">Correo o usuario</label>
      <input 
        type="text" 
        id="identificador" 
        name="identificador" 
        placeholder="ejemplo@unt.edu.pe"
        required
      >
    </div>

    <button type="submit" class="btn btn-primary">Continuar</button>
  </form>

  <a href="/login" class="auth-link center-link">Volver al inicio de sesión</a>
</div>