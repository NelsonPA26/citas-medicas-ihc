<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Sistema de Citas Médicas' %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="dashboard-body">

  <%
    const icons = {
      inicio: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M3 10.5L12 3l9 7.5V21a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>',

      reservar: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><rect x="4" y="5" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 3v4M16 3v4M4 9h16M12 12.5v5M9.5 15h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',

      citas: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><rect x="4" y="5" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 3v4M16 3v4M4 9h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01M16 17h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>',

      historial: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 1 0 2.35-5.65" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M4 5.5v4h4M12 8v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',

      antecedentes: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M9 5h6M9 5a3 3 0 0 1 6 0M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 11v5M9.5 13.5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',

      perfil: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',

      usuarios: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M16 11a4 4 0 1 0-8 0M3 21a7 7 0 0 1 14 0M18 8a3 3 0 0 1 0 6M19 17a5 5 0 0 1 2 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',

      medico: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M12 3v18M5 10h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="2"/></svg>',

      triaje: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z" stroke="currentColor" stroke-width="2"/><path d="M12 7v6M9 10h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>'
    };
  %>

  <aside class="sidebar">
    <div class="sidebar-header">
      <h2>Bienestar UNT</h2>
      <p><%= user ? user.rol : '' %></p>
    </div>

    <nav class="sidebar-nav" aria-label="Navegación principal">

      <% if (user && user.rol === 'paciente') { %>
        <a href="/paciente/dashboard" class="<%= currentPath === '/paciente/dashboard' ? 'active' : '' %>">
            <%- icons.inicio %>
            <span>Inicio</span>
        </a>

        <a href="/paciente/reservar-cita" class="<%= currentPath === '/paciente/reservar-cita' ? 'active' : '' %>">
            <%- icons.reservar %>
            <span>Reservar cita</span>
        </a>

        <a href="/paciente/mis-citas" class="<%= currentPath === '/paciente/mis-citas' ? 'active' : '' %>">
            <%- icons.citas %>
            <span>Mis citas</span>
        </a>

        <a href="/paciente/historial" class="<%= currentPath.startsWith('/paciente/historial') ? 'active' : '' %>">
            <%- icons.historial %>
            <span>Historial</span>
        </a>

        <a href="/paciente/antecedentes" class="<%= currentPath === '/paciente/antecedentes' ? 'active' : '' %>">
            <%- icons.antecedentes %>
            <span>Mis antecedentes médicos</span>
        </a>

        <a href="/perfil" class="<%= currentPath === '/perfil' ? 'active' : '' %>">
            <%- icons.perfil %>
            <span>Mi perfil</span>
        </a>
      <% } %>

      <% if (user && user.rol === 'medico') { %>
        <a href="/medico/dashboard" class="<%= currentPath === '/medico/dashboard' ? 'active' : '' %>">
          <%- icons.inicio %>
          <span>Inicio</span>
        </a>

        <a href="/medico/citas" class="<%= currentPath.startsWith('/medico/citas') ? 'active' : '' %>">
            <%- icons.citas %>
            <span>Citas por atender</span>
        </a>

        <a href="/medico/pacientes" class="<%= currentPath.startsWith('/medico/pacientes') ? 'active' : '' %>">
          <%- icons.usuarios %>
          <span>Pacientes</span>
        </a>

        <a href="/perfil" class="<%= currentPath === '/perfil' ? 'active' : '' %>">
          <%- icons.perfil %>
          <span>Mi perfil</span>
        </a>
      <% } %>

      <% if (user && user.rol === 'enfermera') { %>
        <a href="/enfermera/dashboard" class="<%= currentPath === '/enfermera/dashboard' ? 'active' : '' %>">
          <%- icons.inicio %>
          <span>Inicio</span>
        </a>

        <a href="/enfermera/triaje-pendiente" class="<%= currentPath === '/enfermera/triaje-pendiente' ? 'active' : '' %>">
            <%- icons.triaje %>
            <span>Triaje pendiente</span>
        </a>

        <a href="/enfermera/triajes" class="<%= currentPath.startsWith('/enfermera/triajes') ? 'active' : '' %>">
          <%- icons.citas %>
          <span>Triajes activos</span>
        </a>

        <a href="/enfermera/historial-triajes" class="<%= currentPath === '/enfermera/historial-triajes' ? 'active' : '' %>">
          <%- icons.historial %>
          <span>Historial de triajes</span>
        </a>

        <a href="/perfil" class="<%= currentPath === '/perfil' ? 'active' : '' %>">
          <%- icons.perfil %>
          <span>Mi perfil</span>
        </a>
      <% } %>

      <% if (user && user.rol === 'administrativo') { %>
        <a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'active' : '' %>">
          <%- icons.inicio %>
          <span>Inicio</span>
        </a>

        <a href="/admin/usuarios" class="<%= currentPath.startsWith('/admin/usuarios') ? 'active' : '' %>">
          <%- icons.usuarios %>
          <span>Usuarios</span>
        </a>
        
        <a href="/admin/citas" class="<%= currentPath.startsWith('/admin/citas') ? 'active' : '' %>">
          <%- icons.citas %>
          <span>Citas</span>
        </a>

        <a href="/admin/medicos" class="<%= currentPath.startsWith('/admin/medicos') ? 'active' : '' %>">
          <%- icons.medico %>
          <span>Médicos</span>
        </a>

        <a href="/admin/enfermeras" class="<%= currentPath.startsWith('/admin/enfermeras') ? 'active' : '' %>">
          <%- icons.triaje %>
          <span>Enfermeras</span>
        </a>


        <a href="/perfil" class="<%= currentPath === '/perfil' ? 'active' : '' %>">
          <%- icons.perfil %>
          <span>Mi perfil</span>
        </a>
      <% } %>

    </nav>

    <form action="/logout" method="POST" class="logout-form">
      <button type="submit">Cerrar sesión</button>
    </form>
  </aside>

  <main class="dashboard-main">
    <header class="dashboard-topbar">
      <div>
        <h1><%= title %></h1>

        <% if (
          currentPath === '/paciente/dashboard' ||
          currentPath === '/medico/dashboard' ||
          currentPath === '/enfermera/dashboard' ||
          currentPath === '/admin/dashboard'
        ) { %>
          <p>Hola, <%= user ? user.nombres : 'Usuario' %></p>
        <% } %>
      </div>
    </header>

    <section class="dashboard-content">
      <% if (error) { %>
        <div class="alert alert-error dashboard-alert" role="alert"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success dashboard-alert auto-dismiss" role="status"><%= success %></div>
      <% } %>

      <%- body %>
    </section>
  </main>

  <div class="modal-overlay hidden" id="globalConfirmModal">
    <div class="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="globalConfirmTitle" aria-describedby="globalConfirmText">
      <h3 id="globalConfirmTitle">Confirmar acción</h3>
      <p id="globalConfirmText">¿Estás seguro de continuar?</p>

      <div class="modal-actions">
        <button type="button" class="btn-light" id="globalConfirmCancel">Cancelar</button>
        <button type="button" class="btn-danger" id="globalConfirmAccept">Confirmar</button>
      </div>
    </div>
  </div>

  <script>
  const autoDismissAlerts = document.querySelectorAll('.auto-dismiss');

  document.querySelectorAll('.sidebar-nav a.active').forEach(link => {
    link.setAttribute('aria-current', 'page');
  });

  autoDismissAlerts.forEach(alert => {
    setTimeout(() => {
      alert.classList.add('fade-out');

      setTimeout(() => {
        alert.remove();
      }, 400);
    }, 3500);
  });

  const TABLE_PAGE_SIZE = 6;
  const COMPACT_CENTER_HEADERS = new Set([
    'accion',
    'acciones',
    'area',
    'colegiatura',
    'consultas completadas',
    'dni',
    'edad',
    'especialidad',
    'estado',
    'estado de atencion',
    'fecha',
    'hora',
    'rol',
    'sexo',
    'signos vitales',
    'telefono',
    'turno',
    'ultima atencion'
  ]);

  function normalizeHeaderText(value) {
    return value
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[↑↓]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function applyCompactColumnAlignment() {
    document.querySelectorAll('.data-table').forEach(table => {
      const headers = Array.from(table.querySelectorAll('thead th'));
      const rows = Array.from(table.querySelectorAll('tbody tr'));

      headers.forEach((header, index) => {
        const headerText = normalizeHeaderText(header.textContent || '');
        if (!COMPACT_CENTER_HEADERS.has(headerText)) return;

        header.classList.add('table-col-center');
        rows.forEach(row => {
          row.children[index]?.classList.add('table-col-center');
        });
      });
    });
  }

  function getStatusPriority(row) {
  const statusBadge = row.querySelector('.status-badge');

  if (!statusBadge) return 99;

  const statusText = statusBadge.textContent.trim().toLowerCase();

  if (statusText.includes('pendiente')) return 1;
  if (statusText.includes('triaje')) return 2;
  if (statusText.includes('en consulta')) return 3;
  if (statusText.includes('completada')) return 4;
  if (statusText.includes('cancelada')) return 5;

  return 99;
}

function moveRowsByStatusPriority(tbody) {
  const rows = Array.from(tbody.querySelectorAll('tr'));

  rows
    .sort((a, b) => {
      const priorityA = getStatusPriority(a);
      const priorityB = getStatusPriority(b);

      if (priorityA !== priorityB) {
        return priorityA - priorityB;
      }

      return 0;
    })
    .forEach(row => tbody.appendChild(row));
}
  
  function initializeTablePagination() {
    const tableContainers = document.querySelectorAll('.table-responsive');

    tableContainers.forEach(container => {
      const table = container.querySelector('.data-table');
      if (!table || table.dataset.paginationReady === '1') return;

      const tbody = table.querySelector('tbody');
      if (!tbody) return;

      const getRows = () => Array.from(tbody.querySelectorAll('tr'));
      if (getRows().length === 0) return;

      const existingPagination =
        container.nextElementSibling?.classList.contains('table-pagination')
          ? container.nextElementSibling
          : null;

      const hasServerPagination = Boolean(
        existingPagination?.querySelector('a.pagination-button[href]')
      );

      if (hasServerPagination) return;

      let currentPage = 1;
      const pagination = existingPagination || document.createElement('div');
      pagination.className = 'table-pagination';
      pagination.innerHTML = `
        <p></p>
        <div class="pagination-actions">
          <button type="button" class="pagination-button" aria-label="Página anterior">&lt;</button>
          <span></span>
          <button type="button" class="pagination-button" aria-label="Página siguiente">&gt;</button>
        </div>
      `;

      if (!existingPagination) {
        container.insertAdjacentElement('afterend', pagination);
      }

      const info = pagination.querySelector('p');
      const pageLabel = pagination.querySelector('span');
      const buttons = pagination.querySelectorAll('button');
      const previousButton = buttons[0];
      const nextButton = buttons[1];

      function renderTablePage() {
        const rows = getRows();
        const totalRows = rows.length;
        const totalPages = Math.max(Math.ceil(totalRows / TABLE_PAGE_SIZE), 1);

        currentPage = Math.min(Math.max(currentPage, 1), totalPages);

        const start = (currentPage - 1) * TABLE_PAGE_SIZE;
        const end = Math.min(start + TABLE_PAGE_SIZE, totalRows);

        rows.forEach((row, index) => {
          row.classList.toggle('hidden', index < start || index >= end);
        });

        info.innerHTML = `Mostrando <strong>${totalRows === 0 ? 0 : start + 1}-${end}</strong> de <strong>${totalRows}</strong> registros`;
        pageLabel.textContent = `Página ${currentPage} de ${totalPages}`;
        previousButton.disabled = currentPage <= 1;
        nextButton.disabled = currentPage >= totalPages;
      }

      previousButton.addEventListener('click', () => {
        currentPage -= 1;
        renderTablePage();
      });

      nextButton.addEventListener('click', () => {
        currentPage += 1;
        renderTablePage();
      });

      table.dataset.paginationReady = '1';
      table.__renderPagination = renderTablePage;
      renderTablePage();
    });
  }

  applyCompactColumnAlignment();
  initializeTablePagination();

  document.querySelectorAll('.data-table').forEach(table => {
    const headers = Array.from(table.querySelectorAll('th'));
    const tbody = table.querySelector('tbody');

    if (!tbody) return;

    headers.forEach((header, index) => {
      if (header.querySelector('a') || header.textContent.trim().toLowerCase() === 'acciones') return;

      header.classList.add('sortable-header');
      header.tabIndex = 0;

      function sortRows() {
        const direction = header.dataset.direction === 'asc' ? 'desc' : 'asc';
        header.dataset.direction = direction;

        const orderedRows = Array.from(tbody.querySelectorAll('tr'))
        .sort((a, b) => {
          const aText = (a.children[index]?.textContent || '').trim();
          const bText = (b.children[index]?.textContent || '').trim();

          return direction === 'asc'
            ? aText.localeCompare(bText, 'es', { numeric: true })
            : bText.localeCompare(aText, 'es', { numeric: true });
        });

        orderedRows.forEach(row => tbody.appendChild(row));

        if (typeof table.__renderPagination === 'function') {
          table.__renderPagination();
        }
      }

      header.addEventListener('click', sortRows);
      header.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          sortRows();
        }
      });
    });
  });

    const globalConfirmModal = document.getElementById('globalConfirmModal');
    const globalConfirmTitle = document.getElementById('globalConfirmTitle');
    const globalConfirmText = document.getElementById('globalConfirmText');
    const globalConfirmCancel = document.getElementById('globalConfirmCancel');
    const globalConfirmAccept = document.getElementById('globalConfirmAccept');
    let pendingConfirmForm = null;

    document.querySelectorAll('form[data-confirm]').forEach(form => {
      form.addEventListener('submit', event => {
        event.preventDefault();
        pendingConfirmForm = form;
        globalConfirmTitle.textContent = form.dataset.confirmTitle || 'Confirmar acción';
        globalConfirmText.textContent = form.dataset.confirm || '¿Estás seguro de continuar?';
        globalConfirmAccept.textContent = form.dataset.confirmButton || 'Confirmar';
        globalConfirmModal.classList.remove('hidden');
      });
    });

    globalConfirmCancel.addEventListener('click', () => {
      pendingConfirmForm = null;
      globalConfirmModal.classList.add('hidden');
    });

    globalConfirmAccept.addEventListener('click', () => {
      if (pendingConfirmForm) {
        pendingConfirmForm.submit();
      }
    });

    globalConfirmModal.addEventListener('click', event => {
      if (event.target === globalConfirmModal) {
        pendingConfirmForm = null;
        globalConfirmModal.classList.add('hidden');
      }
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !globalConfirmModal.classList.contains('hidden')) {
        pendingConfirmForm = null;
        globalConfirmModal.classList.add('hidden');
      }
    });
  </script>

</body>
</html>

