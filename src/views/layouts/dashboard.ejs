      'medico-atender-cita': 'bi bi-clipboard2-pulse',
      'medico-pacientes': 'bi bi-people',
      'medico-historial-paciente': 'bi bi-folder2-open',
      'medico-perfil': 'bi bi-person',
      'enfermera-triaje-pendiente': 'bi bi-exclamation-circle',
      'enfermera-registrar-triaje': 'bi bi-activity',
      'enfermera-triajes': 'bi bi-clipboard2-pulse',
      'enfermera-historial-triajes': 'bi bi-clock-history',
      'enfermera-perfil': 'bi bi-person',
      'admin-usuarios': 'bi bi-people',
      'admin-citas': 'bi bi-calendar3',
      'admin-detalle-cita': 'bi bi-card-checklist',
      'admin-perfil': 'bi bi-person-gear',
      'admin-dashboard': 'bi bi-shield-check'
    };

    function closePatientHelp() {
      if (!patientHelpModal) return;
      patientHelpModal.classList.add('hidden');
      if (lastPatientHelpTrigger) lastPatientHelpTrigger.focus();
      lastPatientHelpTrigger = null;
    }

    function openPatientHelp(topic, trigger) {
      if (!patientHelpModal) return;

      const content = patientHelpContent[topic];
      if (!content) return;

      lastPatientHelpTrigger = trigger || null;
      if (patientHelpIcon) {
        patientHelpIcon.className = patientHelpIcons[topic] || 'bi bi-question-circle';
      }
      patientHelpTitle.textContent = content.title;
      patientHelpIntro.textContent = content.intro;
      patientHelpList.innerHTML = content.items.map(item => `<li>${item}</li>`).join('');
      patientHelpNoteText.textContent = content.note || '';
      patientHelpNote.classList.toggle('hidden', !content.note);
      patientHelpModal.classList.remove('hidden');
      closePatientHelpModal.focus();
    }

    document.querySelectorAll('[data-help-topic]').forEach(button => {
      button.addEventListener('click', () => {
        openPatientHelp(button.dataset.helpTopic, button);
      });
    });

    if (closePatientHelpModal) {
      closePatientHelpModal.addEventListener('click', closePatientHelp);
    }

    if (patientHelpModal) {
      patientHelpModal.addEventListener('click', event => {
        if (event.target === patientHelpModal) closePatientHelp();
      });
    }

    const globalConfirmModal = document.getElementById('globalConfirmModal');
    const globalConfirmTitle = document.getElementById('globalConfirmTitle');
    const globalConfirmText = document.getElementById('globalConfirmText');
    const globalConfirmNote = document.getElementById('globalConfirmNote');
    const globalConfirmIcon = document.getElementById('globalConfirmIcon');
    const globalConfirmAcceptIcon = document.getElementById('globalConfirmAcceptIcon');
    const globalConfirmClose = document.getElementById('globalConfirmClose');
    const globalConfirmCancel = document.getElementById('globalConfirmCancel');
    const globalConfirmAccept = document.getElementById('globalConfirmAccept');
    let pendingConfirmForm = null;

    const getConfirmActionIcon = confirmLabel => {
      const normalizedLabel = confirmLabel.toLowerCase();

      if (normalizedLabel.includes('eliminar')) return 'bi-trash3';
      if (normalizedLabel.includes('desactivar')) return 'bi-person-dash';
      if (normalizedLabel.includes('activar')) return 'bi-person-check';
      if (normalizedLabel.includes('cancelar') || normalizedLabel.includes('cerrar')) return 'bi-x-circle';
      if (normalizedLabel.includes('contraseña') || normalizedLabel.includes('contrasena')) return 'bi-shield-lock';
      if (normalizedLabel.includes('actualizar')) return 'bi-pencil-square';
      if (normalizedLabel.includes('guardar')) return 'bi-floppy';
      if (normalizedLabel.includes('registrar')) return 'bi-person-plus';
      return 'bi-check2-circle';
    };

    const getConfirmActionTone = confirmLabel => {
      const normalizedLabel = confirmLabel.toLowerCase();

      if (normalizedLabel.includes('eliminar')) return 'eliminar';
      if (normalizedLabel.includes('desactivar')) return 'desactivar';
      if (normalizedLabel.includes('activar')) return 'activar';
      if (normalizedLabel.includes('cancelar') || normalizedLabel.includes('cerrar sesión')) return 'cancelar';
      if (normalizedLabel.includes('guardar') || normalizedLabel.includes('actualizar')) return 'guardar';
      return 'confirmar';
    };

    const getConfirmActionNote = tone => ({
      activar: 'La persona podrá volver a usar el sistema con normalidad.',
      cancelar: 'Puedes detener la acción ahora si necesitas revisar la información.',
      desactivar: 'La cuenta no podrá ingresar hasta que sea activada nuevamente.',
      eliminar: 'Esta acción no se puede deshacer. Verifica que realmente corresponde.',
      guardar: 'Se guardarán cambios en información sensible del sistema.',
      confirmar: 'La acción quedará registrada al confirmar.'
    }[tone] || 'Revisa la información antes de continuar.');

    function openCriticalFormConfirmation(form, options = {}) {
      pendingConfirmForm = form;
      globalConfirmTitle.textContent = options.title || form.dataset.confirmTitle || 'Confirmar acción';
      globalConfirmText.textContent = options.message || form.dataset.confirm || 'Esta acción puede modificar información del sistema. Revisa los datos antes de continuar.';
      const confirmLabel = options.button || form.dataset.confirmButton || 'Confirmar';
      const confirmTone = getConfirmActionTone(confirmLabel);
      globalConfirmAccept.title = confirmLabel;
      globalConfirmAccept.setAttribute('aria-label', confirmLabel);
      globalConfirmAccept.dataset.confirmAction = confirmTone;
      globalConfirmModal.querySelector('.confirm-modal').dataset.confirmAction = confirmTone;
      const confirmAction = getConfirmActionIcon(confirmLabel);
      const confirmAcceptText = globalConfirmAccept.querySelector('span');
      confirmAcceptText.textContent = confirmLabel;
      confirmAcceptText.classList.remove('visually-hidden');
      globalConfirmAccept.classList.add('icon-action');
      globalConfirmAcceptIcon.className = `bi ${confirmAction}`;
      globalConfirmIcon.className = `bi ${confirmAction}`;
      globalConfirmNote.textContent = getConfirmActionNote(confirmTone);
      globalConfirmModal.classList.remove('hidden');
      globalConfirmCancel.focus();
    }

    window.openCriticalFormConfirmation = openCriticalFormConfirmation;

    document.querySelectorAll('form[data-confirm]').forEach(form => {
      form.addEventListener('submit', event => {
        if (event.defaultPrevented) return;
        event.preventDefault();
        openCriticalFormConfirmation(form);
      });
    });

    const logoutForm = document.querySelector('.logout-form');

    if (logoutForm) {
      logoutForm.addEventListener('submit', event => {
        if (event.defaultPrevented) return;
        if (typeof window.hasUnsavedCriticalChanges !== 'function') return;
        if (!window.hasUnsavedCriticalChanges()) return;

        event.preventDefault();
        openCriticalFormConfirmation(logoutForm, {
          title: 'Cerrar sesión con cambios sin guardar',
          message: 'Hay cambios escritos en esta pantalla que todavía no se guardaron. Si cierras sesión ahora, se perderán.',
          button: 'Cerrar sesión'
        });
      });
    }

    function closeGlobalConfirmModal() {
      pendingConfirmForm = null;
      globalConfirmModal.classList.add('hidden');
    }

    globalConfirmCancel.addEventListener('click', closeGlobalConfirmModal);

    globalConfirmClose.addEventListener('click', () => {
      closeGlobalConfirmModal();
    });

    globalConfirmAccept.addEventListener('click', () => {
      if (pendingConfirmForm) {
        if (typeof window.saveCurrentFormDraft === 'function') {
          window.saveCurrentFormDraft(pendingConfirmForm);
        }
        if (typeof window.showPageLoading === 'function') {
          window.showPageLoading('Procesando acción...');
        }
        pendingConfirmForm.submit();
      }
    });

    globalConfirmModal.addEventListener('click', event => {
      if (event.target === globalConfirmModal) {
        closeGlobalConfirmModal();
      }
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && patientHelpModal && !patientHelpModal.classList.contains('hidden')) {
        closePatientHelp();
      }

      if (event.key === 'Escape' && !globalConfirmModal.classList.contains('hidden')) {
        closeGlobalConfirmModal();
      }
    });
  </script>

</body>
</html>
