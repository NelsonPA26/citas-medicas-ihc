  <script>
  const pageModuleDescription = document.getElementById('pageModuleDescription');
  const moduleDescriptionSource = document.querySelector(
    '.dashboard-content .module-card > .module-header p, ' +
    '.dashboard-content .module-header-copy p, ' +
    '.dashboard-content .admin-user-form-intro p, ' +
    '.dashboard-content .antecedentes-header p'
  );

  if (pageModuleDescription && moduleDescriptionSource) {
    const descriptionText = moduleDescriptionSource.textContent.trim();

    if (descriptionText) {
      pageModuleDescription.textContent = descriptionText;
      pageModuleDescription.classList.remove('hidden');
      moduleDescriptionSource.classList.add('is-hoisted-description');
      moduleDescriptionSource.setAttribute('aria-hidden', 'true');

      const sourceHeader = moduleDescriptionSource.closest('.module-header');
      if (sourceHeader) {
        const hasAction = sourceHeader.querySelector('a, button, form, .admin-user-primary-action, .antecedentes-meta');
        if (!hasAction) sourceHeader.classList.add('module-header-empty');
      }
    }
  }

  const autoDismissAlerts = document.querySelectorAll('[data-toast].auto-dismiss');

  document.querySelectorAll('.sidebar-nav a.active').forEach(link => {
    link.setAttribute('aria-current', 'page');
  });

  const appSidebar = document.getElementById('appSidebar');
  const sidebarToggle = document.getElementById('sidebarToggle');
  const accountMenu = document.getElementById('accountMenu');
  const SIDEBAR_STATE_KEY = 'citasIhcSidebarCollapsed:v1';

  function getStoredSidebarState() {
    try {
      const value = localStorage.getItem(SIDEBAR_STATE_KEY);
      return value === null ? null : value === 'true';
    } catch (error) {
      return null;
    }
  }

  function setSidebarCollapsed(collapsed, persist = true) {
    document.body.classList.toggle('sidebar-collapsed', collapsed);

    if (persist) {
      try {
        localStorage.setItem(SIDEBAR_STATE_KEY, String(collapsed));
      } catch (error) {
        // La barra lateral mantiene su estado durante la pagina aunque el navegador no permita almacenarlo.
      }
    }

    if (appSidebar) {
      appSidebar.setAttribute('aria-hidden', collapsed ? 'true' : 'false');
      appSidebar.inert = collapsed;
    }

    if (sidebarToggle) {
      sidebarToggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      sidebarToggle.title = collapsed ? 'Mostrar menú lateral' : 'Ocultar menú lateral';
      const label = sidebarToggle.querySelector('.visually-hidden');
      if (label) label.textContent = collapsed ? 'Mostrar menú lateral' : 'Ocultar menú lateral';
    }
  }

  if (sidebarToggle) {
    sidebarToggle.addEventListener('click', () => {
      setSidebarCollapsed(!document.body.classList.contains('sidebar-collapsed'));
    });
  }

  const storedSidebarState = getStoredSidebarState();
  const shouldStartCollapsed = storedSidebarState === null
    ? window.matchMedia('(max-width: 760px)').matches
    : storedSidebarState;
  setSidebarCollapsed(shouldStartCollapsed, false);

  if (accountMenu) {
    document.addEventListener('click', event => {
      if (accountMenu.open && !accountMenu.contains(event.target)) accountMenu.removeAttribute('open');
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && accountMenu.open) {
        accountMenu.removeAttribute('open');
        accountMenu.querySelector('summary')?.focus();
      }
    });
  }

  autoDismissAlerts.forEach(alert => {
    const dismissToast = () => {
      if (!alert.isConnected || alert.classList.contains('fade-out')) return;
      alert.classList.add('fade-out');

      setTimeout(() => {
        alert.remove();
      }, 400);
    };

    const closeButton = alert.querySelector('.toast-close');
    if (closeButton) closeButton.addEventListener('click', dismissToast);
    setTimeout(dismissToast, Number(alert.dataset.duration || 4500));
  });

  const TABLE_PAGE_SIZE = 4;
  const COMPACT_CENTER_HEADERS = new Set([
    'accion',
    'acciones',
    'area',
    'colegiatura',
    'consultas completadas',
    'dni',
    'edad',
    'especialidad',
    'estado',
    'estado de atencion',
    'fecha',
    'hora',
    'rol',
    'sexo',
    'signos vitales',
    'telefono',
    'turno',
    'ultima atencion'
  ]);

  function normalizeHeaderText(value) {
    return value
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[↑↓]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function applyCompactColumnAlignment() {
    document.querySelectorAll('.data-table').forEach(table => {
      const headers = Array.from(table.querySelectorAll('thead th'));
      const rows = Array.from(table.querySelectorAll('tbody tr'));

      headers.forEach((header, index) => {
        const headerText = normalizeHeaderText(header.textContent || '');
        if (!COMPACT_CENTER_HEADERS.has(headerText)) return;

        header.classList.add('table-col-center');
        rows.forEach(row => {
          row.children[index]?.classList.add('table-col-center');
        });
      });
    });
  }

  function getStatusPriority(row) {
  const statusBadge = row.querySelector('.status-badge');

  if (!statusBadge) return 99;

  const statusText = statusBadge.textContent.trim().toLowerCase();

  if (statusText.includes('pendiente')) return 1;
  if (statusText.includes('triaje')) return 2;
  if (statusText.includes('en consulta')) return 3;
  if (statusText.includes('completada')) return 4;
  if (statusText.includes('cancelada')) return 5;

  return 99;
}

function moveRowsByStatusPriority(tbody) {
  const rows = Array.from(tbody.querySelectorAll('tr'));

  rows
    .sort((a, b) => {
      const priorityA = getStatusPriority(a);
      const priorityB = getStatusPriority(b);

      if (priorityA !== priorityB) {
        return priorityA - priorityB;
      }

      return 0;
    })
    .forEach(row => tbody.appendChild(row));
}
  
  function initializeTablePagination() {
    const tableContainers = document.querySelectorAll('.table-responsive');

    tableContainers.forEach(container => {
      const table = container.querySelector('.data-table');
      if (!table || table.dataset.paginationReady === '1') return;

      const tbody = table.querySelector('tbody');
      if (!tbody) return;

      const getRows = () => Array.from(tbody.querySelectorAll('tr'));
      if (getRows().length === 0) return;

      const existingPagination =
        container.nextElementSibling?.classList.contains('table-pagination')
          ? container.nextElementSibling
          : null;

      const hasServerPagination = Boolean(
        existingPagination?.querySelector('a.pagination-button[href]')
      );

      if (hasServerPagination) return;

      let currentPage = 1;
      const pagination = existingPagination || document.createElement('div');
      pagination.className = 'table-pagination';
      pagination.innerHTML = `
        <p></p>
        <div class="pagination-actions">
          <button type="button" class="pagination-button" aria-label="Página anterior">&lt;</button>
          <span></span>
          <button type="button" class="pagination-button" aria-label="Página siguiente">&gt;</button>
        </div>
      `;

      if (!existingPagination) {
        container.insertAdjacentElement('afterend', pagination);
      }

      const info = pagination.querySelector('p');
      const pageLabel = pagination.querySelector('span');
      const buttons = pagination.querySelectorAll('button');
      const previousButton = buttons[0];
      const nextButton = buttons[1];

      function renderTablePage() {
        const rows = getRows();
        const totalRows = rows.length;
        const totalPages = Math.max(Math.ceil(totalRows / TABLE_PAGE_SIZE), 1);

        currentPage = Math.min(Math.max(currentPage, 1), totalPages);

        const start = (currentPage - 1) * TABLE_PAGE_SIZE;
        const end = Math.min(start + TABLE_PAGE_SIZE, totalRows);

        rows.forEach((row, index) => {
          row.classList.toggle('hidden', index < start || index >= end);
        });

        info.innerHTML = `Mostrando <strong>${totalRows === 0 ? 0 : start + 1}-${end}</strong> de <strong>${totalRows}</strong> registros`;
        pageLabel.textContent = `Página ${currentPage} de ${totalPages}`;
        previousButton.disabled = currentPage <= 1;
        nextButton.disabled = currentPage >= totalPages;
      }

      previousButton.addEventListener('click', () => {
        currentPage -= 1;
        renderTablePage();
      });

      nextButton.addEventListener('click', () => {
        currentPage += 1;
        renderTablePage();
      });

      table.dataset.paginationReady = '1';
      table.__renderPagination = renderTablePage;
      renderTablePage();
    });
  }

  applyCompactColumnAlignment();
  initializeTablePagination();

  document.querySelectorAll('.data-table').forEach(table => {
    const headers = Array.from(table.querySelectorAll('th'));
    const tbody = table.querySelector('tbody');

    if (!tbody) return;

    headers.forEach((header, index) => {
      if (header.querySelector('a') || header.textContent.trim().toLowerCase() === 'acciones') return;

      header.classList.add('sortable-header');
      header.tabIndex = 0;

      function sortRows() {
        const direction = header.dataset.direction === 'asc' ? 'desc' : 'asc';
        header.dataset.direction = direction;

        const orderedRows = Array.from(tbody.querySelectorAll('tr'))
        .sort((a, b) => {
          const aText = (a.children[index]?.textContent || '').trim();
          const bText = (b.children[index]?.textContent || '').trim();

          return direction === 'asc'
            ? aText.localeCompare(bText, 'es', { numeric: true })
            : bText.localeCompare(aText, 'es', { numeric: true });
        });

        orderedRows.forEach(row => tbody.appendChild(row));

        if (typeof table.__renderPagination === 'function') {
          table.__renderPagination();
        }
      }

      header.addEventListener('click', sortRows);
      header.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          sortRows();
        }
      });
    });
  });

