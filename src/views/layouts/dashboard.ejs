<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title><%= title || 'Sistema de Citas Médicas' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/styles.css?v=20260718-visual-7">
</head>
<body class="dashboard-body">
  <script>
    (function () {
      const sidebarStateKey = 'citasIhcSidebarCollapsed:v1';

      try {
        const storedState = localStorage.getItem(sidebarStateKey);
        const shouldStartCollapsed = storedState === null
          ? window.matchMedia('(max-width: 760px)').matches
          : storedState === 'true';

        if (shouldStartCollapsed) document.body.classList.add('sidebar-collapsed');
      } catch (error) {
        if (window.matchMedia('(max-width: 760px)').matches) {
          document.body.classList.add('sidebar-collapsed');
        }
      }
    })();
  </script>
  <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>

  <svg class="field-icon-sprite" aria-hidden="true" focusable="false">
    <symbol id="field-icon-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 4 4"></path></symbol>
    <symbol id="field-icon-calendar" viewBox="0 0 24 24"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M3 10h18"></path></symbol>
    <symbol id="field-icon-stethoscope" viewBox="0 0 24 24"><path d="M6 3v5a4 4 0 0 0 8 0V3"></path><path d="M10 12v3a5 5 0 0 0 10 0v-2"></path><circle cx="20" cy="10" r="2"></circle></symbol>
    <symbol id="field-icon-user" viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0"></path><circle cx="12" cy="7" r="4"></circle></symbol>
    <symbol id="field-icon-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></symbol>
    <symbol id="field-icon-note" viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6z"></path><path d="M14 3v4h4"></path><path d="M9 12h6"></path><path d="M9 16h6"></path></symbol>
    <symbol id="field-icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path></symbol>
    <symbol id="field-icon-phone" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></symbol>
    <symbol id="field-icon-home" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"></path></symbol>
    <symbol id="field-icon-lock" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></symbol>
    <symbol id="field-icon-pill" viewBox="0 0 24 24"><path d="M10 21 3 14a4.2 4.2 0 0 1 0-6l2-2a4.2 4.2 0 0 1 6 0l7 7a4.2 4.2 0 0 1 0 6l-2 2a4.2 4.2 0 0 1-6 0z"></path><path d="m8 8 8 8"></path></symbol>
    <symbol id="field-icon-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path></symbol>
    <symbol id="field-icon-surgery" viewBox="0 0 24 24"><path d="m14 7 3 3"></path><path d="M5 19 17 7l2 2L7 21H5z"></path><path d="m12 9 3 3"></path></symbol>
    <symbol id="field-icon-family" viewBox="0 0 24 24"><circle cx="9" cy="7" r="3"></circle><path d="M3 21a6 6 0 0 1 12 0"></path><circle cx="17" cy="9" r="2.5"></circle><path d="M14 16a5 5 0 0 1 7 5"></path></symbol>
    <symbol id="field-icon-thermometer" viewBox="0 0 24 24"><path d="M14 14.8V5a4 4 0 0 0-8 0v9.8a6 6 0 1 0 8 0z"></path><path d="M10 9v7"></path></symbol>
    <symbol id="field-icon-activity" viewBox="0 0 24 24"><path d="M3 12h4l3-8 4 16 3-8h4"></path></symbol>
  </svg>

  <%
    const icons = {
      inicio: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M3 10.5L12 3l9 7.5V21a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>',

      reservar: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><rect x="4" y="5" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 3v4M16 3v4M4 9h16M12 12.5v5M9.5 15h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',

      citas: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><rect x="4" y="5" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 3v4M16 3v4M4 9h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01M16 17h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>',

      historial: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 1 0 2.35-5.65" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M4 5.5v4h4M12 8v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',

      antecedentes: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M9 5h6M9 5a3 3 0 0 1 6 0M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 11v5M9.5 13.5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',

      perfil: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',

      ayuda: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M9.8 9a2.4 2.4 0 0 1 4.6 1c0 1.7-2.4 2-2.4 3.6M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',

      usuarios: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M16 11a4 4 0 1 0-8 0M3 21a7 7 0 0 1 14 0M18 8a3 3 0 0 1 0 6M19 17a5 5 0 0 1 2 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',

      medico: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M12 3v18M5 10h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="2"/></svg>',

      triaje: '<svg class="menu-svg" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z" stroke="currentColor" stroke-width="2"/><path d="M12 7v6M9 10h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>'
    };

    const roleHelpRoutes = {
      paciente: '/paciente/ayuda',
      medico: '/medico/ayuda',
      enfermera: '/enfermera/ayuda',
      administrativo: '/admin/ayuda'
    };
    const roleHelpUrl = user ? roleHelpRoutes[user.rol] : '/ayuda';
    const helpReturnUrl = `${roleHelpUrl}?returnTo=${encodeURIComponent(currentPath)}`;
    const profileMenuUrl = currentPath === '/perfil'
      ? '/perfil'
      : `/perfil?returnTo=${encodeURIComponent(currentPath)}`;
    const isRoleDashboard = currentPath === '/paciente/dashboard' ||
      currentPath === '/medico/dashboard' ||
      currentPath === '/enfermera/dashboard' ||
      currentPath === '/admin/dashboard';
    const isAdminRole = user && user.rol === 'administrativo';
    const isPrincipalAdministrator = isAdminRole && user.nivel_acceso_administrativo === 'principal';
    const isAdmissionAdministrator = isAdminRole && !isPrincipalAdministrator && user.area_administrativa === 'Admisión';
    const isUserManagementAdministrator = isAdminRole && !isPrincipalAdministrator && user.area_administrativa === 'Gestión de usuarios';
    const showAdminRegisterUserAction = isAdminRole && currentPath === '/admin/usuarios';
    const adminRegisterUrl = isAdmissionAdministrator
      ? '/admin/usuarios/nuevo?rol=paciente'
      : '/admin/usuarios/nuevo';
    const adminRegisterLabel = isAdmissionAdministrator ? 'Registrar paciente' : 'Registrar usuario';
    const hasPageReturnUrl = typeof returnUrl !== 'undefined'
      && typeof returnUrl === 'string'
      && returnUrl.startsWith('/');
    const hasDashboardReturn = typeof returnToDashboard !== 'undefined'
      && returnToDashboard
      && dashboardReturnUrl
      && currentPath !== dashboardReturnUrl;
    const pageReturnUrl = hasPageReturnUrl
      ? returnUrl
      : (hasDashboardReturn ? dashboardReturnUrl : null);
    const pageReturnLabel = 'Volver';
    const userInitials = `${user?.nombres || ''} ${user?.apellido_paterno || ''}`
      .trim()
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map(part => part.charAt(0).toUpperCase())
      .join('') || 'U';
    let roleTopbarHelp = null;

    if (user && user.rol === 'paciente') {
      if (currentPath.startsWith('/paciente/reservar-cita')) roleTopbarHelp = 'reservar-cita';
      if (currentPath.startsWith('/paciente/mis-citas')) roleTopbarHelp = 'mis-citas';
      if (currentPath.startsWith('/paciente/historial')) roleTopbarHelp = 'historial';
      if (currentPath.startsWith('/paciente/antecedentes')) roleTopbarHelp = 'antecedentes';
      if (currentPath === '/perfil') roleTopbarHelp = 'perfil';
    }

    if (user && user.rol === 'medico') {
      if (currentPath === '/medico/citas') roleTopbarHelp = 'medico-citas';
      if (currentPath.startsWith('/medico/citas/')) roleTopbarHelp = 'medico-atender-cita';
      if (currentPath === '/medico/pacientes') roleTopbarHelp = 'medico-pacientes';
      if (currentPath.includes('/medico/pacientes/') && currentPath.includes('/historial')) roleTopbarHelp = 'medico-historial-paciente';
      if (currentPath === '/perfil') roleTopbarHelp = 'medico-perfil';
    }

    if (user && user.rol === 'enfermera') {
      if (currentPath === '/enfermera/triaje-pendiente') roleTopbarHelp = 'enfermera-triaje-pendiente';
      if (currentPath.startsWith('/enfermera/triaje/') || currentPath.includes('/enfermera/triajes/')) roleTopbarHelp = 'enfermera-registrar-triaje';
      if (currentPath === '/enfermera/triajes') roleTopbarHelp = 'enfermera-triajes';
      if (currentPath === '/enfermera/historial-triajes') roleTopbarHelp = 'enfermera-historial-triajes';
      if (currentPath === '/perfil') roleTopbarHelp = 'enfermera-perfil';
    }

    if (user && user.rol === 'administrativo') {
      if (currentPath.startsWith('/admin/usuarios')) roleTopbarHelp = 'admin-usuarios';
      if (currentPath === '/admin/citas') roleTopbarHelp = 'admin-citas';
      if (currentPath.startsWith('/admin/citas/')) roleTopbarHelp = 'admin-detalle-cita';
      if (currentPath === '/perfil') roleTopbarHelp = 'admin-perfil';
    }
  %>

  <aside class="sidebar" id="appSidebar">
    <div class="sidebar-header">
      <h2>Bienestar UNT</h2>
      <p><%= user ? user.rol : '' %></p>
    </div>

    <nav class="sidebar-nav" aria-label="Navegación principal">

      <% if (user && user.rol === 'paciente') { %>
        <a href="/paciente/dashboard" class="<%= currentPath === '/paciente/dashboard' ? 'active' : '' %>">
            <%- icons.inicio %>
            <span>Inicio</span>
        </a>

        <a href="/paciente/reservar-cita" class="<%= currentPath === '/paciente/reservar-cita' ? 'active' : '' %>">
            <%- icons.reservar %>
            <span>Reservar cita</span>
        </a>

        <a href="/paciente/mis-citas" class="<%= currentPath.startsWith('/paciente/mis-citas') ? 'active' : '' %>">
            <%- icons.citas %>
            <span>Mis citas</span>
        </a>

        <a href="/paciente/historial" class="<%= currentPath.startsWith('/paciente/historial') ? 'active' : '' %>">
            <%- icons.historial %>
            <span>Historial</span>
        </a>

        <a href="/paciente/antecedentes" class="<%= currentPath === '/paciente/antecedentes' ? 'active' : '' %>">
            <%- icons.antecedentes %>
            <span>Mis antecedentes médicos</span>
        </a>

      <% } %>

      <% if (user && user.rol === 'medico') { %>
        <a href="/medico/dashboard" class="<%= currentPath === '/medico/dashboard' ? 'active' : '' %>">
          <%- icons.inicio %>
          <span>Inicio</span>
        </a>

        <a href="/medico/citas" class="<%= currentPath.startsWith('/medico/citas') ? 'active' : '' %>">
            <%- icons.citas %>
            <span>Citas por atender</span>
        </a>

        <a href="/medico/pacientes" class="<%= currentPath.startsWith('/medico/pacientes') ? 'active' : '' %>">
          <%- icons.usuarios %>
          <span>Pacientes</span>
        </a>

      <% } %>

      <% if (user && user.rol === 'enfermera') { %>
        <a href="/enfermera/dashboard" class="<%= currentPath === '/enfermera/dashboard' ? 'active' : '' %>">
          <%- icons.inicio %>
          <span>Inicio</span>
        </a>

        <a href="/enfermera/triaje-pendiente" class="<%= currentPath === '/enfermera/triaje-pendiente' || currentPath.startsWith('/enfermera/triaje/') ? 'active' : '' %>">
            <%- icons.triaje %>
            <span>Triaje pendiente</span>
        </a>

        <a href="/enfermera/triajes" class="<%= currentPath.startsWith('/enfermera/triajes') ? 'active' : '' %>">
          <%- icons.citas %>
          <span>Triajes activos</span>
        </a>

        <a href="/enfermera/historial-triajes" class="<%= currentPath === '/enfermera/historial-triajes' ? 'active' : '' %>">
          <%- icons.historial %>
          <span>Historial de triajes</span>
        </a>

      <% } %>

      <% if (user && user.rol === 'administrativo') { %>
        <a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'active' : '' %>">
          <%- icons.inicio %>
          <span>Inicio</span>
        </a>

        <% if (isPrincipalAdministrator || isUserManagementAdministrator) { %>
          <a href="/admin/usuarios" class="<%= currentPath.startsWith('/admin/usuarios') ? 'active' : '' %>">
            <%- icons.usuarios %>
            <span>Usuarios</span>
          </a>
        <% } %>

        <% if (isAdmissionAdministrator) { %>
          <a href="/admin/usuarios?rol=paciente" class="<%= currentPath.startsWith('/admin/usuarios') ? 'active' : '' %>">
            <%- icons.usuarios %>
            <span>Pacientes</span>
          </a>
        <% } %>

        <% if (isPrincipalAdministrator || isAdmissionAdministrator) { %>
          <a href="/admin/citas" class="<%= currentPath.startsWith('/admin/citas') ? 'active' : '' %>">
            <%- icons.citas %>
            <span>Citas</span>
          </a>
        <% } %>
      <% } %>

    </nav>

    <section class="accessibility-panel" aria-label="Opciones de accesibilidad visual">
      <span class="accessibility-group-label">Tama&ntilde;o de letra</span>
      <div class="accessibility-control-group" role="group" aria-label="Ampliadores de texto">
        <button type="button" class="accessibility-scale-button" data-visual-scale="normal" aria-pressed="true" title="Restablecer tamaño normal">
          <span class="accessibility-letter accessibility-letter-normal" aria-hidden="true">A</span>
          <span class="visually-hidden">Tamaño normal</span>
        </button>
        <button type="button" class="accessibility-scale-button" data-visual-scale="large" aria-pressed="false" title="Ampliar texto">
          <span class="accessibility-letter accessibility-letter-large" aria-hidden="true">A</span>
          <span class="visually-hidden">Texto grande</span>
        </button>
        <button type="button" class="accessibility-scale-button" data-visual-scale="xlarge" aria-pressed="false" title="Ampliar texto al máximo">
          <span class="accessibility-letter accessibility-letter-xlarge" aria-hidden="true">A</span>
          <span class="visually-hidden">Texto al tamaño máximo</span>
        </button>
      </div>
      <p class="accessibility-scale-status" id="visualScaleLabel">Normal</p>

      <div class="accessibility-contrast-row">
        <span>Alto contraste</span>
        <button type="button" class="accessibility-contrast-toggle" data-visual-contrast aria-pressed="false" aria-checked="false" role="switch">
          <span class="visually-hidden">Activar alto contraste</span>
        </button>
      </div>

      <p class="visually-hidden" id="accessibilityStatus" aria-live="polite"></p>
    </section>

  </aside>

  <header class="app-topbar" aria-label="Barra superior">
    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-controls="appSidebar" aria-expanded="true" title="Ocultar menú lateral">
      <i class="bi bi-list" aria-hidden="true"></i>
      <span class="visually-hidden">Ocultar menú lateral</span>
    </button>

    <div class="app-topbar-actions">
      <% if (isRoleDashboard || !roleTopbarHelp) { %>
        <a class="topbar-help-trigger" href="<%= helpReturnUrl %>" aria-label="Abrir ayuda general" title="Ayuda general">
          <span>?</span>
          <strong>¿Necesitas ayuda?</strong>
        </a>
      <% } else { %>
        <button type="button" class="topbar-help-trigger" data-help-topic="<%= roleTopbarHelp %>" aria-label="Ver ayuda de este módulo" title="Ayuda de esta pantalla">
          <span>?</span>
          <strong>¿Necesitas ayuda?</strong>
        </button>
      <% } %>

      <details class="account-menu" id="accountMenu">
        <summary class="account-menu-trigger" aria-label="Abrir menú de cuenta de <%= user ? user.nombres : 'usuario' %>" title="Opciones de cuenta">
          <span class="account-menu-avatar" aria-hidden="true"><%= userInitials %></span>
          <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </summary>
        <div class="account-menu-panel" role="menu" aria-label="Opciones de cuenta">
          <a href="<%= profileMenuUrl %>" role="menuitem">
            <i class="bi bi-person" aria-hidden="true"></i>
            <span>Mi perfil</span>
          </a>
          <a href="<%= helpReturnUrl %>" role="menuitem">
            <i class="bi bi-question-circle" aria-hidden="true"></i>
            <span>Ayuda</span>
          </a>
          <form action="/logout" method="POST" class="logout-form account-menu-logout" role="none">
            <button type="submit" role="menuitem">
              <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
              <span>Cerrar sesión</span>
            </button>
          </form>
        </div>
      </details>
    </div>
  </header>

  <div class="icon-attribution visually-hidden" aria-hidden="true">
    Iconos dise&ntilde;ados por <a href="https://www.flaticon.es/autores/tuktukdesign" title="tuktukdesign">tuktukdesign</a> from <a href="https://www.flaticon.es/" title="Flaticon">www.flaticon.es</a>
  </div>

  <main class="dashboard-main" id="contenido-principal" tabindex="-1">

    <header class="dashboard-topbar <%= (isAdminRole || pageReturnUrl) ? 'dashboard-topbar-admin' : '' %>">
      <div>
        <h1><%= title %></h1>
        <p id="pageModuleDescription" class="page-module-description hidden"></p>

        <% if (
          currentPath === '/paciente/dashboard' ||
          currentPath === '/medico/dashboard' ||
          currentPath === '/enfermera/dashboard' ||
          currentPath === '/admin/dashboard'
        ) { %>
          <p>Hola, <%= user ? user.nombres : 'Usuario' %></p>
        <% } %>
      </div>

      <% if (pageReturnUrl || (isAdminRole && showAdminRegisterUserAction)) { %>
        <div class="topbar-action-group page-title-actions">
          <% if (pageReturnUrl) { %>
            <a class="btn-light page-title-back" href="<%= pageReturnUrl %>">
              <i class="bi bi-arrow-left" aria-hidden="true"></i>
              <span><%= pageReturnLabel %></span>
            </a>
          <% } %>

          <% if (isAdminRole && showAdminRegisterUserAction) { %>
            <div class="admin-user-primary-action" aria-label="Acción principal del módulo">
              <a
                href="<%= adminRegisterUrl %>"
                class="btn-admin-register-clean"
                title="<%= adminRegisterLabel %>"
                aria-label="<%= adminRegisterLabel %>"
              >
                <img class="action-metaphor" src="/img/action-metaphors/administrador/usuarios/usuario_reg2.png" alt="" aria-hidden="true">
                <span><%= adminRegisterLabel %></span>
              </a>
            </div>
          <% } %>
        </div>
      <% } %>
    </header>

    <section class="dashboard-content">
      <%- body %>
    </section>
  </main>

  <% if (error || success) { %>
    <div class="toast-region" aria-label="Notificaciones del sistema">
      <% if (error) { %>
        <div class="alert alert-error dashboard-toast auto-dismiss" role="alert" data-toast data-duration="7000">
          <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
          <span><%= error %></span>
          <button type="button" class="toast-close" aria-label="Cerrar notificación"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success dashboard-toast auto-dismiss" role="status" aria-live="polite" data-toast data-duration="4500">
          <i class="bi bi-check-circle" aria-hidden="true"></i>
          <span><%= success %></span>
          <button type="button" class="toast-close" aria-label="Cerrar notificación"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
      <% } %>
    </div>
  <% } %>

  <div class="modal-overlay hidden" id="globalConfirmModal" role="dialog" aria-modal="true" aria-labelledby="globalConfirmTitle" aria-describedby="globalConfirmText">
    <div class="confirm-modal confirm-modal-polished">
      <button type="button" class="modal-close confirm-modal-close" id="globalConfirmClose" aria-label="Cerrar confirmación">&times;</button>
      <div class="confirm-modal-icon" aria-hidden="true">
        <i class="bi bi-check2-circle" id="globalConfirmIcon"></i>
      </div>
      <h3 id="globalConfirmTitle">Confirmar acción</h3>
      <p id="globalConfirmText">¿Deseas continuar con esta acción?</p>
      <small class="confirm-modal-note" id="globalConfirmNote">Revisa la información antes de continuar.</small>

      <div class="modal-actions">
