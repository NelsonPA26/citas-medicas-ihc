    const patientHelpModal = document.getElementById('patientHelpModal');
    const patientHelpTitle = document.getElementById('patientHelpTitle');
    const patientHelpIntro = document.getElementById('patientHelpIntro');
    const patientHelpList = document.getElementById('patientHelpList');
    const patientHelpNote = document.getElementById('patientHelpNote');
    const closePatientHelpModal = document.getElementById('closePatientHelpModal');
    let lastPatientHelpTrigger = null;

    function closePatientHelp() {
      if (!patientHelpModal) return;
      patientHelpModal.classList.add('hidden');
      if (lastPatientHelpTrigger) lastPatientHelpTrigger.focus();
      lastPatientHelpTrigger = null;
    }

    function openPatientHelp(topic, trigger) {
      if (!patientHelpModal) return;

      const content = patientHelpContent[topic];
      if (!content) return;

      lastPatientHelpTrigger = trigger || null;
      patientHelpTitle.textContent = content.title;
      patientHelpIntro.textContent = content.intro;
      patientHelpList.innerHTML = content.items.map(item => `<li>${item}</li>`).join('');
      patientHelpNote.textContent = content.note || '';
      patientHelpNote.classList.toggle('hidden', !content.note);
      patientHelpModal.classList.remove('hidden');
      closePatientHelpModal.focus();
    }

    document.querySelectorAll('[data-help-topic]').forEach(button => {
      button.addEventListener('click', () => {
        openPatientHelp(button.dataset.helpTopic, button);
      });
    });

    if (closePatientHelpModal) {
      closePatientHelpModal.addEventListener('click', closePatientHelp);
    }

    if (patientHelpModal) {
      patientHelpModal.addEventListener('click', event => {
        if (event.target === patientHelpModal) closePatientHelp();
      });
    }

    const globalConfirmModal = document.getElementById('globalConfirmModal');
    const globalConfirmTitle = document.getElementById('globalConfirmTitle');
    const globalConfirmText = document.getElementById('globalConfirmText');
    const globalConfirmCancel = document.getElementById('globalConfirmCancel');
    const globalConfirmAccept = document.getElementById('globalConfirmAccept');
    let pendingConfirmForm = null;

    const getConfirmObjectFolder = form => {
      const text = `${form.dataset.confirmTitle || ''} ${form.dataset.confirm || ''} ${window.location.pathname}`.toLowerCase();

      if (text.includes('enfermera')) return 'administrador/enfermeras';
      if (text.includes('médico') || text.includes('medico') || window.location.pathname.includes('/admin/medicos')) return 'administrador/medicos';
      if (text.includes('cita') || window.location.pathname.includes('/admin/citas')) return 'administrador/citas';
      return 'administrador/usuarios';
    };

    const getConfirmActionIcon = confirmLabel => {
      const normalizedLabel = confirmLabel.toLowerCase();

      if (normalizedLabel.includes('eliminar')) return 'eliminar';
      if (normalizedLabel.includes('desactivar')) return 'desactivar';
      if (normalizedLabel.includes('activar')) return 'activar';
      if (normalizedLabel.includes('cancelar')) return 'cancelar';
      return 'confirmar';
    };

    document.querySelectorAll('form[data-confirm]').forEach(form => {
      form.addEventListener('submit', event => {
        event.preventDefault();
        pendingConfirmForm = form;
        globalConfirmTitle.textContent = form.dataset.confirmTitle || 'Confirmar acción';
        globalConfirmText.textContent = form.dataset.confirm || '¿Estás seguro de continuar?';
        const confirmLabel = form.dataset.confirmButton || 'Confirmar';
        globalConfirmAccept.title = confirmLabel;
        globalConfirmAccept.setAttribute('aria-label', confirmLabel);
        const confirmAction = getConfirmActionIcon(confirmLabel);
        const confirmAcceptText = globalConfirmAccept.querySelector('span');
        confirmAcceptText.textContent = confirmLabel;
        confirmAcceptText.classList.toggle('visually-hidden', confirmAction !== 'cancelar');
        globalConfirmAccept.classList.toggle('icon-action', confirmAction !== 'cancelar');
        const confirmFolder = getConfirmObjectFolder(form);
        globalConfirmAccept.querySelector('img').src = `/img/action-metaphors/${confirmFolder}/${confirmAction}.png`;
        globalConfirmModal.classList.remove('hidden');
      });
    });

    globalConfirmCancel.addEventListener('click', () => {
      pendingConfirmForm = null;
      globalConfirmModal.classList.add('hidden');
    });

    globalConfirmAccept.addEventListener('click', () => {
      if (pendingConfirmForm) {
        pendingConfirmForm.submit();
      }
    });

    globalConfirmModal.addEventListener('click', event => {
      if (event.target === globalConfirmModal) {
        pendingConfirmForm = null;
        globalConfirmModal.classList.add('hidden');
      }
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && patientHelpModal && !patientHelpModal.classList.contains('hidden')) {
        closePatientHelp();
      }

      if (event.key === 'Escape' && !globalConfirmModal.classList.contains('hidden')) {
        pendingConfirmForm = null;
        globalConfirmModal.classList.add('hidden');
      }
    });
  </script>

